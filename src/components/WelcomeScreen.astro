---
import Pictograms from './Pictograms.astro';
---

<!-- ========================================================
     WELCOME SCREEN (Step 0, Full-Screen Entry & Audio Choice)
     Enhanced, Spacious, Uncrowded Architectural Transit Concourse
     Strictly zero audio until user clicks "Enter with sound"
     ======================================================== -->
<div
  id="scene-welcome"
  class="fixed inset-0 z-[80] bg-[#0A0C10] text-[#EDEAE2] flex flex-col justify-between overflow-y-auto overflow-x-hidden select-none px-4 sm:px-8 lg:px-12 py-6 sm:py-8"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="welcome-heading"
>
  <!-- Background Atmospheric Transit Grid & Radial Spot -->
  <div
    class="absolute inset-0 pointer-events-none opacity-40"
    style="background-image: radial-gradient(circle at 50% 25%, rgba(228, 87, 46, 0.12) 0%, transparent 65%), linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px); background-size: 100% 100%, 48px 48px, 48px 48px;"
  ></div>

  <!-- Top Bar: Authority Monogram & Concourse Telemetry -->
  <header class="relative z-10 w-full max-w-5xl mx-auto flex items-center justify-between border-b border-[#252D3D] pb-3 sm:pb-4">
    <!-- Left: Transit Authority Seal -->
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-line-frontend animate-pulse" aria-hidden="true"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-[#F4F1EA] font-black">
        THE YUG LINE // TRANSIT AUTHORITY
      </span>
      <span class="hidden sm:inline-block font-mono text-[10px] text-[#A3A099] border-l border-[#252D3D] pl-2.5 uppercase">
        CENTRAL TERMINAL · LEVEL 00
      </span>
    </div>

    <!-- Right: Status / Edition Badge -->
    <div class="flex items-center gap-2 font-mono text-xs text-[#9CA3AF]">
      <span class="hidden md:inline px-2 py-0.5 bg-[#121620] border border-[#2B3446] text-[#FFC933] text-[10px] uppercase font-bold">
        DIRECT SERVICE
      </span>
      <span class="text-[11px] tracking-wider text-[#A3A099]">2026 EDITION</span>
    </div>
  </header>

  <!-- Centre Content Block (Spacious, Uncongested Layout) -->
  <main class="relative z-10 w-full max-w-3xl mx-auto my-auto py-6 sm:py-10 flex flex-col items-center text-center">
    
    <!-- Station Dispatch Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-[#121620] border border-[#2B3446] rounded-full text-[11px] font-mono font-bold text-[#FFC933] mb-4 sm:mb-5 shadow-[2px_2px_0_#000]">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="tracking-wider uppercase">PORTFOLIO EXPEDITION · INTERACTIVE METRO</span>
    </div>

    <!-- Main Architectural Heading -->
    <h1
      id="welcome-heading"
      class="font-archivo text-4xl sm:text-6xl lg:text-7xl font-black text-white uppercase tracking-tight leading-[1.05] mb-3"
    >
      Welcome to<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#F4F1EA] to-[#E4572E]">
        The Yug Line
      </span>
    </h1>

    <!-- Single Key Subtitle with Breathing Room -->
    <p class="font-manrope text-base sm:text-xl text-[#CBD5E1] max-w-xl mx-auto leading-relaxed mb-6 sm:mb-8">
      Every stop is a piece of my work — explore production builds across frontend, backend, AI, and systems.
    </p>

    <!-- 3D Interactive Train Plinth (Spacious Framing) -->
    <div
      id="welcome-3d-container"
      class="w-full max-w-xl mb-6 relative bg-[#0D1017] border-2 border-[#2B3446] shadow-[6px_6px_0_#000] rounded-sm overflow-hidden flex flex-col items-center justify-center cursor-grab active:cursor-grabbing"
    >
      <!-- Plinth Top Status Header -->
      <div class="w-full bg-[#141822] border-b border-[#2B3446] px-3.5 py-1.5 flex items-center justify-between font-mono text-[10px] select-none">
        <div class="flex items-center gap-2 text-white font-bold">
          <span class="w-2 h-2 rounded-full bg-line-frontend"></span>
          <span class="tracking-wider uppercase">CAR NO. YR-01 // ROLLING STOCK 3D INSPECTOR</span>
        </div>
        <div class="flex items-center gap-1.5 text-[#FFC933] bg-[#0A0C10] px-2 py-0.5 border border-[#2B3446] rounded-xs font-bold">
          <span class="animate-spin text-xs">↺</span>
          <span class="tracking-widest">DRAG TO ROTATE 360°</span>
        </div>
      </div>

      <!-- 3D WebGL Canvas -->
      <div class="relative w-full h-[190px] sm:h-[220px] flex items-center justify-center overflow-hidden">
        <canvas
          id="welcome-3d-canvas"
          class="w-full h-full select-none"
          style="display: none;"
          aria-label="Interactive 3D Metro Train Model"
        ></canvas>

        <!-- 2D SVG Fallback if WebGL unavailable -->
        <svg
          id="welcome-train-svg"
          viewBox="0 0 500 90"
          class="w-full max-w-md h-20 sm:h-24 transition-transform duration-[1800ms] ease-out px-4"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <!-- Rail Track -->
          <line x1="0" y1="82" x2="500" y2="82" stroke="#4B5563" stroke-width="3" />
          <line x1="0" y1="87" x2="500" y2="87" stroke="#2B3446" stroke-width="2" stroke-dasharray="6 4" />

          <!-- Train Car Body -->
          <g id="welcome-train-body">
            <rect x="50" y="16" width="380" height="56" rx="8" fill="#161B26" stroke="#EDEAE2" stroke-width="2.5" />
            <rect x="110" y="8" width="50" height="8" rx="2" fill="#252D3D" stroke="#EDEAE2" stroke-width="1.5" />
            <rect x="300" y="8" width="50" height="8" rx="2" fill="#252D3D" stroke="#EDEAE2" stroke-width="1.5" />
            <rect x="50" y="58" width="380" height="4" fill="var(--line-frontend)" />
            <rect x="50" y="62" width="380" height="4" fill="var(--line-hardware)" />
            <rect x="80" y="24" width="40" height="24" rx="2" fill="#0A0C10" />
            <rect x="190" y="24" width="50" height="24" rx="2" fill="#0A0C10" />
            <rect x="310" y="24" width="50" height="24" rx="2" fill="#0A0C10" />
            <path d="M 430 24 Q 450 44 430 72 Z" fill="#252D3D" stroke="#EDEAE2" stroke-width="2.5" />
            <circle cx="438" cy="56" r="4" fill="#FFC933" />
            <circle cx="95" cy="77" r="7" fill="#0A0C10" stroke="#4B5563" stroke-width="2" />
            <circle cx="125" cy="77" r="7" fill="#0A0C10" stroke="#4B5563" stroke-width="2" />
            <circle cx="340" cy="77" r="7" fill="#0A0C10" stroke="#4B5563" stroke-width="2" />
            <circle cx="370" cy="77" r="7" fill="#0A0C10" stroke="#4B5563" stroke-width="2" />
          </g>
        </svg>
      </div>

      <!-- Plinth Bottom 4-Line Accent Stripe -->
      <div class="w-full h-1 flex">
        <span class="w-1/4 h-full bg-line-frontend"></span>
        <span class="w-1/4 h-full bg-line-hardware"></span>
        <span class="w-1/4 h-full bg-line-backend"></span>
        <span class="w-1/4 h-full bg-line-ai"></span>
      </div>
    </div>

    <!-- Sound Advisory Notice Box -->
    <div class="w-full max-w-md mx-auto mb-6 p-2.5 sm:p-3 bg-[#121620] border border-[#2B3446] flex items-center gap-3 text-left shadow-[2px_2px_0_#000]">
      <span class="text-xl sm:text-2xl flex-shrink-0" aria-hidden="true">🎧</span>
      <div class="font-mono text-xs text-[#94A3B8] leading-tight">
        <span class="text-white font-black block uppercase tracking-wider mb-0.5">
          Transit Sound Experience
        </span>
        <span class="text-[11px] block text-[#CBD5E1]">
          Features authentic train rumbles, gate chimes, and Station Master clerk announcements.
        </span>
      </div>
    </div>

    <!-- Two Primary Entry Action Buttons (Large, Tactile, Generously Spaced) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 w-full max-w-md mx-auto">
      <!-- 1. Enter With Sound (Primary Vibrant CTA) -->
      <button
        type="button"
        id="welcome-enter-sound-btn"
        class="w-full sm:flex-1 min-h-[56px] px-6 py-3.5 bg-line-frontend hover:bg-[#F2643B] text-white border-3 border-black font-mono font-black text-sm tracking-wider uppercase flex items-center justify-center gap-2.5 shadow-[5px_5px_0_#000] hover:-translate-y-0.5 active:translate-y-0.5 transition-all cursor-pointer"
        aria-label="Enter portfolio with metro sounds enabled"
      >
        <span>Enter with sound</span>
        <Pictograms name="arrow-up-right" size={18} />
      </button>

      <!-- 2. Enter Without Sound (Secondary Muted CTA) -->
      <button
        type="button"
        id="welcome-enter-mute-btn"
        class="w-full sm:flex-1 min-h-[56px] px-6 py-3.5 bg-[#161B26] hover:bg-[#202737] text-[#EDEAE2] border-3 border-[#2B3446] hover:border-[#EDEAE2] font-mono font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 shadow-[5px_5px_0_#000] hover:-translate-y-0.5 active:translate-y-0.5 transition-all cursor-pointer"
        aria-label="Enter portfolio silently without audio"
      >
        <span>Enter without sound</span>
      </button>
    </div>

    <!-- Skip Text Button -->
    <div class="mt-5">
      <button
        type="button"
        id="welcome-skip-link"
        class="day-pass-toggle-btn font-mono text-xs text-[#94A3B8] hover:text-white underline uppercase tracking-widest transition-colors cursor-pointer"
      >
        Skip the metro · See everything ➔
      </button>
    </div>
  </main>

  <!-- Bottom Concourse Tagline & System Credentials -->
  <footer class="relative z-10 w-full max-w-5xl mx-auto border-t border-[#252D3D] pt-3 sm:pt-4 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[#A3A099]">
    <span>YUG ROJIVADIYA // MULTIDISCIPLINARY ARCHITECT & DEVELOPER</span>
    <span class="tracking-wider uppercase">MIND THE GAP · 100% OPERATIONAL</span>
  </footer>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const welcome = document.getElementById('scene-welcome');
    if (!welcome) return;

    let scene3D: any = null;

    // Check if welcome already acknowledged in this session or via hash
    let seen = false;
    try {
      seen = sessionStorage.getItem('yugline_welcome_seen') === 'true';
    } catch (e) {}

    const hasHash = Boolean(window.location.hash);
    const mode = sessionStorage.getItem('yugline_mode') || 'journey';

    if (!seen && !hasHash && mode === 'journey') {
      welcome.style.display = 'flex';

      // Lazy load 3D WebGL Metro Scene (Rule 6a)
      try {
        const { Welcome3DScene } = await import('../scripts/webgl/welcomeScene');
        scene3D = new Welcome3DScene('welcome-3d-container', 'welcome-3d-canvas');
      } catch (err) {
        // Fallback to 2D SVG
        const train = document.getElementById('welcome-train-svg');
        if (train) {
          train.style.transform = 'translateX(-120px)';
          requestAnimationFrame(() => {
            train.style.transform = 'translateX(0px)';
          });
        }
      }
    }

    const closeWelcome = (soundEnabled: boolean) => {
      if (scene3D) {
        scene3D.destroy();
        scene3D = null;
      }

      // 1. Audio consent handling (Strictly per user instruction)
      try {
        localStorage.setItem('yugline_sound', soundEnabled ? 'on' : 'off');
        sessionStorage.setItem('yugline_welcome_seen', 'true');
      } catch (e) {}

      // Update sound engines
      if ((window as any).__yugsound) {
        (window as any).__yugsound.setEnabled(soundEnabled);
      }
      if ((window as any).__sound) {
        (window as any).__sound.setEnabled(soundEnabled);
      }

      // Update sound toggle UI text in header
      const soundStatus = document.getElementById('sound-status');
      if (soundStatus) {
        soundStatus.textContent = soundEnabled ? 'Sound: On' : 'Sound: Off';
      }

      // Dispatch event to inform other components of the audio choice
      window.dispatchEvent(
        new CustomEvent('yugline:welcome_dismissed', {
          detail: { sound: soundEnabled },
        })
      );

      // 2. Hide welcome overlay with fade
      welcome.style.opacity = '0';
      welcome.style.transition = 'opacity 0.25s ease';
      setTimeout(() => {
        welcome.style.display = 'none';
        welcome.style.opacity = '1';

        // Focus heading on Step 1 (Choose a stop)
        const step1Heading = document.getElementById('choose-stop-heading');
        if (step1Heading) {
          step1Heading.focus();
        }
      }, 250);
    };

    const enterSoundBtn = document.getElementById('welcome-enter-sound-btn');
    const enterMuteBtn = document.getElementById('welcome-enter-mute-btn');
    const skipBtn = document.getElementById('welcome-skip-link');

    if (enterSoundBtn) {
      enterSoundBtn.addEventListener('click', () => closeWelcome(true));
    }
    if (enterMuteBtn) {
      enterMuteBtn.addEventListener('click', () => closeWelcome(false));
    }
    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        closeWelcome(false);
      });
    }
  });
</script>
