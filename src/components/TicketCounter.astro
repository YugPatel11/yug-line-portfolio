  <!-- ========================================================
       CONCOURSE CONTINUOUS CARRIER ROUTE STRIP
       ======================================================== -->
  <div class="p-4 sm:p-5 bg-surface border-4 border-ink shadow-[6px_6px_0_var(--ink)] mt-6">
    <div class="font-mono text-xs text-ink-soft uppercase mb-3 flex items-center justify-between font-bold">
