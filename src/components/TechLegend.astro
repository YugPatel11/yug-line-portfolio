          </div>

          <!-- 4 Tag Pills -->
          <div class="flex flex-wrap gap-2">
            {[
              'DJANGO',
              'FIREBASE',
              'MONGODB',
              'NEON DB',
            ].map((tag) => (
              <button
                type="button"
                class="skill-chip px-3.5 py-1.5 rounded-full bg-[#1F2228] text-neutral-300 border border-white/[0.07] font-mono text-[11px] sm:text-xs font-semibold tracking-wider hover:bg-white/[0.14] hover:border-line-backend hover:text-white transition-all cursor-pointer shadow-[0_2px_4px_rgba(0,0,0,0.3)] active:scale-95"
                data-skill={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================
         COLUMN 2: LANGUAGES + FRONTEND & MOBILE
         ======================================================== -->
    <div class="flex flex-col gap-5">
      <!-- CARD 2: Languages (3 Chips) -->
      <div class="bento-card p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-[#14161B] border border-white/10 hover:border-white/20 shadow-[0_12px_32px_rgba(0,0,0,0.5)] transition-all duration-300 relative flex flex-col justify-between" data-category="languages">
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>
        
        <div>
          <!-- Header with Code Icon -->
          <div class="flex items-center gap-3.5 mb-5">
            <div class="w-10 h-10 rounded-2xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-white/90 shadow-inner shrink-0">
              <svg class="w-5 h-5 text-line-frontend" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <h4 class="card-editorial-title text-2xl sm:text-[26px] text-white">
              Languages
            </h4>
          </div>

          <!-- 3 Tag Pills -->
          <div class="flex flex-wrap gap-2">
            {[
              'PYTHON',
              'HTML/CSS',
              'SQL',
            ].map((tag) => (
              <button
                type="button"
                class="skill-chip px-3.5 py-1.5 rounded-full bg-[#1F2228] text-neutral-300 border border-white/[0.07] font-mono text-[11px] sm:text-xs font-semibold tracking-wider hover:bg-white/[0.14] hover:border-line-frontend hover:text-white transition-all cursor-pointer shadow-[0_2px_4px_rgba(0,0,0,0.3)] active:scale-95"
                data-skill={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- CARD 3: Frontend & Mobile (3 Chips) -->
      <div class="bento-card p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-[#14161B] border border-white/10 hover:border-white/20 shadow-[0_12px_32px_rgba(0,0,0,0.5)] transition-all duration-300 relative flex flex-col justify-between" data-category="frontend">
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>
        
        <div>
          <!-- Header with Monitor Icon -->
          <div class="flex items-center gap-3.5 mb-5">
            <div class="w-10 h-10 rounded-2xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-white/90 shadow-inner shrink-0">
              <svg class="w-5 h-5 text-line-frontend" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
