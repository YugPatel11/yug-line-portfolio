        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['System Architecture', 'Test Scaffolding'],
        desc: 'Terminal-native agentic development tool for rapid refactoring, architectural auditing, and automated testing.',
      },
      'NUMPY': {
        name: 'NumPy',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['DataMorfix', 'EcoSortX'],
        desc: 'High-performance numerical computing and array operations for data science pipelines.',
      },
      'PANDAS': {
        name: 'Pandas',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['DataMorfix'],
        desc: 'Dataframe parsing, anomaly detection, statistical profiling, and automated documentation generation.',
      },
      'LLM INTEGRATION': {
        name: 'LLM Integration',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['Ghumify', 'DataMorfix'],
        desc: 'Production integration of foundation models with structured JSON schemas, fallback retries, and token budgeting.',
      },
      'AI API INTEGRATION': {
        name: 'AI API Integration',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['Ghumify', 'DataMorfix'],
        desc: 'Robust server-side connectors with rate-limiting, error fallbacks, and real-time streaming responses.',
      },
      'AI DASHBOARD DEV': {
        name: 'AI Dashboard Dev',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['DataMorfix', 'EMS'],
        desc: 'Full analytics dashboards with interactive visualization, custom data filtering, and real-time metrics.',
      },
      'PROMPT ENGINEERING': {
        name: 'Prompt Engineering',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['Ghumify', 'DataMorfix'],
        desc: 'Structured few-shot, chain-of-thought, and system framing techniques for high-reliability outputs.',
      },
      'LOOP ENGINEERING': {
        name: 'Loop Engineering',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['Autonomous Workflows', 'Agent Swarms'],
        desc: 'Autonomous feedback loops with multi-agent critique, test assertions, and automated corrections.',
      },
      'AI AUTOMATION': {
        name: 'AI Automation',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['EcoSortX', 'DataMorfix'],
        desc: 'End-to-end autonomous processes replacing manual intervention with computer vision and machine learning.',
      },
      'PYTHON': {
        name: 'Python',
        category: 'Languages',
        line: 'backend',
        projects: ['EMS', 'GrantPilot', 'EcoSortX', 'DataMorfix'],
        desc: 'Core backend, ML modeling, and automation programming language across production systems.',
      },
      'HTML/CSS': {
        name: 'HTML/CSS',
        category: 'Languages',
        line: 'frontend',
        projects: ['The Yug Line', 'Edverb Platforms', 'BlackBanana'],
        desc: 'Modern semantic HTML5, CSS custom properties, responsive layout grids, and WCAG AA compliance.',
      },
      'SQL': {
        name: 'SQL',
        category: 'Languages',
        line: 'backend',
        projects: ['EMS', 'GrantPilot', 'PostgreSQL'],
        desc: 'Relational schema design, indexed queries, joins, performance optimization, and data integrity.',
      },
      'TAILWIND': {
        name: 'Tailwind CSS',
        category: 'Frontend & Mobile',
        line: 'frontend',
        projects: ['The Yug Line', 'DataMorfix', 'Clinic Booking', 'Edverb'],
        desc: 'Utility-first CSS architecture, design token mapping, fluid typography, and dark mode themes.',
      },
      'FLUTTERFLOW': {
        name: 'FlutterFlow',
        category: 'Frontend & Mobile',
        line: 'frontend',
        projects: ['GeoBus Mobile', 'Rapid Prototypes'],
        desc: 'Rapid mobile UI/UX engineering, state management, and real-time backend synchronization.',
      },
      'FIGMA': {
        name: 'Figma',
        category: 'Frontend & Mobile',
        line: 'frontend',
        projects: ['Ghumify', 'The Yug Line', 'Edverb'],
        desc: 'High-fidelity wireframing, interactive prototyping, vector design systems, and design handoff.',
      },
      'DJANGO': {
        name: 'Django',
        category: 'Backend & Databases',
        line: 'backend',
        projects: ['EMS (Campus-Wide)', 'GrantPilot', 'Clinic Booking'],
        desc: 'Robust batteries-included Python framework: ORM, authentication, admin interfaces, and REST APIs.',
      },
      'FIREBASE': {
        name: 'Firebase',
        category: 'Backend & Databases',
        line: 'backend',
        projects: ['GeoBus', 'Ghumify', 'Clinic Booking'],
        desc: 'Realtime Database, Firestore, Authentication, and Cloud Functions for responsive real-time state.',
      },
      'MONGODB': {
        name: 'MongoDB',
        category: 'Backend & Databases',
        line: 'backend',
        projects: ['Full-Stack Prototypes', 'Data Storage'],
        desc: 'Document-based database for unstructured data payloads, dynamic schemas, and fast querying.',
      },
      'NEON DB': {
        name: 'Neon DB',
        category: 'Backend & Databases',
        line: 'backend',
        projects: ['Cloud Deployments', 'Serverless Postgres'],
        desc: 'Modern serverless PostgreSQL cloud database with instant branching, connection pooling, and autoscaling.',
      },
      'RENDER': {
        name: 'Render',
        category: 'Tools & Platforms',
        line: 'hardware',
        projects: ['Clinic Appointment (Live)'],
        desc: 'Cloud hosting platform for containerized web services, managed PostgreSQL databases, and SSL certificates.',
      },
      'VERCEL': {
        name: 'Vercel',
        category: 'Tools & Platforms',
        line: 'hardware',
        projects: ['The Yug Line (Live Vercel Host)'],
        desc: 'Serverless edge hosting, continuous git deployments, instant asset optimization, and CDN routing.',
      },
      'STITCH': {
        name: 'Stitch',
        category: 'Tools & Platforms',
        line: 'hardware',
        projects: ['DESIGN.md Tokens', 'Brand System'],
        desc: 'Google Labs open design system tooling (DESIGN.md) for bridging human design and AI coding.',
      },
      'GOOGLE COLAB': {
        name: 'Google Colab',
        category: 'Tools & Platforms',
        line: 'hardware',
        projects: ['EcoSortX ML Training (30K+ images)'],
        desc: 'Cloud-hosted Jupyter notebook environment with dedicated GPU/TPU acceleration for ML model training.',
      },
      'ANACONDA': {
        name: 'Anaconda',
        category: 'Tools & Platforms',
        line: 'hardware',
        projects: ['Data Science Lab', 'Virtual Envs'],
        desc: 'Enterprise scientific computing environment for managing Python distributions, CUDA, and dependencies.',
      },
    };

    const chips = document.querySelectorAll('.skill-chip');
    const standbyView = document.getElementById('telemetry-standby-view');
    const activeView = document.getElementById('telemetry-active-view');
    const skillNameEl = document.getElementById('telemetry-skill-name');
    const lineBadgeEl = document.getElementById('telemetry-line-badge');
    const skillDescEl = document.getElementById('telemetry-skill-desc');
    const projectChipsEl = document.getElementById('telemetry-project-chips');

    let resetTimer: any = null;

    const highlightSkill = (chip: Element) => {
      clearTimeout(resetTimer);
      sound.beep();

      const skillKey = chip.getAttribute('data-skill') || '';
      const data = SKILL_DATA[skillKey];
      if (!data) return;

      // Update chip styles
      chips.forEach((c) => {
        c.classList.remove('ring-2', 'ring-white/40', 'bg-white/20', 'text-white');
      });
      chip.classList.add('ring-2', 'ring-white/40', 'bg-white/20', 'text-white');

      // Update telemetry box
      if (standbyView) standbyView.classList.add('hidden');
      if (activeView) activeView.classList.remove('hidden');

      if (skillNameEl) skillNameEl.textContent = data.name;
      if (skillDescEl) skillDescEl.textContent = data.desc;

      if (lineBadgeEl) {
        lineBadgeEl.textContent = `${data.category.toUpperCase()} // ${data.line.toUpperCase()} LINE`;
        lineBadgeEl.style.color = data.line === 'ai' ? 'var(--line-ai)' :
                                 data.line === 'frontend' ? 'var(--line-frontend)' :
                                 data.line === 'backend' ? 'var(--line-backend)' :
                                 'var(--line-hardware)';
        lineBadgeEl.style.borderColor = lineBadgeEl.style.color;
      }

      if (projectChipsEl) {
        projectChipsEl.innerHTML = '';
        data.projects.forEach((proj) => {
          const pill = document.createElement('span');
          pill.className = 'px-2.5 py-1 rounded-md bg-[#1B1E24] border border-white/15 text-xs font-mono font-bold text-white shadow-sm flex items-center gap-1.5';
          pill.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${
            data.line === 'ai' ? 'bg-line-ai' :
            data.line === 'frontend' ? 'bg-line-frontend' :
            data.line === 'backend' ? 'bg-line-backend' :
            'bg-line-hardware'
          }"></span><span>${proj}</span>`;
          projectChipsEl.appendChild(pill);
        });
      }
    };

    chips.forEach((chip) => {
      chip.addEventListener('mouseenter', () => highlightSkill(chip));
      chip.addEventListener('focus', () => highlightSkill(chip));
      chip.addEventListener('click', () => highlightSkill(chip));
    });

    // Category Filter Switcher Logic
    const filterButtons = document.querySelectorAll('.category-filter-btn');
    const bentoCards = document.querySelectorAll('.bento-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        sound.click();
        const filter = btn.getAttribute('data-filter') || 'all';

        // Update button active styles
        filterButtons.forEach((b) => {
          b.classList.remove('bg-white/10', 'text-white', 'border-white/20');
          b.classList.add('bg-transparent', 'text-neutral-400', 'border-white/10');
        });
        btn.classList.add('bg-white/10', 'text-white', 'border-white/20');
        btn.classList.remove('bg-transparent', 'text-neutral-400', 'border-white/10');

        // Highlight matching cards
        bentoCards.forEach((card) => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            (card as HTMLElement).style.opacity = '1';
            (card as HTMLElement).style.transform = 'scale(1)';
          } else {
            (card as HTMLElement).style.opacity = '0.35';
            (card as HTMLElement).style.transform = 'scale(0.98)';
          }
        });
      });
    });
  });
</script>
