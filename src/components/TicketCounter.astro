---
// TicketCounter.astro
// Signature Grand Central Concourse Ticket Counter with Station Master Clerk & Solari Fare Board
import { PROFILE } from '../data/portfolio';
import Pictograms from './Pictograms.astro';

const DESTINATIONS = [
  {
    id: 'station-01',
    code: 'ST-01',
    title: 'Achievements',
    desc: 'Smart India Hackathon 2026 win, awards and milestones',
    dialogue: '150+ teams defeated in SIH 2026! An incredible run. Platform 1.',
    line: 'hardware',
    lineColor: 'var(--line-hardware)',
    statusBadge: 'BOARDING // PLT 1',
    highlightTag: 'SIH 2026 WINNER',
  },
  {
    id: 'station-02',
    code: 'ST-02',
    title: 'All projects',
    desc: 'Curated production systems across frontend, backend, AI & IoT',
    dialogue: 'Eight production builds including Ghumify & EMS. Platform 2.',
    line: 'frontend',
    lineColor: 'var(--line-frontend)',
    statusBadge: 'READY // 8 BUILDS',
    highlightTag: 'GHUMIFY & EMS',
  },
  {
    id: 'station-03',
    code: 'ST-03',
    title: 'Experience',
    desc: 'Frontend intern at Edverb, VP of EBC Club & freelance developer',
    dialogue: 'Meet the crew. Edverb frontend intern and student leadership. Platform 3.',
    line: 'backend',
    lineColor: 'var(--line-backend)',
    statusBadge: 'CREW STATION',
    highlightTag: 'EDVERB & EBC',
  },
  {
    id: 'station-04',
    code: 'ST-04',
    title: 'Skills and tools',
    desc: 'Full technical capability stack across all 4 transit tracks',
    dialogue: 'Every weapon in the arsenal, sorted across 4 transit tracks. Platform 4.',
    line: 'hardware',
    lineColor: 'var(--line-hardware)',
    statusBadge: 'FULL ARSENAL',
    highlightTag: '4 TRANSIT TRACKS',
  },
  {
    id: 'station-05',
    code: 'ST-05',
    title: 'Education',
    desc: 'B.Tech CSE (AI/ML) at P P Savani University (2024–2028)',
    dialogue: 'B.Tech in CSE (AI/ML) at P P Savani University. Quick stop: the classroom.',
    line: 'ai',
    lineColor: 'var(--line-ai)',
    statusBadge: 'ACADEMIC BASE',
    highlightTag: 'AI / ML DEGREE',
  },
  {
    id: 'station-06',
    code: 'ST-06',
    title: 'Contact me',
    desc: 'Direct communication channels, socials, and inquiry dispatch',
    dialogue: 'End of the line! Direct email, WhatsApp, and socials. Say hello!',
    line: 'central',
    lineColor: 'var(--ink)',
    statusBadge: 'TERMINUS HUB',
    highlightTag: 'SAY HELLO',
  },
];
---

<div id="journey-step-choose" class="w-full relative">
  
  <!-- ========================================================
       CONCOURSE ARCHITECTURAL CANOPY & BACKGROUND ATMOSPHERE
       ======================================================== -->
  <div class="concourse-canopy-wrapper relative w-full mb-6 select-none">
    
    <!-- Top Industrial Riveted Steel Truss Girders -->
    <div class="relative w-full h-8 sm:h-10 bg-[#0E1118] border-b-4 border-ink flex items-center justify-between px-4 sm:px-8 shadow-[0_4px_12px_rgba(0,0,0,0.4)] overflow-hidden">
      <!-- Cross Truss SVG Pattern -->
      <div class="absolute inset-0 opacity-25 pointer-events-none">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="concourse-truss-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
              <line x1="0" y1="0" x2="40" y2="40" stroke="#FFFFFF" stroke-width="1.5" />
              <line x1="40" y1="0" x2="0" y2="40" stroke="#FFFFFF" stroke-width="1.5" />
              <line x1="0" y1="20" x2="40" y2="20" stroke="#FFFFFF" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#concourse-truss-pattern)" />
        </svg>
      </div>

      <!-- Left Truss Identifier -->
      <div class="relative z-10 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-mono text-[10px] sm:text-xs font-black uppercase tracking-widest text-[#FFC933]">
          CENTRAL TERMINAL // MAIN CONCOURSE · LEVEL 01
        </span>
      </div>

      <!-- Right System Track Telemetry -->
      <div class="relative z-10 flex items-center gap-3 font-mono text-[10px] sm:text-xs text-[#A2AEC4]">
        <span class="hidden sm:inline">NETWORK: <strong class="text-emerald-400">100% OPERATIONAL</strong></span>
        <span class="bg-[#181D2A] px-2 py-0.5 border border-[#2B3242] text-line-hardware font-bold">
          TRACK SPEED: HIGH
        </span>
      </div>
    </div>

    <!-- Electronic Operations Ribbon Display (Amber & Emerald LED Ticker) -->
    <div class="bg-[#0A0C12] border-x-4 border-b-2 border-ink px-4 py-2 flex flex-wrap items-center justify-between gap-3 font-mono text-xs shadow-[inset_0_2px_4px_rgba(0,0,0,0.6)]">
      <div class="flex items-center gap-3 text-[#FFB000] tracking-wide">
        <span class="px-1.5 py-0.5 bg-[#FFB000]/20 border border-[#FFB000]/40 text-[9px] font-bold uppercase animate-pulse">
          DISPATCH ACTIVE
        </span>
        <span class="hidden md:inline text-xs">
          ALL 6 TRANSIT STOPS OPEN • FREE PASSES (₹0) ISSUED AT WINDOW 01 • MIND THE GAP
        </span>
        <span class="md:hidden text-xs">
          FREE TRANSIT PASSES AT COUNTER 01
        </span>
      </div>

      <!-- Real-time Concourse Clock -->
      <div class="flex items-center gap-2 text-paper ml-auto">
        <span class="text-[10px] text-ink-soft uppercase hidden sm:inline">CONCOURSE TIME:</span>
        <span id="concourse-live-clock" class="font-bold text-line-hardware bg-[#141824] px-2.5 py-0.5 border border-[#2B3242]">
          12:00:00 IST
        </span>
      </div>
    </div>

    <!-- Ambient Clerestory Subway Tunnel Window with Passing Train Silhouette -->
    <div class="concourse-ambient-window relative w-full h-8 sm:h-10 bg-[#12151E] border-x-4 border-b-4 border-ink overflow-hidden flex items-center">
      <!-- Brick Arch Shadows -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-black/40 to-black/80 pointer-events-none"></div>
      
      <!-- Passing Silhouette Metro Train -->
      <div class="concourse-passing-train absolute top-1/2 -translate-y-1/2 left-0 w-full pointer-events-none">
        <svg viewBox="0 0 1200 24" class="w-[1200px] h-6 text-[#202534] fill-current" xmlns="http://www.w3.org/2000/svg">
          <!-- Car 1 -->
          <rect x="0" y="2" width="220" height="18" rx="3" />
          <circle cx="35" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="70" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="150" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="185" cy="21" r="2.5" fill="#FFC933" />
          <!-- Lit windows -->
          <rect x="25" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="75" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="125" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="175" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <!-- Gangway -->
          <rect x="220" y="5" width="12" height="13" fill="#111111" />
          <!-- Car 2 -->
          <rect x="232" y="2" width="220" height="18" rx="3" />
          <circle cx="265" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="300" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="380" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="415" cy="21" r="2.5" fill="#FFC933" />
          <rect x="255" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="305" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="355" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="405" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <!-- Gangway -->
          <rect x="452" y="5" width="12" height="13" fill="#111111" />
          <!-- Car 3 -->
          <rect x="464" y="2" width="220" height="18" rx="3" />
          <circle cx="495" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="530" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="610" cy="21" r="2.5" fill="#FFC933" />
          <circle cx="645" cy="21" r="2.5" fill="#FFC933" />
          <rect x="485" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="535" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="585" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
          <rect x="635" y="5" width="30" height="9" fill="#FFD98A" opacity="0.6" />
        </svg>
      </div>
    </div>
  </div>

  <!-- ========================================================
       SLIM IDENTITY BAND & VERIFIED CREDENTIALS
       ======================================================== -->
  <div class="mb-5 p-4 sm:p-5 bg-surface border-4 border-ink shadow-[6px_6px_0_var(--ink)] flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-full border-3 border-ink bg-line-frontend text-paper font-black font-archivo flex items-center justify-center text-xl flex-shrink-0 shadow-[2px_2px_0_var(--ink)]">
        YR
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="font-archivo text-xl sm:text-2xl font-black text-ink uppercase tracking-tight">
            {PROFILE.name}
          </h2>
          <span class="font-mono text-[10px] font-bold px-2 py-0.5 bg-paper border border-ink text-line-frontend uppercase shadow-[1px_1px_0_var(--ink)]">
            ARCHITECT & DEVELOPER
          </span>
        </div>
        <p class="font-mono text-xs text-ink-soft">
          // {PROFILE.role} • {PROFILE.status}
        </p>
      </div>
    </div>

    <!-- Proof Badges -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span class="px-2.5 py-1 bg-paper border border-ink text-ink font-bold inline-flex items-center gap-1.5 shadow-[2px_2px_0_var(--ink)]">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        {PROFILE.grantTotal} SSIP Grants
      </span>
      <span class="px-2.5 py-1 bg-paper border border-ink text-ink font-bold shadow-[2px_2px_0_var(--ink)]">
        🏆 SIH 2026 Winner
      </span>
      <span class="px-2.5 py-1 bg-paper border border-ink text-ink font-bold shadow-[2px_2px_0_var(--ink)] hidden sm:inline-flex">
        🎖️ {PROFILE.leadershipRole}
      </span>
      <span class="px-2.5 py-1 bg-[#15171C] text-line-hardware border border-ink font-bold shadow-[2px_2px_0_var(--ink)] hidden md:inline-flex">
        100% EMS Deployment
      </span>
    </div>
  </div>

  <!-- Step Bar Indicator -->
  <div class="mb-6 p-3 bg-surface border-2 border-ink shadow-[3px_3px_0_var(--ink)] flex items-center justify-between font-mono">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-ink">
      <span class="w-2.5 h-2.5 rounded-full bg-line-frontend animate-pulse"></span>
      <span>Step 1 of 3 · Buy your boarding ticket</span>
    </div>

    <div class="flex items-center gap-2" aria-hidden="true">
      <span class="w-3 h-3 rounded-full bg-line-frontend border-2 border-ink"></span>
      <span class="w-3 h-3 rounded-full bg-paper border-2 border-ink"></span>
      <span class="w-3 h-3 rounded-full bg-paper border-2 border-ink"></span>
      <span class="text-xs text-ink-soft ml-1 hidden sm:inline">WINDOW NO. 1</span>
    </div>
  </div>

  <!-- ========================================================
       MAIN 2.5D TICKET BOOTH + SOLARI FARE BOARD LAYOUT
       ======================================================== -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT 6 COLS: 2.5D TICKET BOOTH WITH STATION MASTER CLERK -->
    <div class="lg:col-span-6 space-y-4">
      
      <!-- The 2.5D Physical Window Container -->
      <div class="ticket-booth-stage relative w-full bg-paper border-4 border-ink shadow-[8px_8px_0_var(--ink)] overflow-hidden select-none">
        
        <!-- LAYER 1: BACK WALL (Subway Tiles, Enamel Sign, Lamp, Clock, Timetable) -->
        <div class="booth-back-layer relative w-full h-[380px] sm:h-[430px] bg-[#14171E] subway-tile-wall p-4 flex flex-col justify-between overflow-hidden">
          
          <!-- Top Beam: Enamel Sign & Lamp -->
          <div class="flex items-start justify-between z-10">
            <!-- TICKETS Blade Sign -->
            <div class="px-3.5 py-1.5 bg-[#101218] border-2 border-[#FFC933] shadow-[3px_3px_0_#000] flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <div>
                <span class="font-mono text-xs font-black tracking-widest text-[#FFC933] uppercase block">
                  TICKETS // COUNTER 01
                </span>
                <span class="font-mono text-[8px] text-[#A6AFBF] uppercase tracking-wider block">
                  STATION MASTER ON DUTY
                </span>
              </div>
            </div>

            <!-- Warm Lamp Cone with Cast Light -->
            <div class="relative flex flex-col items-center">
              <div class="w-14 h-3 bg-[#2A2E39] border border-black shadow-[1px_1px_0_#000]"></div>
              <div class="w-10 h-4 bg-[#FFC933] border border-black" style="clip-path: polygon(15% 0%, 85% 0%, 100% 100%, 0% 100%);"></div>
              <!-- Light Glow Beam -->
              <div class="w-32 h-24 bg-[#FFD98A]/20 pointer-events-none" style="clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);"></div>
            </div>
          </div>

          <!-- Wall Clock & Timetable Board -->
          <div class="absolute top-16 right-4 z-10 opacity-90 pointer-events-none hidden sm:block font-mono">
            <!-- Timetable Box -->
            <div class="p-2.5 bg-paper/95 border-2 border-ink shadow-[3px_3px_0_#000] w-28 text-[9px] text-ink">
              <div class="font-bold border-b border-ink/40 pb-0.5 mb-1 uppercase text-line-frontend flex items-center justify-between">
                <span>TIMETABLE</span>
                <span>EXP</span>
              </div>
              <div class="flex justify-between py-0.5"><span>ST-01</span><span class="font-bold">ON TIME</span></div>
              <div class="flex justify-between py-0.5"><span>ST-02</span><span class="font-bold">BOARDING</span></div>
              <div class="flex justify-between py-0.5"><span>ST-03</span><span class="font-bold">ACTIVE</span></div>
              <div class="flex justify-between py-0.5"><span>ST-04</span><span class="font-bold">NORMAL</span></div>
            </div>
          </div>

          <!-- LAYER 2: THE 2D ANIMATED CLERK (Positioned inside window) -->
          <div id="counter-clerk-avatar" class="clerk-container absolute inset-x-0 bottom-12 flex justify-center items-end pointer-events-auto cursor-pointer z-15" title="Click to hear Station Master speak">
            <svg
              id="clerk-svg"
              viewBox="0 0 240 240"
              class="w-60 sm:w-68 h-60 sm:h-68 select-none"
              xmlns="http://www.w3.org/2000/svg"
              aria-label="Friendly Ticket Clerk"
              role="img"
            >
              <defs>
                <!-- Halftone Shadow Dot Pattern -->
                <pattern id="halftone-dots" width="4" height="4" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1" fill="#111111" opacity="0.3" />
                </pattern>
              </defs>

              <!-- Torso & Transit Uniform Vest -->
              <g id="clerk-torso">
                <!-- Shirt Base -->
                <path d="M 55 168 Q 120 156 185 168 L 200 240 L 40 240 Z" fill="#F4F1EA" stroke="#111111" stroke-width="2.5" />
                <!-- Line Livery Vest -->
                <path d="M 70 168 L 96 240 L 144 240 L 170 168 Q 120 184 70 168 Z" fill="#FFC933" stroke="#111111" stroke-width="2.5" />
                <!-- Halftone Shadow on Vest -->
                <path d="M 120 180 L 96 240 L 144 240 L 170 168 Q 120 184 120 180 Z" fill="url(#halftone-dots)" />
                <!-- Tie / Collar -->
                <polygon points="112,166 128,166 123,205 117,205" fill="#E4572E" stroke="#111111" stroke-width="1.5" />
                <polygon points="104,162 120,170 112,174" fill="#FFFFFF" stroke="#111111" stroke-width="1.5" />
                <polygon points="136,162 120,170 128,174" fill="#FFFFFF" stroke="#111111" stroke-width="1.5" />
                <!-- Gold Conductor Buttons -->
                <circle cx="120" cy="215" r="2.5" fill="#FFFFFF" stroke="#111111" stroke-width="1" />
                <circle cx="120" cy="230" r="2.5" fill="#FFFFFF" stroke="#111111" stroke-width="1" />
                <!-- Name Badge -->
                <rect x="144" y="194" width="24" height="10" rx="1.5" fill="#111111" stroke="#FFC933" stroke-width="1" />
                <text x="156" y="201.5" font-family="'IBM Plex Mono', monospace" font-size="5" font-weight="bold" fill="#FFC933" text-anchor="middle">YR PASS</text>
              </g>

              <!-- Animated Head & Face Group (Nods & Blinks) -->
              <g id="clerk-head" class="clerk-head-motion origin-bottom">
                <!-- Neck -->
                <rect x="110" y="144" width="20" height="24" fill="#F5CBA7" stroke="#111111" stroke-width="2" />
                <!-- Ears -->
                <circle cx="85" cy="125" r="6" fill="#F5CBA7" stroke="#111111" stroke-width="2" />
                <circle cx="155" cy="125" r="6" fill="#F5CBA7" stroke="#111111" stroke-width="2" />
                <!-- Head Base -->
                <ellipse cx="120" cy="124" rx="31" ry="34" fill="#F5CBA7" stroke="#111111" stroke-width="2.5" />
                
                <!-- Hair -->
                <path d="M 87 119 Q 90 96 120 96 Q 150 96 153 119 Q 146 104 120 104 Q 94 104 87 119 Z" fill="#2C221E" />

                <!-- Eyes (Blinking CSS keyframe) -->
                <g id="clerk-eyes" class="clerk-blink-motion">
                  <ellipse cx="108" cy="124" rx="3.5" ry="4.5" fill="#111111" />
                  <circle cx="109.5" cy="122.5" r="1.2" fill="#FFFFFF" />
                  <ellipse cx="132" cy="124" rx="3.5" ry="4.5" fill="#111111" />
                  <circle cx="133.5" cy="122.5" r="1.2" fill="#FFFFFF" />
                </g>

                <!-- Eyebrows -->
                <path d="M 102 116 Q 108 113 114 116" stroke="#2C221E" stroke-width="2" stroke-linecap="round" fill="none" />
                <path d="M 126 116 Q 132 113 138 116" stroke="#2C221E" stroke-width="2" stroke-linecap="round" fill="none" />

                <!-- Nose -->
                <path d="M 120 122 L 117 131 L 123 131" stroke="#111111" stroke-width="1.8" stroke-linecap="round" fill="none" />

                <!-- Friendly Smile -->
                <path id="clerk-mouth" d="M 112 139 Q 120 146 128 139" stroke="#111111" stroke-width="2.2" stroke-linecap="round" fill="none" />

                <!-- Conductor Peaked Cap -->
                <g id="clerk-cap">
                  <!-- Cap Crown -->
                  <path d="M 84 105 Q 120 84 156 105 L 159 99 Q 120 76 81 99 Z" fill="#171A24" stroke="#111111" stroke-width="2.5" />
                  <!-- Gold Livery Band -->
                  <path d="M 84 105 Q 120 95 156 105 L 155 109 Q 120 99 85 109 Z" fill="#FFC933" stroke="#111111" stroke-width="1.5" />
                  <!-- Metro Cockade / Badge -->
                  <circle cx="120" cy="99" r="4.5" fill="#E4572E" stroke="#FFC933" stroke-width="1.5" />
                  <circle cx="120" cy="99" r="1.8" fill="#FFFFFF" />
                  <!-- Visor / Peak -->
                  <path d="M 83 108 Q 120 115 157 108 Q 120 120 83 108 Z" fill="#111111" />
                </g>
              </g>

              <!-- Left Arm / Typing / Handover Arm -->
              <g id="clerk-left-arm">
                <path d="M 66 178 Q 52 210 88 220" stroke="#111111" stroke-width="14" stroke-linecap="round" fill="none" />
                <path d="M 66 178 Q 52 210 88 220" stroke="#FFC933" stroke-width="10" stroke-linecap="round" fill="none" />
                <circle cx="90" cy="220" r="7" fill="#F5CBA7" stroke="#111111" stroke-width="2" />
              </g>

              <!-- Right Arm / Waving / Stamping Arm -->
              <g id="clerk-right-arm" class="clerk-wave-motion origin-[175px_180px]">
                <path d="M 174 178 Q 198 200 172 220" stroke="#111111" stroke-width="14" stroke-linecap="round" fill="none" />
                <path d="M 174 178 Q 198 200 172 220" stroke="#FFC933" stroke-width="10" stroke-linecap="round" fill="none" />
                <circle cx="170" cy="220" r="7" fill="#F5CBA7" stroke="#111111" stroke-width="2" />
              </g>
            </svg>
          </div>

          <!-- LAYER 3: GLASS WINDOW (Steel Frame, Reflection Bars, Speaker Grill) -->
          <div class="booth-glass-layer absolute inset-0 pointer-events-none z-20">
            <!-- Diagonal White Reflection Glare Bars -->
            <div class="absolute -inset-x-12 top-10 h-12 bg-white/10 transform -rotate-12 pointer-events-none"></div>
            <div class="absolute -inset-x-12 top-32 h-6 bg-white/5 transform -rotate-12 pointer-events-none"></div>

            <!-- Perforated Brass Speaking Grill (Circular dots in glass) -->
            <div class="absolute top-[48%] left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-1 opacity-50">
              <div class="flex gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
              </div>
              <div class="flex gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
              </div>
              <div class="flex gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FFC933] border border-ink"></span>
              </div>
            </div>

            <!-- Glass Window Bottom Pass-Through Cutout Slot -->
            <div class="absolute bottom-12 left-1/2 -translate-x-1/2 w-52 h-4 border-2 border-ink bg-transparent flex items-center justify-center">
              <span class="w-44 h-1 bg-ink/70 block"></span>
            </div>
          </div>

          <!-- LAYER 4: HEAVY WOOD & BRASS COUNTER SLAB -->
          <div class="booth-counter-layer absolute inset-x-0 bottom-0 h-14 bg-[#231A14] border-t-4 border-ink z-25 flex items-center justify-between px-3 sm:px-6 shadow-[inset_0_2px_4px_rgba(255,200,50,0.2)]">
            
            <!-- Mechanical Ticket Printer Unit -->
            <div class="flex items-center gap-2">
