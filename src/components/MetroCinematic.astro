---
import Pictograms from './Pictograms.astro';
---

<!-- ========================================================
     STEP 4: FULL-SCREEN CINEMATIC METRO SCENE
     Strictly per Section 3:
     - Fixed full-screen overlay above everything (z-index 90)
     - 4 layers: Far wall, Mid pillars, Train on tracks, Platform floor
     - Horizon line at ~76% of viewport height (24vh platform floor)
     - Dynamic viewport-calculated train motion (zero clipping)
     - Car 2 center doors align precisely with screen center
     - Direct inline Car 2 SVG doors slide open revealing warm interior
     - Centred "Board the metro →" button over car 2 centre door (z-50)
     - Departure rightward with page reveal behind tail (~0.9s)
     - Reduced motion calm card fallback
     - Zero external audio/video assets, high-performance WAAPI
     ======================================================== -->
<div
  id="metro-cinematic-stage"
  class="fixed inset-0 z-[90] bg-paper overflow-hidden select-none"
  style="display: none; width: 100vw; height: 100vh;"
  role="dialog"
  aria-modal="true"
  aria-label="Metro arrival and boarding"
>
  <!-- Stage Top Controls Bar -->
  <div class="absolute top-0 left-0 right-0 z-40 p-4 sm:p-6 flex items-center justify-between pointer-events-auto">
    <!-- Sound Toggle with Full Text (Section 4.2) -->
    <button
      type="button"
      id="metro-stage-sound-toggle"
      class="px-3 py-1.5 border-2 border-ink bg-surface text-ink font-mono text-xs font-bold uppercase hover:bg-paper transition-colors shadow-[2px_2px_0_var(--ink)]"
      aria-label="Toggle Sound"
    >
      <span id="metro-stage-sound-label">Sound: Off</span>
    </button>

    <!-- Skip Animation Button (Section 3.2) -->
    <button
      type="button"
      id="metro-stage-skip-btn"
      class="px-3 py-1.5 border-2 border-ink bg-ink text-paper font-mono text-xs font-bold uppercase hover:opacity-90 transition-opacity shadow-[2px_2px_0_var(--paper)]"
      aria-label="Skip animation"
    >
      Skip animation ➔
    </button>
  </div>

  <!-- LAYER 1: FAR WALL (Tunnel / Station Depth) -->
  <div
    id="layer-far-wall"
    class="cinematic-layer layer-far-wall absolute inset-0 pointer-events-none bg-[#0D0F14] subway-tile-wall overflow-hidden"
    style="z-index: 10;"
  >
    <!-- Structural Steel Ceiling I-Beams & Girders -->
    <div class="absolute top-0 left-0 right-0 h-12 bg-[#12151C] border-b-2 border-ink flex items-center justify-between px-6 opacity-90">
      <div class="w-full flex items-center justify-around">
        {Array.from({ length: 16 }).map(() => (
          <div class="w-2 h-2 rounded-full bg-ink/70 border border-white/20"></div>
        ))}
      </div>
    </div>

    <!-- Industrial Twin Utility Conduit Pipes -->
    <div class="absolute top-12 left-0 right-0 h-4 flex flex-col justify-between opacity-70 pointer-events-none">
      <div class="w-full h-1 bg-[#2C3440] border-y border-black"></div>
      <div class="w-full h-1 bg-[#B48448] border-y border-black"></div>
    </div>

    <!-- Trackside Signaling Beacon Lamps -->
    <div class="absolute top-16 inset-x-0 flex justify-around px-8 pointer-events-none opacity-80">
      {Array.from({ length: 4 }).map(() => (
        <div class="flex items-center gap-1.5 p-1 bg-[#111111] border border-ink shadow-[2px_2px_0_#000]">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="w-2 h-2 rounded-full bg-line-hardware"></span>
          <span class="w-2 h-2 rounded-full bg-[#E4572E]/40"></span>
        </div>
      ))}
    </div>

    <!-- Ceiling Lights Row -->
    <div class="absolute top-0 left-0 right-0 h-10 flex items-center justify-around px-8 opacity-40">
      {Array.from({ length: 12 }).map(() => (
        <div class="w-16 h-2 bg-surface border border-rule"></div>
      ))}
    </div>
  </div>

  <!-- LAYER 2: MID PILLARS & OVERHEAD SIGN -->
  <div
    id="layer-mid-pillars"
    class="absolute inset-0 pointer-events-none"
    style="z-index: 15;"
  >
    <!-- Architectural Pillars -->
    <div class="absolute inset-0 flex justify-between px-6 sm:px-16 pointer-events-none">
      <div class="w-8 sm:w-12 h-full bg-surface border-x-2 border-ink shadow-[4px_0_0_rgba(0,0,0,0.1)]"></div>
      <div class="w-8 sm:w-12 h-full bg-surface border-x-2 border-ink shadow-[4px_0_0_rgba(0,0,0,0.1)] hidden md:block"></div>
      <div class="w-8 sm:w-12 h-full bg-surface border-x-2 border-ink shadow-[4px_0_0_rgba(0,0,0,0.1)]"></div>
    </div>

    <!-- Hanging Platform Blade Sign (Suspended from ceiling girder, clean compact centering) -->
    <div
      id="metro-overhead-sign"
      class="!absolute z-20 px-5 py-2.5 sm:px-6 sm:py-3 bg-surface border-2 border-ink shadow-[4px_4px_0_var(--ink)] inline-flex items-center gap-3.5 w-auto max-w-md whitespace-nowrap rounded-xs"
      style="position: absolute !important; top: 16px !important; left: 50% !important; transform: translateX(-50%) !important;"
    >
      <!-- Suspension Rods from ceiling -->
      <div class="absolute -top-16 left-6 w-0.5 h-16 bg-ink/70"></div>
      <div class="absolute -top-16 right-6 w-0.5 h-16 bg-ink/70"></div>

      <div id="blade-sign-band" class="w-3 h-9 bg-line-frontend rounded-xs flex-shrink-0"></div>
      <div class="font-mono text-left">
        <div id="blade-sign-code" class="text-[11px] sm:text-xs text-ink-soft uppercase font-bold tracking-wider">PLATFORM 1 // ST-02</div>
        <div id="blade-sign-title" class="font-archivo text-sm sm:text-base font-black text-ink uppercase tracking-tight">ALL PROJECTS</div>
      </div>
    </div>
  </div>

  <!-- LAYER 2.5: STATION WAYFINDING FRIEZE (Mounted ON TOP of pillars so pillars never cut text) -->
  <div
    id="metro-wall-watermark-container"
    class="absolute top-[32%] sm:top-[30%] left-0 right-0 pointer-events-none"
    style="z-index: 18;"
  >
    <div
      id="metro-wall-watermark"
      class="text-center font-archivo font-black text-3xl sm:text-5xl lg:text-7xl uppercase tracking-wider text-white opacity-85 select-none whitespace-nowrap overflow-hidden"
      style="text-shadow: 0 4px 12px #000000, 0 2px 4px #000000;"
    >
      NEXT STOP // THE YUG LINE // TRANSIT
    </div>
  </div>

  <!-- LAYER 4: THE 4-CAR METRO TRAIN (Stands on Track at Horizon 76%) -->
  <div
    id="layer-train-track"
    class="absolute inset-x-0 flex items-end overflow-hidden pointer-events-auto"
    style="bottom: 24vh; height: clamp(140px, 30vh, 280px); z-index: 20;"
  >
    <!-- Flat Horizontal Speed Streaks -->
    <div
      id="metro-speed-streaks"
      class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-16 pointer-events-none overflow-hidden opacity-0 transition-opacity duration-300"
    >
      <div class="w-full h-1 bg-ink opacity-40 mb-2 transform -translate-x-12"></div>
      <div class="w-3/4 h-1.5 bg-line-frontend opacity-60 mb-2 transform translate-x-24"></div>
      <div class="w-full h-1 bg-ink opacity-30 transform -translate-x-8"></div>
    </div>

    <!-- 4-Car Custom SVG Metro Train Container (Dynamically positioned via WAAPI) -->
    <div
      id="metro-train-wrapper"
      class="h-full flex items-end select-none will-change-transform"
      style="transform: translate3d(-3000px, 0, 0);"
    >
      <svg
        id="metro-four-car-svg"
        viewBox="0 0 1600 240"
        class="h-full w-auto select-none pointer-events-none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        preserveAspectRatio="xMinYMax meet"
      >
        <defs>
          <!-- Middle Car Unit Template for Cars 1, 3, 4 -->
          <g id="metro-car-unit">
            <!-- Car Body -->
            <rect x="0" y="24" width="360" height="175" rx="8" fill="var(--surface)" stroke="var(--ink)" stroke-width="3" />
            
            <!-- AC Roof Enclosures -->
            <rect x="40" y="8" width="80" height="16" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
            <rect x="240" y="8" width="80" height="16" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />

            <!-- Destination Livery Stripe -->
            <rect class="car-livery-stripe" x="0" y="152" width="360" height="12" fill="var(--line-frontend)" stroke="var(--ink)" stroke-width="1.5" />
            <rect x="0" y="164" width="360" height="8" fill="var(--ink)" />

            <!-- Underframe & Lower Skirt -->
            <rect x="10" y="199" width="340" height="16" fill="var(--ink)" />

            <!-- Bogies and Steel Wheels -->
            <circle cx="70" cy="222" r="16" fill="var(--ink)" />
            <circle cx="70" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
            <circle cx="120" cy="222" r="16" fill="var(--ink)" />
            <circle cx="120" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
            <line x1="50" y1="222" x2="140" y2="222" stroke="var(--ink)" stroke-width="5" />

            <circle cx="240" cy="222" r="16" fill="var(--ink)" />
            <circle cx="240" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
            <circle cx="290" cy="222" r="16" fill="var(--ink)" />
            <circle cx="290" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
            <line x1="220" y1="222" x2="310" y2="222" stroke="var(--ink)" stroke-width="5" />

            <!-- Left Passenger Window (x=24, width=105) -->
            <rect x="24" y="48" width="105" height="55" rx="4" fill="#111111" />
            <line x1="42" y1="52" x2="62" y2="98" stroke="#ffffff" stroke-width="2" opacity="0.3" />
            <line x1="56" y1="52" x2="76" y2="98" stroke="#ffffff" stroke-width="1.2" opacity="0.2" />

            <!-- Right Passenger Window (x=231, width=105) -->
            <rect x="231" y="48" width="105" height="55" rx="4" fill="#111111" />
            <line x1="249" y1="52" x2="269" y2="98" stroke="#ffffff" stroke-width="2" opacity="0.3" />
            <line x1="263" y1="52" x2="283" y2="98" stroke="#ffffff" stroke-width="1.2" opacity="0.2" />

            <!-- Closed Double Doors -->
            <rect x="150" y="38" width="30" height="160" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" rx="2" />
            <rect x="156" y="52" width="18" height="40" rx="3" fill="#111111" />
            <rect x="180" y="38" width="30" height="160" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" rx="2" />
            <rect x="186" y="52" width="18" height="40" rx="3" fill="#111111" />
            <line x1="180" y1="38" x2="180" y2="198" stroke="var(--ink)" stroke-width="2" />
          </g>

          <!-- Accordion Gangway Bellows -->
          <g id="accordion-gangway">
            <rect x="0" y="36" width="30" height="150" fill="#15171C" stroke="var(--ink)" stroke-width="2" />
            <line x1="8" y1="36" x2="8" y2="186" stroke="#333" stroke-width="2" />
            <line x1="15" y1="36" x2="15" y2="186" stroke="#222" stroke-width="2" />
            <line x1="22" y1="36" x2="22" y2="186" stroke="#333" stroke-width="2" />
          </g>
        </defs>

        <!-- Rail Track Line -->
        <line x1="0" y1="238" x2="1600" y2="238" stroke="var(--ink)" stroke-width="4" />

        <!-- CAR 1: Lead Nose Car (0-370) -->
        <g id="train-car-1" transform="translate(10, 0)">
          <use href="#metro-car-unit" />
          <!-- Aerodynamic Cab Nose on left -->
          <path d="M 0 32 Q -35 80 0 199 Z" fill="var(--surface)" stroke="var(--ink)" stroke-width="3" />
          <!-- Amber Dot-Matrix Destination Header -->
          <rect x="35" y="32" width="140" height="16" fill="#111111" rx="2" stroke="var(--ink)" stroke-width="1.5" />
          <text id="train-cab-dest-text" x="105" y="44" font-family="'IBM Plex Mono', monospace" font-size="8.5" fill="#FFB000" font-weight="bold" text-anchor="middle">ST-02 ALL PROJECTS</text>
          <!-- Flat Headlights -->
          <circle cx="-16" cy="150" r="8" fill="#FFC933" stroke="var(--ink)" stroke-width="2" />
          <circle cx="-16" cy="150" r="4" fill="#ffffff" />
        </g>

        <!-- Gangway 1-2 (370-400) -->
        <use href="#accordion-gangway" x="370" y="0" />

        <!-- CAR 2: HERO Centre Passenger Car (400-760, center door at x = 400 + 180 = 580) -->
        <!-- Inlined directly in SVG so its doors animate open reliably -->
        <g id="train-car-2" transform="translate(400, 0)">
          <!-- Car Body -->
          <rect x="0" y="24" width="360" height="175" rx="8" fill="var(--surface)" stroke="var(--ink)" stroke-width="3" />
          
          <!-- AC Roof Enclosures -->
          <rect x="40" y="8" width="80" height="16" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <rect x="240" y="8" width="80" height="16" rx="3" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />

          <!-- Destination Livery Stripe -->
          <rect class="car-livery-stripe" x="0" y="152" width="360" height="12" fill="var(--line-frontend)" stroke="var(--ink)" stroke-width="1.5" />
          <rect x="0" y="164" width="360" height="8" fill="var(--ink)" />

          <!-- Underframe & Lower Skirt -->
          <rect x="10" y="199" width="340" height="16" fill="var(--ink)" />

          <!-- Bogies and Steel Wheels -->
          <circle cx="70" cy="222" r="16" fill="var(--ink)" />
          <circle cx="70" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <circle cx="120" cy="222" r="16" fill="var(--ink)" />
          <circle cx="120" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <line x1="50" y1="222" x2="140" y2="222" stroke="var(--ink)" stroke-width="5" />

          <circle cx="240" cy="222" r="16" fill="var(--ink)" />
          <circle cx="240" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <circle cx="290" cy="222" r="16" fill="var(--ink)" />
          <circle cx="290" cy="222" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
          <line x1="220" y1="222" x2="310" y2="222" stroke="var(--ink)" stroke-width="5" />

          <!-- Left Passenger Window (x=24, width=105) -->
          <rect x="24" y="48" width="105" height="55" rx="4" fill="#111111" />
          <line x1="42" y1="52" x2="62" y2="98" stroke="#ffffff" stroke-width="2" opacity="0.3" />
          <line x1="56" y1="52" x2="76" y2="98" stroke="#ffffff" stroke-width="1.2" opacity="0.2" />

          <!-- Right Passenger Window (x=231, width=105) -->
          <rect x="231" y="48" width="105" height="55" rx="4" fill="#111111" />
          <line x1="249" y1="52" x2="269" y2="98" stroke="#ffffff" stroke-width="2" opacity="0.3" />
          <line x1="263" y1="52" x2="283" y2="98" stroke="#ffffff" stroke-width="1.2" opacity="0.2" />

          <!-- Car 2 Identification Badge -->
          <rect x="160" y="172" width="40" height="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
          <text x="180" y="183" font-family="'IBM Plex Mono', monospace" font-size="9" fill="var(--ink)" font-weight="bold" text-anchor="middle">CAR 02</text>

          <!-- Warm Glowing Door Interior Slot (Revealed on Door Open) -->
          <g id="car-2-interior" class="door-interior-slot">
            <rect x="150" y="38" width="60" height="160" fill="#FFD98A" stroke="var(--ink)" stroke-width="1.5" />
            <!-- Handrail Grab Pole -->
            <line x1="180" y1="38" x2="180" y2="198" stroke="var(--ink)" stroke-width="2.5" />
            <!-- Commuter Silhouettes Inside -->
            <circle cx="168" cy="80" r="8" fill="var(--ink)" opacity="0.8" />
            <rect x="162" y="92" width="12" height="40" rx="3" fill="var(--ink)" opacity="0.8" />
            <circle cx="192" cy="76" r="8" fill="var(--ink)" opacity="0.8" />
            <rect x="186" y="88" width="12" height="44" rx="3" fill="var(--ink)" opacity="0.8" />
          </g>

          <!-- Directly Animatable Door Leaves -->
          <!-- Left Door Leaf (x=150, width=30) -->
          <g id="car-2-door-left" style="transform: translateX(0); transform-box: fill-box; transition: transform 0.5s ease-out;">
            <rect x="150" y="38" width="30" height="160" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" rx="2" />
            <rect x="156" y="52" width="18" height="40" rx="3" fill="#111111" />
            <line x1="160" y1="55" x2="170" y2="88" stroke="#ffffff" stroke-width="1.5" opacity="0.3" />
          </g>

          <!-- Right Door Leaf (x=180, width=30) -->
          <g id="car-2-door-right" style="transform: translateX(0); transform-box: fill-box; transition: transform 0.5s ease-out;">
            <rect x="180" y="38" width="30" height="160" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" rx="2" />
            <rect x="186" y="52" width="18" height="40" rx="3" fill="#111111" />
            <line x1="190" y1="55" x2="200" y2="88" stroke="#ffffff" stroke-width="1.5" opacity="0.3" />
          </g>

          <!-- Door Center Seam Line -->
          <line id="car-2-door-seam" x1="180" y1="38" x2="180" y2="198" stroke="var(--ink)" stroke-width="2" />
        </g>

        <!-- Gangway 2-3 (760-790) -->
        <use href="#accordion-gangway" x="760" y="0" />

        <!-- CAR 3: Passenger Car (790-1150) -->
        <g id="train-car-3" transform="translate(790, 0)">
          <use href="#metro-car-unit" />
        </g>

        <!-- Gangway 3-4 (1150-1180) -->
        <use href="#accordion-gangway" x="1150" y="0" />

        <!-- CAR 4: Trailing Tail Car (1180-1540) -->
        <g id="train-car-4" transform="translate(1180, 0)">
          <use href="#metro-car-unit" />
          <!-- Tail Lights -->
          <circle cx="365" cy="150" r="6" fill="#D8362B" stroke="var(--ink)" stroke-width="2" />
        </g>
      </svg>
    </div>
  </div>

  <!-- RAILWAY TRACK BED & STEEL RAILS (At 24vh Horizon) -->
  <div
    class="absolute inset-x-0 pointer-events-none"
    style="bottom: 24vh; height: 16px; background-color: #151820; z-index: 18;"
  >
    <!-- Heavy Solid Steel Rail Bar -->
    <div class="w-full h-2 bg-[#8C96AA] border-y border-black"></div>
    <!-- Concrete Railway Sleepers / Ties Pattern -->
    <div
      class="w-full h-2"
      style="background-image: repeating-linear-gradient(90deg, #252A36 0, #252A36 14px, #0E1015 14px, #0E1015 28px);"
    ></div>
  </div>

  <!-- LAYER 3: PLATFORM FLOOR (Starts right at horizon 24vh, goes to bottom) -->
  <div
    id="layer-platform-floor"
    class="!absolute inset-x-0 bottom-0 border-t-4 border-ink pointer-events-none platform-floor-strip"
    style="position: absolute !important; bottom: 0 !important; left: 0 !important; right: 0 !important; height: 24vh; background-color: var(--surface); z-index: 30;"
  >
    <!-- Tactile Yellow Safety Line with Tactile Dots -->
    <div class="platform-tactile-line w-full h-8 bg-line-hardware border-b-2 border-ink flex items-center justify-around px-4">
      {Array.from({ length: 24 }).map(() => (
        <span class="w-2.5 h-2.5 rounded-full bg-ink inline-block opacity-85 shadow-[inset_1px_1px_0_rgba(255,255,255,0.3)]"></span>
      ))}
    </div>

    <!-- Amber LED Station Ticker Board -->
    <div class="max-w-md mx-auto mt-3 px-4 py-2 bg-[#111111] border-2 border-ink flex items-center justify-between font-mono text-xs text-[#FFB000] shadow-[3px_3px_0_#000]">
      <span class="animate-pulse">● SERVICE 01</span>
      <span id="metro-platform-ticker" class="font-bold tracking-widest uppercase">TRAIN APPROACHING</span>
      <span>PLATFORM 1</span>
    </div>

    <!-- Floor Paver Seams -->
    <div
      class="w-full h-full opacity-15"
      style="background-image: linear-gradient(to right, var(--ink) 1px, transparent 1px); background-size: 160px 100%;"
    ></div>
  </div>

  <!-- Centred "Board the metro →" Button (Mounted over Car 2 Centre Doors at z-50) -->
  <div
    id="metro-board-btn-container"
    class="absolute left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 pointer-events-auto select-none"
    style="display: none; bottom: calc(24vh + clamp(48px, 9vh, 84px)); z-index: 50;"
  >
    <!-- Live Platform Clearance Status Badge -->
    <span class="px-3 py-1 bg-[#111111] text-line-hardware border border-line-hardware font-mono text-[11px] font-bold uppercase tracking-wider flex items-center gap-2 shadow-[2px_2px_0_#000]">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      PLATFORM 1 · CAR 02 READY
    </span>

    <button
      type="button"
      id="board-the-metro-btn"
      class="metro-board-action-btn outline-none focus-visible:ring-4 focus-visible:ring-line-hardware focus-visible:ring-offset-2 focus-visible:ring-offset-ink animate-pulse"
      aria-label="Board the metro"
    >
      <span class="flex items-center gap-2">
        <span>BOARD THE METRO</span>
        <span class="text-xl font-bold" aria-hidden="true">➔</span>
      </span>
    </button>

    <!-- 6s Idle Hint -->
    <span id="board-idle-hint" class="font-mono text-xs text-ink-soft bg-paper/95 px-3 py-1 border border-ink shadow-[2px_2px_0_var(--ink)] hidden">
      Press to board.
    </span>
  </div>

  <!-- REDUCED-MOTION CALM CARD (Section 3.8) -->
  <div
    id="metro-reduced-card"
    class="hidden absolute inset-0 z-40 bg-paper p-6 sm:p-12 flex-col items-center justify-center text-center"
  >
    <div class="ticket p-8 max-w-lg w-full bg-surface border-2 border-ink shadow-[8px_8px_0_var(--ink)]">
      <div class="font-mono text-xs text-ink-soft uppercase tracking-wider mb-2">
        // SERVICE READY //
      </div>
      <h2 id="reduced-card-title" class="font-archivo text-3xl font-black text-ink uppercase mb-2">
        Your train is here.
      </h2>
      <p id="reduced-card-desc" class="font-manrope text-base text-ink-soft mb-6">
        Doors are open on Platform 1.
      </p>
      <button
        type="button"
        id="reduced-board-btn"
        class="btn-stub btn-stub--primary w-full justify-center shadow-[4px_4px_0_var(--ink)]"
      >
        <span>Board the metro →</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { metroSound } from '../scripts/sound/metroSound';
  import { sound } from '../scripts/sound';
  import { STATIONS } from '../scripts/journey/constants';
  import type { StationCode } from '../scripts/journey/types';

  document.addEventListener('DOMContentLoaded', () => {
    const stage = document.getElementById('metro-cinematic-stage');
    const trainWrapper = document.getElementById('metro-train-wrapper');
    const streaks = document.getElementById('metro-speed-streaks');
    const boardContainer = document.getElementById('metro-board-btn-container');
    const boardBtn = document.getElementById('board-the-metro-btn');
    const idleHint = document.getElementById('board-idle-hint');
    const ticker = document.getElementById('metro-platform-ticker');
    const skipBtn = document.getElementById('metro-stage-skip-btn');
    const soundToggle = document.getElementById('metro-stage-sound-toggle');
    const soundLabel = document.getElementById('metro-stage-sound-label');

    const leftDoor = document.getElementById('car-2-door-left');
    const rightDoor = document.getElementById('car-2-door-right');
    const doorSeam = document.getElementById('car-2-door-seam');

    const reducedCard = document.getElementById('metro-reduced-card');
    const reducedBoardBtn = document.getElementById('reduced-board-btn');

    let currentDestination: StationCode = 'station-02';
    let isBoarding = false;
    let isLaunching = false;
    let idleTimer: any = null;
    let doorsTimer: any = null;
    let currentAnim: Animation | null = null;
    let lastStopX = 0;

    const isReduced = () =>
      document.documentElement.classList.contains('reduce-motion') ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Update sound toggle label
    const updateSoundLabel = () => {
      if (soundLabel) {
        soundLabel.textContent = metroSound.isEnabled() ? 'Sound: On' : 'Sound: Off';
      }
    };
    updateSoundLabel();

    if (soundToggle) {
      soundToggle.addEventListener('click', () => {
        metroSound.setEnabled(!metroSound.isEnabled());
        updateSoundLabel();
        const mainSoundStatus = document.getElementById('sound-status');
        if (mainSoundStatus) {
          mainSoundStatus.textContent = metroSound.isEnabled() ? 'Sound: On' : 'Sound: Off';
        }
      });
    }

    // Precise Geometric Calculations for Viewport-Fitting Alignment
    // SVG viewBox: 1600 x 240.
    // Car 2 center door is at x = 580 in SVG coordinates (Car 2 starts at 400 + 180 center door = 580).
    const calculatePositions = () => {
      const trackEl = document.getElementById('layer-train-track');
      const viewportWidth = window.innerWidth;

      let trackHeight = 200;
      if (trackEl && trackEl.getBoundingClientRect().height > 0) {
        trackHeight = trackEl.getBoundingClientRect().height;
      }

      const scale = trackHeight / 240;
      const totalTrainWidth = 1600 * scale;
      const car2CenterDoorOffset = 580 * scale;

      // Stop position: Car 2 center door aligns exactly with viewport horizontal center
      const stopX = Math.round((viewportWidth / 2) - car2CenterDoorOffset);

      // Start position: Train begins fully off-screen left
      const startX = Math.round(-totalTrainWidth - 150);

      // Depart position: Train exits fully off-screen right
      const departX = Math.round(viewportWidth + 150);

      return { scale, totalTrainWidth, car2CenterDoorOffset, startX, stopX, departX };
    };

    // Update signage to match destination
    const updateSignage = (destId: StationCode) => {
      const meta = STATIONS[destId];
      if (!meta) return;

      const codeEl = document.getElementById('blade-sign-code');
      const titleEl = document.getElementById('blade-sign-title');
      const bandEl = document.getElementById('blade-sign-band');
      const cabText = document.getElementById('train-cab-dest-text');
      const watermark = document.getElementById('metro-wall-watermark');

      const color = meta.line === 'ai' ? 'var(--line-ai)' :
                    meta.line === 'frontend' ? 'var(--line-frontend)' :
                    meta.line === 'backend' ? 'var(--line-backend)' :
                    meta.line === 'hardware' ? 'var(--line-hardware)' : 'var(--ink)';

      if (codeEl) codeEl.textContent = `PLATFORM 1 // ${meta.code}`;
      if (titleEl) titleEl.textContent = meta.name.toUpperCase();
      if (bandEl) bandEl.style.backgroundColor = color;
      if (cabText) cabText.textContent = `${meta.code} ${meta.name.split('—')[0].trim().toUpperCase()}`;
      if (watermark) watermark.textContent = `NEXT STOP // ${meta.name.toUpperCase()} // THE YUG LINE`;

      document.querySelectorAll('.car-livery-stripe').forEach((stripe) => {
        (stripe as HTMLElement).setAttribute('fill', color);
      });
    };

    // Main Cinematic Execution Function
    const launchMetro = (destinationId: string) => {
      // Prevent double-launch if already launching or stage is already visible
      if (isLaunching || (stage && stage.style.display === 'block')) return;
      isLaunching = true;
      setTimeout(() => { isLaunching = false; }, 1500);

      currentDestination = destinationId as StationCode;
      isBoarding = false;
      clearTimeout(idleTimer);
      clearTimeout(doorsTimer);
      if (currentAnim) currentAnim.cancel();

      if (!stage) return;

      // Scroll window to top
      window.scrollTo(0, 0);

      updateSignage(currentDestination);

      // 1. Lock page scroll and show stage
      stage.style.display = 'block';
      stage.style.opacity = '1';
      document.body.style.overflow = 'hidden';
      const main = document.getElementById('main-content');
      if (main) (main as any).inert = true;

      // Check reduced motion fallback
      if (isReduced()) {
        if (reducedCard) reducedCard.style.display = 'flex';
        metroSound.playDoorOpenChime();
        return;
      } else {
        if (reducedCard) reducedCard.style.display = 'none';
      }

      // Reset positions & streaks
      if (streaks) streaks.style.opacity = '1';
      if (ticker) ticker.textContent = 'TRAIN APPROACHING';
      if (boardContainer) {
        boardContainer.style.display = 'none';
        boardContainer.style.opacity = '0';
      }
      if (idleHint) idleHint.classList.add('hidden');

      // Reset doors to closed state
      if (leftDoor) leftDoor.style.transform = 'translateX(0)';
      if (rightDoor) rightDoor.style.transform = 'translateX(0)';
      if (doorSeam) doorSeam.style.opacity = '1';

      const { startX, stopX } = calculatePositions();
      lastStopX = stopX;

      // Start approach audio sequence (brown noise, flange, brake squeal, pneumatic hiss)
      metroSound.playArrivalSequence();

      let doorsOpened = false;
      const openDoorsAndShowButton = () => {
        if (doorsOpened) return;
        doorsOpened = true;

        if (streaks) streaks.style.opacity = '0';
        if (ticker) ticker.textContent = 'NOW BOARDING';

        // Slide open doors on Car 2 (both CSS and SVG transform attributes for 100% engine compatibility)
        if (leftDoor) {
          leftDoor.style.transform = 'translateX(-26px)';
          leftDoor.setAttribute('transform', 'translate(-26, 0)');
        }
        if (rightDoor) {
          rightDoor.style.transform = 'translateX(26px)';
          rightDoor.setAttribute('transform', 'translate(26, 0)');
        }
        if (doorSeam) doorSeam.style.opacity = '0';

        // Ding-dong chime
        metroSound.playDoorOpenChime();

        // Reveal Board the metro button directly over center doors
        if (boardContainer) {
          boardContainer.style.display = 'flex';
          boardContainer.style.opacity = '1';
          if (boardBtn) {
            boardBtn.innerHTML = '<span class="flex items-center gap-2"><span>BOARD THE METRO</span><span class="text-xl font-bold" aria-hidden="true">➔</span></span>';
            boardBtn.classList.add('animate-pulse');
            boardBtn.focus();
          }
        }

        // 6s idle hint
        idleTimer = setTimeout(() => {
          if (idleHint && !isBoarding) idleHint.classList.remove('hidden');
        }, 6000);
      };

      // Train enters and decelerates to stop with WAAPI (0s - 2.0s)
      if (trainWrapper) {
        currentAnim = trainWrapper.animate(
          [
            { transform: `translate3d(${startX}px, 0, 0) rotate(0deg)` },
            { transform: `translate3d(${stopX}px, 0, 0) rotate(0.4deg)`, offset: 0.88 },
            { transform: `translate3d(${stopX}px, 0, 0) rotate(0deg)`, offset: 1.0 },
          ],
          {
            duration: 2000,
            easing: 'cubic-bezier(0.08, 0.7, 0.2, 1)',
            fill: 'forwards',
          }
        );

        if (currentAnim && currentAnim.finished) {
          currentAnim.finished.then(() => {
            clearTimeout(doorsTimer);
            openDoorsAndShowButton();
          }).catch(() => {});
        }
      }

      // Fallback timer ensures doors open even if WAAPI finished promise is delayed
      doorsTimer = setTimeout(openDoorsAndShowButton, 2050);
    };

    // Boarding Trigger
    const executeBoarding = async () => {
      if (isBoarding) return;
      isBoarding = true;
      clearTimeout(idleTimer);

      if (boardBtn) {
        boardBtn.innerHTML = '<span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span><span>TICKET VALIDATED...</span></span>';
        boardBtn.classList.remove('animate-pulse');
      }
      if (ticker) ticker.textContent = 'TICKET VALIDATED';

      // 1. Ticket person validation & stamp sound effect
      sound.stampThunk();
      setTimeout(() => {
        sound.gateGreen();
      }, 70);

      // 2. Play conductor voice announcement completely before moving
      await new Promise<void>((resolve) => {
        if (!('speechSynthesis' in window)) {
          setTimeout(resolve, 800);
          return;
        }

        try {
          const soundPref = localStorage.getItem('yugline_sound');
          if (soundPref === 'off') {
            setTimeout(resolve, 300);
            return;
          }
        } catch (e) {}

        try {
          window.speechSynthesis.cancel();
          const cleanNames: Record<string, string> = {
            'station-00': 'Base',
            'station-01': 'Achievements',
            'station-02': 'Projects',
            'station-03': 'Experience',
            'station-04': 'Skills',
            'station-05': 'Education',
            'station-06': 'Contact',
          };
          const stationName = cleanNames[currentDestination] || (STATIONS[currentDestination] ? STATIONS[currentDestination].name.replace(/^All\s+/i, '') : 'Next Station');
          const announcement = `Your ticket is verified. Next station is ${stationName}.`;
          const msg = new SpeechSynthesisUtterance(announcement);
          msg.rate = 1.05;
          msg.pitch = 1.0;
          msg.volume = 1.0;
          msg.lang = 'en-US';

          const safetyTimer = setTimeout(resolve, 3000);

          msg.onend = () => {
            clearTimeout(safetyTimer);
            setTimeout(resolve, 100);
          };

          msg.onerror = () => {
            clearTimeout(safetyTimer);
            resolve();
          };

          window.speechSynthesis.speak(msg);
        } catch (e) {
          resolve();
        }
      });

      // 3. Play door closing sequence (3 beeps + pneumatic door thump)
      if (boardBtn) {
        boardBtn.innerHTML = '<span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-line-frontend animate-pulse"></span><span>DOORS CLOSING...</span></span>';
      }
      if (ticker) ticker.textContent = 'DOORS CLOSING';

      await metroSound.playDoorClosingSequence();

      // Close doors on Car 2
      if (leftDoor) {
        leftDoor.style.transform = 'translateX(0)';
        leftDoor.setAttribute('transform', 'translate(0, 0)');
      }
      if (rightDoor) {
        rightDoor.style.transform = 'translateX(0)';
        rightDoor.setAttribute('transform', 'translate(0, 0)');
      }
      if (doorSeam) doorSeam.style.opacity = '1';

      // Short 200ms seal pause before metro moves
      await new Promise((r) => setTimeout(r, 200));

      // 4. NOW the metro starts moving
      if (boardContainer) boardContainer.style.display = 'none';
      if (streaks) streaks.style.opacity = '1';
      if (ticker) ticker.textContent = 'DEPARTING';

      // Play departure audio (motor whine + accelerating clatter panning right)
      metroSound.playDepartureSequence();

      const { departX } = calculatePositions();

      // Train accelerates off to the right with torque pitch (only the train moves)
      if (trainWrapper) {
        currentAnim = trainWrapper.animate(
          [
            { transform: `translate3d(${lastStopX}px, 0, 0) rotate(0deg)` },
            { transform: `translate3d(${lastStopX + 60}px, 0, 0) rotate(-0.3deg)`, offset: 0.15 },
            { transform: `translate3d(${departX}px, 0, 0) rotate(0deg)`, offset: 1.0 },
          ],
          {
            duration: 1400,
            easing: 'cubic-bezier(0.55, 0, 0.9, 0.5)',
            fill: 'forwards',
          }
        );
      }

      // Reveal stop underneath at ~0.9s into departure (Section 3.6)
      setTimeout(() => {
        completeArrival();
      }, 900);
    };

    const completeArrival = () => {
      // 1. Hide overlay
      if (stage) {
        stage.style.opacity = '0';
        stage.style.transition = 'opacity 0.25s ease';
        setTimeout(() => {
          stage.style.display = 'none';
          stage.style.opacity = '1';
          isLaunching = false;
        }, 250);
      }

      // 2. Unlock scroll & remove inert
      document.body.style.overflow = '';
      const main = document.getElementById('main-content');
      if (main) (main as any).inert = false;

      // 3. Move to destination station in state machine
      if ((window as any).__yugline) {
        (window as any).__yugline.arriveAtStation(currentDestination);
      }
    };

    if (boardBtn) {
      boardBtn.addEventListener('click', executeBoarding);
    }
    if (reducedBoardBtn) {
      boardBtn?.classList.remove('animate-pulse');
      reducedBoardBtn.addEventListener('click', completeArrival);
    }

    // Skip animation instant jump
    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        clearTimeout(idleTimer);
        clearTimeout(doorsTimer);
        completeArrival();
      });
    }

    // Handle resize while train is at rest
    window.addEventListener('resize', () => {
      if (!isBoarding && stage && stage.style.display === 'block' && trainWrapper && !isReduced()) {
        const { stopX } = calculatePositions();
        lastStopX = stopX;
        trainWrapper.style.transform = `translate3d(${stopX}px, 0, 0)`;
      }
    });

    // Register globally on window for state machine
    (window as any).__launchMetroCinematic = launchMetro;

    // Direct cinematic preview trigger (?cinematic=projects or #cinematic)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('cinematic') || window.location.hash === '#cinematic') {
      const dest = urlParams.get('cinematic') || 'projects';
      setTimeout(() => launchMetro(dest), 350);
    }
  });
</script>
