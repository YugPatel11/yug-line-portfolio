---
import type { ProjectItem } from '../data/types';
import Pictograms from './Pictograms.astro';
import LineChip from './LineChip.astro';
import ProjectMediaPlaceholder from './ProjectMediaPlaceholder.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isDev = import.meta.env.DEV;
---

<div
  class="ticket p-6 sm:p-8 bg-surface border-2 border-ink shadow-[4px_4px_0_var(--ink)] flex flex-col justify-between project-card transition-all"
  data-lines={project.lines.join(' ')}
>
  <div>
    <!-- Ticket Header: Pictogram, Lines & Fare -->
    <div class="flex items-start justify-between gap-3 border-b border-rule pb-3 mb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 border border-ink bg-paper flex items-center justify-center text-ink flex-shrink-0">
          <Pictograms name={project.pictogram} size={22} />
        </div>
        <div>
          <h3 class="font-archivo text-xl font-bold text-ink">
            {project.title}
          </h3>
          <div class="flex flex-wrap gap-1.5 mt-1">
            {project.lines.map((line) => (
              <LineChip line={line} size="sm" />
            ))}
          </div>
        </div>
      </div>

      <!-- Fare / Grant Badge -->
      {project.grantAmount && (
        <div class="text-right flex-shrink-0">
          <span class="font-mono text-[10px] text-ink-soft uppercase block">GRANT FARE</span>
          <span class="font-mono text-xs font-bold text-ink bg-line-hardware/20 px-2 py-0.5 border border-line-hardware/50 inline-block">
            {project.grantAmount}
          </span>
        </div>
      )}
    </div>

    <!-- Project Purpose & Description -->
    <div class="mb-4">
      <p class="font-mono text-xs text-ink-soft uppercase tracking-wider mb-2">
        {project.tagline}
      </p>
      <p class="font-manrope text-sm sm:text-base text-ink leading-relaxed max-w-[65ch]">
        {project.description}
      </p>
    </div>

    <!-- Tech Stack Chips (Limited to max 3 per card, Section 5.2) -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {project.techStack.slice(0, 3).map((tech) => (
        <span class="font-mono text-xs uppercase tracking-wider px-2.5 py-1 bg-paper border border-rule text-ink">
          {tech}
        </span>
      ))}
      {project.techStack.length > 3 && (
        <span class="font-mono text-xs uppercase tracking-wider px-2 py-1 bg-surface border border-rule text-ink-soft">
          +{project.techStack.length - 3}
        </span>
      )}
    </div>
  </div>

  <div>
    <!-- Perforation and Verification Slot -->
    <div class="ticket-perforation pt-3 mt-2">
      <!-- Designed Media Frame (Rule 12) -->
      <div class="mb-3">
        <ProjectMediaPlaceholder
          title={project.title}
          pictogram={project.pictogram}
          techChips={project.techStack}
          aspectRatio="aspect-[16/7]"
        />
      </div>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <div class="flex items-center gap-3">
          {project.liveUrl && !project.liveUrl.startsWith('TODO') ? (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs font-bold uppercase tracking-wider text-ink hover:text-line-frontend inline-flex items-center gap-1"
            >
              <span>Visit Project</span>
              <Pictograms name="arrow-up-right" size={12} />
            </a>
          ) : (
            <span class="font-mono text-[10px] text-ink-soft uppercase tracking-wider">
              {isDev ? '[DEV: TODO-USER Live Link]' : 'Demo: Pending'}
            </span>
          )}

          {project.repoUrl && (
            project.repoUrl.startsWith('TODO') ? (
              <span class="font-mono text-[10px] text-ink-soft uppercase tracking-wider">
                {isDev ? '[DEV: TODO-USER Repo]' : 'Source: Private'}
              </span>
            ) : (
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-ink hover:underline">
                Repo
              </a>
            )
          )}
        </div>

        <span class="font-mono text-[10px] text-ink-soft uppercase">
          ZONE 03 // STOP
        </span>
      </div>
    </div>
  </div>
</div>
