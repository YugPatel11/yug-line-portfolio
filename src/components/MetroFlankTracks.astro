---
// MetroFlankTracks.astro
// Immersive vertical railway tracks, station pillar blade signage, and live telemetry in widescreen margins
---

<!-- ========================================================
     LEFT FLANK: UP TRACK (TRACK 01) & PILLAR SIGNAGE
     Visible only on widescreen desktops (>= 1420px)
     Hidden on tablets and laptops (< 1420px) to prevent overlap
     ======================================================== -->
<aside
  class="metro-flank-track metro-flank-left fixed left-2 xl:left-4 2xl:left-6 top-20 bottom-6 w-24 2xl:w-28 max-w-[calc((100vw-1340px)/2)] z-20 pointer-events-none hidden min-[1420px]:flex flex-col items-center justify-between select-none"
  aria-hidden="true"
>
  <!-- Background Vertical Railway Track (Steel Rails & Ties) -->
  <div class="absolute inset-0 overflow-hidden flex justify-center opacity-60">
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 100 1000"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
      class="h-full w-full"
    >
      <defs>
        <!-- Wooden/Steel Track Sleepers Pattern -->
        <pattern id="left-track-sleepers" width="100" height="32" patternUnits="userSpaceOnUse">
          <!-- Cross Tie / Sleeper -->
          <rect x="8" y="10" width="84" height="8" rx="1" fill="#181D26" stroke="#2B3444" stroke-width="1.2" />
          <!-- Rail Fastener Clips -->
          <circle cx="28" cy="14" r="2.5" fill="#D97706" />
          <circle cx="72" cy="14" r="2.5" fill="#D97706" />
          <!-- Ballast Gravel Speckles -->
          <circle cx="16" cy="4" r="1" fill="#2A3241" />
          <circle cx="84" cy="24" r="1.2" fill="#2A3241" />
          <circle cx="50" cy="26" r="1" fill="#2A3241" />
        </pattern>

        <!-- Gliding Train Headlight Glare Gradient -->
        <linearGradient id="headlight-sweep-gradient-left" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FFC933" stop-opacity="0" />
          <stop offset="50%" stop-color="#FFC933" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Sleepers Layer -->
      <rect width="100%" height="100%" fill="url(#left-track-sleepers)" />

      <!-- Left Heavy Steel Rail -->
      <line x1="28" y1="0" x2="28" y2="1000" stroke="#4B5563" stroke-width="5" />
      <line x1="28" y1="0" x2="28" y2="1000" stroke="#F3F4F6" stroke-width="1.5" opacity="0.8" />

      <!-- Right Heavy Steel Rail -->
      <line x1="72" y1="0" x2="72" y2="1000" stroke="#4B5563" stroke-width="5" />
      <line x1="72" y1="0" x2="72" y2="1000" stroke="#F3F4F6" stroke-width="1.5" opacity="0.8" />

      <!-- Center Signal Transmission Conduit -->
      <line x1="50" y1="0" x2="50" y2="1000" stroke="var(--line-frontend)" stroke-width="2" stroke-dasharray="8 6" opacity="0.6" />

      <!-- Animated Gliding Train Light Beam (Express Passing Effect) -->
      <rect
        class="train-headlight-beam-left"
        x="24"
        y="-140"
        width="52"
        height="140"
        fill="url(#headlight-sweep-gradient-left)"
      />
    </svg>
  </div>

  <!-- TOP MOUNTED: STATION PILLAR BLADE SIGN & SIGNAL HEAD -->
  <div class="relative z-10 w-full flex flex-col items-center pt-2">
    <!-- Cast Iron Bracket -->
    <div class="w-14 h-2 bg-ink/20 border-x-2 border-t-2 border-ink rounded-t"></div>

    <!-- Main Pillar Badge -->
    <div class="w-full p-2 bg-surface border-2 border-ink shadow-[3px_3px_0_var(--ink)] text-center">
      <div class="flex items-center justify-center gap-1.5 border-b border-rule pb-1 mb-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-mono text-[9px] font-black uppercase text-line-hardware tracking-wider">
          TRACK 01
        </span>
      </div>
      <div class="font-archivo text-[11px] font-black uppercase text-ink tracking-tight">
        UP LINE
      </div>
      <span class="font-mono text-[7px] text-ink-soft block uppercase tracking-wider">EXPRESS</span>

      <!-- 3-Lens Transit Signal Lantern -->
      <div class="mt-2 py-1 px-1.5 bg-[#090C10] border border-ink inline-flex flex-col items-center gap-1 rounded-sm shadow-[inset_0_1px_3px_#000]">
        <!-- Red Lens (Dim) -->
        <span class="w-2.5 h-2.5 rounded-full bg-red-950 border border-red-900/60"></span>
        <!-- Amber Lens (Dim) -->
        <span class="w-2.5 h-2.5 rounded-full bg-amber-950 border border-amber-900/60"></span>
        <!-- Green Lens (Active Glowing) -->
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 border border-emerald-300 shadow-[0_0_8px_#34D399] animate-pulse"></span>
      </div>
      <span class="font-mono text-[7px] font-bold text-emerald-500 mt-1 block tracking-wider">
        CLEAR
      </span>
    </div>
  </div>

  <!-- MIDDLE: STATION MILEPOST & TELEMETRY PILLAR -->
  <div class="relative z-10 w-full flex flex-col items-center py-3">
    <!-- Milepost Plaque -->
    <div class="w-[90%] p-1.5 bg-surface border-2 border-ink shadow-[2px_2px_0_var(--ink)] text-center">
      <span class="font-mono text-[8px] font-black text-ink block">MP 0.0</span>
      <span class="font-mono text-[7px] text-ink-soft block border-t border-rule mt-0.5 pt-0.5 uppercase">
        CENTRAL
      </span>
    </div>

    <!-- Vertical Line Speed Limit Plaque -->
    <div class="mt-2.5 w-8 h-8 rounded-full bg-surface border-2 border-line-hardware flex items-center justify-center shadow-[2px_2px_0_var(--ink)]">
      <span class="font-mono text-[9px] font-black text-line-hardware">90</span>
    </div>
    <span class="font-mono text-[7px] text-ink-soft mt-0.5 uppercase">KM/H</span>
  </div>

  <!-- BOTTOM: THIRD RAIL HIGH VOLTAGE WARNING PLAQUE -->
  <div class="relative z-10 w-full flex flex-col items-center pb-2">
    <!-- Industrial Hazard Warning -->
    <div class="w-full p-2 bg-surface border-2 border-ink shadow-[2px_2px_0_var(--ink)] text-center overflow-hidden">
      <div class="flex items-center justify-center gap-1 mb-1">
        <span class="w-2 h-2 rounded-full bg-line-frontend animate-pulse"></span>
        <span class="font-mono text-[8px] font-black text-line-frontend uppercase tracking-wider">
          750V DC
        </span>
      </div>
      <span class="font-mono text-[7px] text-ink block uppercase leading-tight font-bold">
        THIRD RAIL
      </span>
      <span class="font-mono text-[6px] text-ink-soft block mt-0.5 uppercase">ENERGIZED</span>
    </div>
  </div>
</aside>

<!-- ========================================================
     RIGHT FLANK: DOWN TRACK (TRACK 02) & ROUTE SCHEMATIC
     Visible only on widescreen desktops (>= 1420px)
     Hidden on tablets and laptops (< 1420px) to prevent overlap
     ======================================================== -->
<aside
  class="metro-flank-track metro-flank-right fixed right-2 xl:right-4 2xl:right-6 top-20 bottom-6 w-24 2xl:w-28 max-w-[calc((100vw-1340px)/2)] z-20 pointer-events-none hidden min-[1420px]:flex flex-col items-center justify-between select-none"
  aria-hidden="true"
>
  <!-- Background Vertical Railway Track (Steel Rails & Ties) -->
  <div class="absolute inset-0 overflow-hidden flex justify-center opacity-60">
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 100 1000"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
      class="h-full w-full"
    >
      <defs>
        <!-- Wooden/Steel Track Sleepers Pattern -->
        <pattern id="right-track-sleepers" width="100" height="32" patternUnits="userSpaceOnUse">
          <rect x="8" y="10" width="84" height="8" rx="1" fill="#181D26" stroke="#2B3444" stroke-width="1.2" />
          <circle cx="28" cy="14" r="2.5" fill="#D97706" />
          <circle cx="72" cy="14" r="2.5" fill="#D97706" />
          <circle cx="20" cy="20" r="1.2" fill="#2A3241" />
          <circle cx="80" cy="6" r="1" fill="#2A3241" />
        </pattern>

        <!-- Gliding Train Headlight Glare Gradient -->
        <linearGradient id="headlight-sweep-gradient-right" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#38BDF8" stop-opacity="0" />
          <stop offset="50%" stop-color="#38BDF8" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Sleepers Layer -->
      <rect width="100%" height="100%" fill="url(#right-track-sleepers)" />

      <!-- Left Steel Rail -->
      <line x1="28" y1="0" x2="28" y2="1000" stroke="#4B5563" stroke-width="5" />
      <line x1="28" y1="0" x2="28" y2="1000" stroke="#F3F4F6" stroke-width="1.5" opacity="0.8" />

      <!-- Right Steel Rail -->
      <line x1="72" y1="0" x2="72" y2="1000" stroke="#4B5563" stroke-width="5" />
      <line x1="72" y1="0" x2="72" y2="1000" stroke="#F3F4F6" stroke-width="1.5" opacity="0.8" />

      <!-- Center Power Cable -->
      <line x1="50" y1="0" x2="50" y2="1000" stroke="var(--line-hardware)" stroke-width="2" stroke-dasharray="8 6" opacity="0.6" />

      <!-- Animated Gliding Train Light Beam (Local Passing Effect) -->
      <rect
        class="train-headlight-beam-right"
        x="24"
        y="-140"
        width="52"
        height="140"
        fill="url(#headlight-sweep-gradient-right)"
      />
    </svg>
  </div>

  <!-- TOP MOUNTED: SOLARI TELEMETRY BOARD & TRACK 02 -->
  <div class="relative z-10 w-full flex flex-col items-center pt-2">
    <!-- Cast Iron Bracket -->
    <div class="w-14 h-2 bg-ink/20 border-x-2 border-t-2 border-ink rounded-t"></div>

    <!-- Main Pillar Badge -->
    <div class="w-full p-2 bg-surface border-2 border-ink shadow-[3px_3px_0_var(--ink)] text-center">
      <div class="flex items-center justify-center gap-1.5 border-b border-rule pb-1 mb-1">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span class="font-mono text-[9px] font-black uppercase text-cyan-400 tracking-wider">
          TRACK 02
        </span>
      </div>
      <div class="font-archivo text-[11px] font-black uppercase text-ink tracking-tight">
        DOWN LINE
      </div>
      
      <!-- Mini Solari Flap Time -->
      <div class="mt-2 py-1 px-1 bg-[#090C10] border border-rule shadow-[inset_0_1px_2px_#000]">
        <span class="font-mono text-[8px] font-black text-[#FFB000] block tracking-widest">
          EXP: 02 MIN
        </span>
        <span class="font-mono text-[6px] text-gray-400 block uppercase">
          ON PLATFORM
        </span>
      </div>
    </div>
  </div>

  <!-- MIDDLE: VERTICAL TUBE LINE STATION BEACONS -->
  <div class="relative z-10 w-full flex flex-col items-center py-2">
    <div class="w-full p-2 bg-surface border-2 border-ink shadow-[2px_2px_0_var(--ink)] flex flex-col items-center gap-1.5">
      <span class="font-mono text-[7px] font-black text-ink-soft uppercase border-b border-rule pb-0.5">
        LINE STOPS
      </span>

      <!-- Vertical Station Chain -->
      <div class="relative flex flex-col items-center gap-2 py-1 w-full">
        <!-- Connecting Vertical Rail Strip -->
        <div class="absolute inset-y-1 left-1/2 -translate-x-1/2 w-0.5 bg-rule"></div>

        <!-- ST-00 Base (Active Ping) -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-3 h-3 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1.5 h-1.5 rounded-full bg-line-frontend animate-ping"></span>
          </span>
          <span class="font-mono text-[7px] font-bold text-line-frontend">ST-00</span>
        </div>

        <!-- ST-01 Awards -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-2.5 h-2.5 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-line-hardware"></span>
          </span>
          <span class="font-mono text-[6px] text-ink-soft">ST-01</span>
        </div>

        <!-- ST-02 Projects -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-2.5 h-2.5 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-line-frontend"></span>
          </span>
          <span class="font-mono text-[6px] text-ink-soft">ST-02</span>
        </div>

        <!-- ST-03 Crew -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-2.5 h-2.5 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-line-backend"></span>
          </span>
          <span class="font-mono text-[6px] text-ink-soft">ST-03</span>
        </div>

        <!-- ST-04 Tools -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-2.5 h-2.5 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-line-hardware"></span>
          </span>
          <span class="font-mono text-[6px] text-ink-soft">ST-04</span>
        </div>

        <!-- ST-05 Edu -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-2.5 h-2.5 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-line-ai"></span>
          </span>
          <span class="font-mono text-[6px] text-ink-soft">ST-05</span>
        </div>

        <!-- ST-06 End -->
        <div class="relative z-10 flex items-center justify-center gap-1 w-full">
          <span class="w-2.5 h-2.5 rounded-full bg-surface border border-ink flex items-center justify-center">
            <span class="w-1 h-1 rounded-full bg-ink"></span>
          </span>
          <span class="font-mono text-[6px] text-ink-soft">ST-06</span>
        </div>
      </div>
    </div>
  </div>

  <!-- BOTTOM: NOTCHED TRANSIT PASS ARTIFACT -->
  <div class="relative z-10 w-full flex flex-col items-center pb-2">
    <div class="w-full p-2 bg-surface border-2 border-ink shadow-[2px_2px_0_var(--ink)] text-center relative overflow-hidden">
      <!-- Notched side punch holes -->
      <div class="absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-paper border border-ink"></div>
      <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-paper border border-ink"></div>

      <span class="font-mono text-[7px] text-ink-soft block uppercase">TRANSIT AUTH</span>
      <span class="font-archivo text-[9px] font-black text-ink block uppercase tracking-tight">
        ALL-PASS
      </span>
      
      <!-- Mini Barcode -->
      <div class="flex justify-center items-center gap-0.5 mt-1 h-3 opacity-70">
        <span class="w-0.5 h-full bg-ink"></span>
        <span class="w-1 h-full bg-ink"></span>
        <span class="w-0.5 h-full bg-ink"></span>
        <span class="w-1.5 h-full bg-ink"></span>
        <span class="w-0.5 h-full bg-ink"></span>
        <span class="w-1 h-full bg-ink"></span>
      </div>
    </div>
  </div>
</aside>

<style>
  /* Gliding Train Headlight Simulation */
  @keyframes trainGlideDownLeft {
    0% {
      transform: translateY(-160px);
      opacity: 0;
    }
    10% {
      opacity: 0.9;
    }
    45% {
      transform: translateY(105vh);
      opacity: 0.9;
    }
    50%, 100% {
      transform: translateY(105vh);
      opacity: 0;
    }
  }

  @keyframes trainGlideDownRight {
    0%, 35% {
      transform: translateY(-160px);
      opacity: 0;
    }
    45% {
      opacity: 0.9;
    }
    80% {
      transform: translateY(105vh);
      opacity: 0.9;
    }
    85%, 100% {
      transform: translateY(105vh);
      opacity: 0;
    }
  }

  .train-headlight-beam-left {
    animation: trainGlideDownLeft 14s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .train-headlight-beam-right {
    animation: trainGlideDownRight 16s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .train-headlight-beam-left,
    .train-headlight-beam-right {
      animation: none !important;
      display: none !important;
    }
  }
</style>
