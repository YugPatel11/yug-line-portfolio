---
import BaseLayout from '../layouts/BaseLayout.astro';
import StationHeader from '../components/StationHeader.astro';
import OverviewMap from '../components/OverviewMap.astro';
import DeparturesBoard from '../components/DeparturesBoard.astro';
import ProjectStop from '../components/ProjectStop.astro';
import ProjectDossierModal from '../components/ProjectDossierModal.astro';
import ExperienceTicket from '../components/ExperienceTicket.astro';
import TechLegend from '../components/TechLegend.astro';
import EducationTicket from '../components/EducationTicket.astro';
import TerminusContact from '../components/TerminusContact.astro';
import Pictograms from '../components/Pictograms.astro';
import MindTheGapDivider from '../components/MindTheGapDivider.astro';

import WelcomeScreen from '../components/WelcomeScreen.astro';
import StationEntranceLoader from '../components/StationEntranceLoader.astro';
import MetroCinematic from '../components/MetroCinematic.astro';
import AllStopsSheet from '../components/AllStopsSheet.astro';
import TicketCounter from '../components/TicketCounter.astro';
import TicketScreen from '../components/TicketScreen.astro';
import GateScreen from '../components/GateScreen.astro';
import JourneyControls from '../components/JourneyControls.astro';

import { PROFILE, PROJECTS } from '../data/portfolio';
---

<BaseLayout>
  <!-- Full-Screen Station Entrance Loader (Phase U1) -->
  <StationEntranceLoader />

  <!-- Full-Screen Entry Welcome Screen (Step 0) -->
  <WelcomeScreen />

  <!-- Full-Screen Cinematic Metro Stage (Step 4) -->
  <MetroCinematic />

  <!-- All Stops Sheet Modal (Tap & Go Navigation) -->
  <AllStopsSheet />

  <!-- Fixed Bottom Decision Bar & Live Announcer -->
  <JourneyControls />

  <!-- Accessible Skip Link -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ink focus:text-paper focus:font-mono focus:text-xs"
  >
    Skip to main content
  </a>

  <!-- Fixed Transit Header Navigation (Section 5.4 Simplified Header) -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-paper border-b-2 border-ink" role="banner">
    <div class="max-w-site mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <!-- 1. Passenger Name & Identity -->
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-line-frontend" aria-hidden="true"></span>
        <a href="#station-00" class="font-archivo font-extrabold text-lg sm:text-xl text-ink tracking-tight hover:opacity-80">
          YUG ROJIVADIYA
        </a>
      </div>

      <!-- Desktop Navigation: 4 Core Items + Resume -->
      <div class="hidden md:flex items-center gap-3 font-mono text-xs">
        <!-- 2. Skip the metro · see everything (or station links in express mode) -->
        <button
          type="button"
          id="day-pass-btn"
          class="day-pass-toggle-btn px-3 py-1.5 bg-surface border border-rule hover:border-ink text-ink font-bold transition-colors"
          aria-label="Skip the metro · see everything"
        >
          Skip the metro · see everything
        </button>

        <button
          type="button"
          id="travel-card-btn"
          class="px-3 py-1.5 bg-surface border border-rule hover:border-ink text-ink font-bold transition-colors"
          aria-label="Open All Stops Overview"
          title="All Stops (T)"
        >
          All stops
        </button>

        <!-- 3. Sound: On / Off -->
        <button
          type="button"
          id="sound-toggle"
          class="px-3 py-1.5 border border-rule bg-surface text-ink hover:border-ink transition-colors font-bold"
          aria-label="Toggle Web Audio Sound Effects"
        >
          <span id="sound-status">Sound: Off</span>
        </button>

        <!-- 4. Theme: Dark / Light -->
        <button
          type="button"
          id="theme-toggle"
          class="px-3 py-1.5 border border-rule bg-surface text-ink hover:border-ink transition-colors font-bold"
          aria-label="Toggle Night/Day Mode"
        >
          <span class="hidden dark:inline">Light</span>
          <span class="inline dark:hidden">Dark</span>
        </button>

        <!-- Hidden motion toggle accessible via key M or screen reader -->
        <button
          type="button"
          id="motion-toggle"
          class="sr-only focus:not-sr-only px-2 py-1 bg-surface border border-ink text-ink"
          aria-label="Toggle Reduced Motion"
        >
          <span id="motion-status">Motion: On</span>
        </button>

        <!-- Résumé Button -->
        <a
          href={PROFILE.contacts.resumeUrl}
          download
          class="btn-stub !min-h-[38px] !px-4 text-xs"
        >
          <span>Résumé</span>
          <Pictograms name="arrow-up-right" size={12} />
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          class="px-3 py-1.5 border-2 border-ink bg-surface font-mono text-xs uppercase font-bold text-ink"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
        >
          Menu
        </button>
      </div>
    </div>

    <!-- Mobile Full-Screen Drawer Menu -->
    <div
      id="mobile-nav-menu"
      class="hidden fixed inset-x-0 top-16 bottom-0 z-50 bg-paper p-6 overflow-y-auto border-t-2 border-ink flex flex-col justify-between"
    >
      <div class="space-y-4 font-mono">
        <div class="text-xs uppercase text-ink-soft border-b border-rule pb-2">
          // The Yug Line Navigation
        </div>
        <button
          type="button"
          class="day-pass-toggle-btn w-full p-4 border-2 border-ink bg-surface text-left font-bold text-sm uppercase text-ink"
        >
          Skip the metro · see everything
        </button>
        <button
          type="button"
          id="mobile-all-stops-btn"
          class="w-full p-4 border-2 border-ink bg-surface text-left font-bold text-sm uppercase text-ink"
        >
          All stops (Stops visited: 1 of 7)
        </button>
        <div class="grid grid-cols-2 gap-3 pt-2">
          <button
            type="button"
            id="mobile-sound-toggle"
            class="p-3 border-2 border-ink bg-surface font-bold text-xs uppercase text-ink text-center"
          >
            Sound: Off
          </button>
          <button
            type="button"
            id="mobile-theme-toggle"
            class="p-3 border-2 border-ink bg-surface font-bold text-xs uppercase text-ink text-center"
          >
            Theme
          </button>
        </div>
        <div class="pt-2">
          <a
            href={PROFILE.contacts.resumeUrl}
            download
            class="btn-stub w-full text-center justify-center"
          >
            <span>Download Résumé</span>
            <Pictograms name="arrow-up-right" size={14} />
          </a>
        </div>
      </div>

      <button
        type="button"
        id="mobile-menu-close-btn"
        class="mt-6 w-full p-3 border-2 border-rule bg-surface font-mono text-xs font-bold uppercase text-ink-soft text-center"
      >
        Close ✕
      </button>
    </div>
  </header>

  <!-- Central Railway Guide Rails Container (Main Content) -->
  <main id="main-content" role="main" class="max-w-site mx-auto px-4 sm:px-6 pt-24 pb-60 sm:pb-72 relative">
    
    <!-- ========================================================
         JOURNEY MODE FLOW (Steps 1, 2, 3)
         Visible in Journey Mode during booking flow
         ======================================================== -->
    <div id="journey-flow-wrapper" class="w-full">
      <!-- Step 1 of 3: Ticket Counter with Clerk (Signature Feature Section 4) -->
      <TicketCounter />

      <!-- Step 2 of 3: Your Ticket -->
      <TicketScreen />

      <!-- Step 3 of 3: Scan Your Ticket -->
      <GateScreen />
    </div>

    <!-- ========================================================
         STATION 00: CENTRAL DEPARTURE (ORIGIN & IDENTITY)
         Visible in Express Mode and when visiting Station 00
         ======================================================== -->
    <section id="station-00" aria-labelledby="heading-st-00" class="station-set subway-tile-wall wall-frontend my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-00"
          name="Central Departure"
          category="Origin & Identity"
          lineVariant="frontend"
          id="heading-st-00"
        />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Large Origin Ticket -->
          <div class="lg:col-span-7">
            <div class="ticket ticket-notched p-6 sm:p-10 bg-surface border-2 border-ink shadow-[8px_8px_0_var(--ink)]">
              <!-- Routing Header -->
              <div class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-ink pb-4 mb-6">
                <div>
                  <span class="mono-label block">FROM STATION</span>
                  <span class="font-mono text-sm sm:text-base font-bold text-ink">BACKEND LOGIC</span>
                </div>
                <div class="font-mono text-xl text-line-frontend font-black" aria-hidden="true">➔➔➔</div>
                <div class="text-right">
                  <span class="mono-label block">TO DESTINATION</span>
                  <span class="font-mono text-sm sm:text-base font-bold text-ink">SMOOTH UIs</span>
                </div>
              </div>

              <!-- Name & Bio -->
              <div class="mb-6">
                <span class="mono-label block mb-1">PASSENGER / ARCHITECT</span>
                <h1 class="font-archivo text-4xl sm:text-6xl lg:text-7xl font-black text-ink tracking-tight uppercase leading-[0.95]">
                  {PROFILE.name}
                </h1>
                <p class="font-mono text-base sm:text-lg text-ink-soft mt-3 font-semibold">
                  // {PROFILE.role}
                </p>
                <p class="font-manrope text-base sm:text-lg text-ink mt-3 leading-relaxed max-w-[65ch]">
                  "{PROFILE.tagline}"
                </p>
              </div>

              <!-- Proof Chips -->
              <div class="flex flex-wrap gap-2 mb-8 font-mono text-xs">
                <span class="px-3 py-1 bg-paper border border-ink text-ink font-bold inline-flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  {PROFILE.status}
                </span>
                <span class="px-3 py-1 bg-paper border border-rule text-ink">
                  Exp: {PROFILE.experienceYears}
                </span>
                <span class="px-3 py-1 bg-paper border border-rule text-ink">
                  Grants: {PROFILE.grantTotal}
                </span>
                <span class="px-3 py-1 bg-paper border border-rule text-ink">
                  {PROFILE.leadershipRole}
                </span>
              </div>

              <!-- Action Buttons -->
              <div class="ticket-perforation pt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                <button
                  type="button"
                  id="hero-choose-stop-btn"
                  class="btn-stub btn-stub--primary justify-center"
                >
                  <span>Choose a destination stop</span>
                  <span class="font-bold">➔</span>
                </button>

                <a
                  href={PROFILE.contacts.resumeUrl}
                  download
                  class="btn-stub !bg-surface !text-ink hover:!bg-paper justify-center"
                >
                  <span>Download Résumé</span>
                  <Pictograms name="arrow-up-right" size={14} />
                </a>
              </div>
            </div>
          </div>

          <!-- Transit Route Diagram -->
          <div class="lg:col-span-5">
            <OverviewMap />
          </div>
        </div>
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

    <!-- ========================================================
         STATION 01: ACHIEVEMENTS
         ======================================================== -->
    <section id="station-01" aria-labelledby="heading-st-01" class="station-set subway-tile-wall wall-hardware my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <MindTheGapDivider nextStopCode="ST-01" nextStopName="ACHIEVEMENTS" />
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-01"
          name="Achievements"
          category="Track record & awards"
          lineVariant="hardware"
          id="heading-st-01"
        />

        <DeparturesBoard />
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

    <!-- ========================================================
         STATION 02: ALL PROJECTS
         ======================================================== -->
    <section id="station-02" aria-labelledby="heading-st-02" class="station-set subway-tile-wall wall-frontend my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <a id="projects" class="sr-only">All Projects Anchor</a>
      <MindTheGapDivider nextStopCode="ST-02" nextStopName="ALL PROJECTS" />
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-02"
          name="All projects"
          category="Curated production systems across 4 lines"
          lineVariant="frontend"
          id="heading-st-02"
        />

        <!-- Station Platform Telemetry Board (LED Operations Matrix) -->
        <div class="mb-8 p-4 sm:p-6 bg-[#0c0e14] border-2 border-ink shadow-[4px_4px_0_var(--ink)] font-mono text-paper">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule/30 pb-3 mb-4">
            <div class="flex items-center gap-2 text-xs sm:text-sm">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="font-bold uppercase tracking-wider text-white">PLATFORM 02 // DISPATCH BAY OPERATIONS</span>
            </div>
            <div class="flex items-center gap-4 text-xs font-mono text-ink-soft">
              <span>INTERLOCKING: <strong class="text-emerald-400">ACTIVE</strong></span>
              <span>FLEET STATUS: <strong class="text-[#FFC933]">100% OPERATIONAL</strong></span>
            </div>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="p-3 bg-surface border border-rule/50">
              <div class="text-[10px] text-ink-soft uppercase tracking-wider font-bold">FLEET STRENGTH</div>
              <div class="text-xl sm:text-2xl font-archivo font-black text-ink mt-0.5">8 BUILDS</div>
              <div class="text-[10px] text-ink-soft mt-1">Certified Production Ready</div>
            </div>
            <div class="p-3 bg-surface border border-rule/50">
              <div class="text-[10px] text-ink-soft uppercase tracking-wider font-bold">GOV'T SSIP GRANTS</div>
              <div class="text-xl sm:text-2xl font-archivo font-black text-line-hardware mt-0.5">₹65,000</div>
              <div class="text-[10px] text-ink-soft mt-1">3 State Innovation Grants</div>
            </div>
            <div class="p-3 bg-surface border border-rule/50">
              <div class="text-[10px] text-ink-soft uppercase tracking-wider font-bold">IPR & PATENTS</div>
              <div class="text-xl sm:text-2xl font-archivo font-black text-line-ai mt-0.5">1 IPR APPLIED</div>
              <div class="text-[10px] text-ink-soft mt-1">EcoShortX Vision IP</div>
            </div>
            <div class="p-3 bg-surface border border-rule/50">
              <div class="text-[10px] text-ink-soft uppercase tracking-wider font-bold">CAMPUS DEPLOYMENT</div>
              <div class="text-xl sm:text-2xl font-archivo font-black text-line-backend mt-0.5">100% FACULTY</div>
              <div class="text-[10px] text-ink-soft mt-1">EMS Sole Developer</div>
            </div>
          </div>
        </div>

        <!-- Industrial Track Bay Interlocking Switcher & Live Search Bar -->
        <div class="mb-6 p-4 sm:p-5 bg-surface border-2 border-ink shadow-[4px_4px_0_var(--ink)]">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-3 border-b border-rule mb-4">
            <!-- Interlocking Track Switcher Buttons -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 font-mono text-xs" role="toolbar" aria-label="Project line filters">
              <button
                type="button"
                class="project-filter-btn px-3.5 py-2 border-2 border-ink bg-ink text-paper font-bold uppercase transition-all shadow-[2px_2px_0_var(--paper)] flex items-center gap-2"
                data-filter="all"
                aria-pressed="true"
              >
                <span class="w-2 h-2 rounded-full bg-paper"></span>
                <span>ALL BERTHS (8)</span>
              </button>
              <button
                type="button"
                class="project-filter-btn px-3.5 py-2 border-2 border-rule bg-paper text-ink hover:border-ink font-bold uppercase transition-all flex items-center gap-2"
                data-filter="frontend"
                aria-pressed="false"
              >
                <span class="w-2 h-2 rounded-full bg-line-frontend"></span>
                <span>FRONTEND (6)</span>
              </button>
              <button
                type="button"
                class="project-filter-btn px-3.5 py-2 border-2 border-rule bg-paper text-ink hover:border-ink font-bold uppercase transition-all flex items-center gap-2"
                data-filter="backend"
                aria-pressed="false"
              >
                <span class="w-2 h-2 rounded-full bg-line-backend"></span>
                <span>BACKEND (7)</span>
              </button>
              <button
                type="button"
                class="project-filter-btn px-3.5 py-2 border-2 border-rule bg-paper text-ink hover:border-ink font-bold uppercase transition-all flex items-center gap-2"
                data-filter="ai"
                aria-pressed="false"
              >
                <span class="w-2 h-2 rounded-full bg-line-ai"></span>
                <span>AI / ML (3)</span>
              </button>
              <button
                type="button"
                class="project-filter-btn px-3.5 py-2 border-2 border-rule bg-paper text-ink hover:border-ink font-bold uppercase transition-all flex items-center gap-2"
                data-filter="hardware"
                aria-pressed="false"
              >
                <span class="w-2 h-2 rounded-full bg-line-hardware"></span>
                <span>HARDWARE (2)</span>
              </button>
            </div>

            <!-- Live Status Counter -->
            <div class="font-mono text-xs text-ink-soft whitespace-nowrap flex items-center gap-1.5 self-end lg:self-auto">
              <span>DISPATCHING:</span>
              <span id="fleet-live-counter" class="font-bold text-ink bg-paper px-2 py-0.5 border border-rule">
                8 OF 8 BERTHS
              </span>
            </div>
          </div>

          <!-- Instant Search Input -->
          <div class="relative w-full">
            <input
              type="text"
              id="project-search-input"
              placeholder="Search fleet by tech (e.g. Django, Flutter, Python, Firebase, Grant, IPR, EMS)..."
              class="w-full px-4 py-2.5 bg-paper border-2 border-ink text-ink font-mono text-xs placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-line-frontend transition-all shadow-[2px_2px_0_var(--ink)]"
              aria-label="Search systems by tech or keyword"
            />
            <button
              type="button"
              id="project-search-clear"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs font-bold text-ink-soft hover:text-ink px-1.5 py-0.5 border border-rule bg-surface"
              aria-label="Clear search"
            >
              CLEAR ✕
            </button>
          </div>
        </div>

        <!-- Main Project Stops Grid (All 8 Production Systems in Exact User Order) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
          {PROJECTS.map((project) => (
            <ProjectStop project={project} />
          ))}
        </div>

        <!-- Empty Search State -->
        <div id="projects-empty-state" class="hidden p-8 border-2 border-dashed border-ink bg-surface text-center font-mono my-6">
          <div class="text-sm font-bold text-ink mb-1">NO PRODUCTION SYSTEMS MATCH THIS TRACK QUERY</div>
          <p class="text-xs text-ink-soft mb-4">Try checking spelling or clear search filters to view all 8 platform berths.</p>
          <button
            type="button"
            id="reset-project-filters-btn"
            class="px-4 py-2 bg-ink text-paper font-bold text-xs uppercase border border-ink shadow-[2px_2px_0_var(--paper)]"
          >
            Reset Filters ➔
          </button>
        </div>
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

    <!-- ========================================================
         STATION 03: EXPERIENCE
         ======================================================== -->
    <section id="station-03" aria-labelledby="heading-st-03" class="station-set subway-tile-wall wall-backend my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <a id="crew" class="sr-only">Experience Anchor</a>
      <MindTheGapDivider nextStopCode="ST-03" nextStopName="EXPERIENCE" />
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-03"
          name="Experience"
          category="Work history & leadership"
          lineVariant="backend"
          id="heading-st-03"
        />

        <ExperienceTicket />
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

    <!-- ========================================================
         STATION 04: SKILLS AND TOOLS
         ======================================================== -->
    <section id="station-04" aria-labelledby="heading-st-04" class="station-set subway-tile-wall wall-hardware my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <a id="legend" class="sr-only">Skills Anchor</a>
      <MindTheGapDivider nextStopCode="ST-04" nextStopName="SKILLS AND TOOLS" />
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-04"
          name="Skills and tools"
          category="Technical capabilities"
          lineVariant="hardware"
          id="heading-st-04"
        />

        <TechLegend />
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

    <!-- ========================================================
         STATION 05: EDUCATION
         ======================================================== -->
    <section id="station-05" aria-labelledby="heading-st-05" class="station-set subway-tile-wall wall-ai my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <a id="education" class="sr-only">Education Anchor</a>
      <MindTheGapDivider nextStopCode="ST-05" nextStopName="EDUCATION" />
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-05"
          name="Education"
          category="Degree & foundation"
          lineVariant="ai"
          id="heading-st-05"
        />

        <EducationTicket />
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

    <!-- ========================================================
         STATION 06: CONTACT ME
         ======================================================== -->
    <section id="station-06" aria-labelledby="heading-st-06" class="station-set subway-tile-wall wall-neutral my-8 relative">
      <div class="station-architrave" aria-hidden="true"></div>
      <a id="contact" class="sr-only">Contact Anchor</a>
      <MindTheGapDivider nextStopCode="ST-06" nextStopName="CONTACT ME (TERMINUS)" />
      <div class="p-4 sm:p-8 md:p-10">
        <StationHeader
          code="ST-06"
          name="Contact me"
          category="Get in touch"
          lineVariant="default"
          id="heading-st-06"
        />

        <TerminusContact />
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

        <TerminusContact />
      </div>

      <!-- Station Platform Floor -->
      <div class="platform-floor-strip mt-6" aria-hidden="true">
        <div class="platform-tactile-line"></div>
        <div class="platform-edge-hazard"></div>
      </div>
    </section>

  </main>

  <!-- ST-03 Focused Transit Inspection Dossier Modal -->
  <ProjectDossierModal />

  <!-- Interactive Scripts (Client-side interactivity) -->
  <script>
    import { JourneyStateMachine } from '../scripts/journey/machine';
    import { initInteractions } from '../scripts/interactions';
    import { metroSound } from '../scripts/sound/metroSound';

    document.addEventListener('DOMContentLoaded', () => {
      // Expose sound engine
      (window as any).__yugsound = metroSound;

      // Sound Toggle Handler
      const soundBtn = document.getElementById('sound-toggle');
      const soundStatus = document.getElementById('sound-status');
      if (soundBtn && soundStatus) {
        if (metroSound.isEnabled()) {
          soundStatus.textContent = 'Sound: On';
        }
        soundBtn.addEventListener('click', () => {
          const nextState = !metroSound.isEnabled();
          metroSound.setEnabled(nextState);
          soundStatus.textContent = nextState ? 'Sound: On' : 'Sound: Off';
          const stageLabel = document.getElementById('metro-stage-sound-label');
          if (stageLabel) stageLabel.textContent = nextState ? 'Sound: On' : 'Sound: Off';
        });
      }

      // Initialize Journey State Machine & Interactions
      const machine = new JourneyStateMachine();
      initInteractions();

      // Expose to window for map/ticket triggers
      (window as any).__yugline = machine;

      // Header navigation station link delegation
      document.querySelectorAll('a[href^="#station-"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href) {
            e.preventDefault();
            const stationId = href.replace('#', '') as any;
            machine.navigateToStation(stationId);
          }
        });
      });

      // 1. Reduced Motion Toggle
      const motionBtn = document.getElementById('motion-toggle');
      const motionStatus = document.getElementById('motion-status');
      
      const updateMotionUI = (isReduced: boolean) => {
        if (isReduced) {
          document.documentElement.classList.add('reduce-motion');
          if (motionStatus) motionStatus.textContent = 'MOTION: OFF';
        } else {
          document.documentElement.classList.remove('reduce-motion');
          if (motionStatus) motionStatus.textContent = 'MOTION: ON';
        }
      };

      try {
        const savedMotion = localStorage.getItem('yugline_reduce_motion');
        if (savedMotion === 'true' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          updateMotionUI(true);
        }
      } catch (e) {}

      if (motionBtn) {
        motionBtn.addEventListener('click', () => {
          const currentlyReduced = document.documentElement.classList.contains('reduce-motion');
          const nextState = !currentlyReduced;
          updateMotionUI(nextState);
          try {
            localStorage.setItem('yugline_reduce_motion', String(nextState));
          } catch (e) {}
        });
      }

      // 2. Theme toggle
      const toggleBtn = document.getElementById('theme-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          document.documentElement.classList.toggle('dark');
        });
      }

      // Mobile Menu Drawer Binding
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileNavMenu = document.getElementById('mobile-nav-menu');
      const mobileCloseBtn = document.getElementById('mobile-menu-close-btn');
      const mobileThemeBtn = document.getElementById('mobile-theme-toggle');
      const mobileSoundBtn = document.getElementById('mobile-sound-toggle');
      const mobileAllStopsBtn = document.getElementById('mobile-all-stops-btn');

      if (mobileMenuBtn && mobileNavMenu) {
        mobileMenuBtn.addEventListener('click', () => {
          mobileNavMenu.classList.toggle('hidden');
          const isExpanded = !mobileNavMenu.classList.contains('hidden');
          mobileMenuBtn.setAttribute('aria-expanded', String(isExpanded));
        });
      }

      if (mobileCloseBtn && mobileNavMenu) {
        mobileCloseBtn.addEventListener('click', () => {
          mobileNavMenu.classList.add('hidden');
          if (mobileMenuBtn) mobileMenuBtn.setAttribute('aria-expanded', 'false');
        });
      }

      if (mobileThemeBtn && toggleBtn) {
        mobileThemeBtn.addEventListener('click', () => {
          toggleBtn.click();
        });
      }

      if (mobileSoundBtn) {
        mobileSoundBtn.addEventListener('click', () => {
          const mainSoundBtn = document.getElementById('sound-toggle');
          if (mainSoundBtn) mainSoundBtn.click();
        });
      }

      if (mobileAllStopsBtn) {
        mobileAllStopsBtn.addEventListener('click', () => {
          if (mobileNavMenu) mobileNavMenu.classList.add('hidden');
          const travelCardBtn = document.getElementById('travel-card-btn');
          if (travelCardBtn) travelCardBtn.click();
        });
      }

      // 2. ST-03 Project filters, live search & dual-view switcher
      const filterBtns = document.querySelectorAll('.project-filter-btn');
      const cards = document.querySelectorAll('.project-card');
      const searchInput = document.getElementById('project-search-input') as HTMLInputElement;
      const searchClear = document.getElementById('project-search-clear');
      const liveCounter = document.getElementById('fleet-live-counter');
      const emptyState = document.getElementById('projects-empty-state');
      const resetBtn = document.getElementById('reset-project-filters-btn');

      let currentFilter = 'all';

      const applyFilters = () => {
        const query = (searchInput?.value || '').toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardEl = card as HTMLElement;
          const cardLines = (cardEl.getAttribute('data-lines') || '').split(' ');
          const title = (cardEl.getAttribute('data-title') || '').toLowerCase();
          const tech = (cardEl.getAttribute('data-tech') || '').toLowerCase();
          const text = cardEl.textContent?.toLowerCase() || '';

          const matchesLine = currentFilter === 'all' || cardLines.includes(currentFilter);
          const matchesQuery = !query || title.includes(query) || tech.includes(query) || text.includes(query);

          if (matchesLine && matchesQuery) {
            cardEl.style.display = 'flex';
            visibleCount++;
          } else {
            cardEl.style.display = 'none';
          }
        });

        if (liveCounter) {
          liveCounter.textContent = `${visibleCount} OF ${cards.length} BERTHS`;
        }

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }

        if (searchClear) {
          if (query.length > 0) {
            searchClear.classList.remove('hidden');
          } else {
            searchClear.classList.add('hidden');
          }
        }
      };

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentFilter = btn.getAttribute('data-filter') || 'all';

          // Play tactile track switch sound
          if (metroSound.isEnabled()) {
            metroSound.beep();
          }

          // Style active button
          filterBtns.forEach((b) => {
            b.classList.remove('bg-ink', 'text-paper', 'border-ink');
            b.classList.add('bg-paper', 'text-ink', 'border-rule');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('bg-ink', 'text-paper', 'border-ink');
          btn.classList.remove('bg-paper', 'text-ink', 'border-rule');
          btn.setAttribute('aria-pressed', 'true');

          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
      }

      if (searchClear) {
        searchClear.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          applyFilters();
          searchInput?.focus();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentFilter = 'all';
          if (searchInput) searchInput.value = '';
          const allBtn = document.querySelector('.project-filter-btn[data-filter="all"]') as HTMLElement;
          if (allBtn) allBtn.click();
          applyFilters();
        });
      }

      // Plaque Tab View Switcher (Vitrine vs Blueprint)
      document.addEventListener('click', (e) => {
        const tabBtn = (e.target as HTMLElement).closest('.plaque-tab-btn');
        if (tabBtn) {
          const mode = tabBtn.getAttribute('data-mode');
          const id = tabBtn.getAttribute('data-id');
          if (!id || !mode) return;

          const vitrineView = document.getElementById(`view-vitrine-${id}`);
          const blueprintView = document.getElementById(`view-blueprint-${id}`);
          const card = tabBtn.closest('.project-card');

          if (card) {
            const tabs = card.querySelectorAll('.plaque-tab-btn');
            tabs.forEach((t) => {
              t.classList.remove('bg-ink', 'text-paper', 'border-ink');
              t.classList.add('bg-surface', 'text-ink-soft', 'border-rule');
              t.setAttribute('aria-selected', 'false');
            });
            tabBtn.classList.add('bg-ink', 'text-paper', 'border-ink');
            tabBtn.classList.remove('bg-surface', 'text-ink-soft', 'border-rule');
            tabBtn.setAttribute('aria-selected', 'true');
          }

          if (mode === 'vitrine') {
            if (vitrineView) vitrineView.classList.remove('hidden');
            if (blueprintView) blueprintView.classList.add('hidden');
          } else {
            if (vitrineView) vitrineView.classList.add('hidden');
            if (blueprintView) blueprintView.classList.remove('hidden');
          }

          if (metroSound.isEnabled()) {
            metroSound.beep();
          }
        }
      });
    });
  </script>
</BaseLayout>
