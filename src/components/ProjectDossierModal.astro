---
// src/components/ProjectDossierModal.astro
// High-Craft Focused Transit Inspection Dossier Lightbox for ST-03 Projects
import { PROJECTS } from '../data/portfolio';
import Pictograms from './Pictograms.astro';
import LineChip from './LineChip.astro';

const PROJECT_IMAGES: Record<string, string> = {
  geobus: '/images/Geobus.jpg',
  grantpilot: '/images/Grantpilot.jpg',
  datamorfix: '/images/DataMorfix.png',
  ecosortx: '/images/EcosortX.png',
  ems: '/images/EMS.png',
  clinic: '/images/clinic.png',
  cricktraker: '/images/cricktraker.jpeg',
};
---

<div
  id="project-dossier-modal"
  class="fixed inset-0 z-[100] bg-ink/75 flex items-center justify-center p-4 sm:p-6 select-none"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="dossier-title"
>
  <div class="ticket ticket-notched p-6 sm:p-8 bg-surface border-4 border-ink shadow-[8px_8px_0_var(--ink)] max-w-2xl w-full max-h-[92vh] overflow-y-auto">
    <!-- Header Bar -->
    <div class="flex items-center justify-between border-b-2 border-ink pb-3 mb-5">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-line-frontend animate-pulse"></span>
        <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
          ST-03 // TRANSIT SPECIFICATION DOSSIER
        </span>
      </div>
      <button
        type="button"
        id="close-dossier-btn"
        class="w-8 h-8 border-2 border-ink bg-paper text-ink font-mono font-bold text-sm hover:bg-ink hover:text-paper transition-colors shadow-[2px_2px_0_var(--ink)]"
        aria-label="Close Dossier"
      >
        ✕
      </button>
    </div>

    <!-- Dynamic Content Area -->
    <div id="dossier-content" class="space-y-4">
      <!-- Title & Header -->
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 id="dossier-title" class="font-archivo text-2xl sm:text-3xl font-black text-ink">
            Project Title
          </h3>
          <p id="dossier-tagline" class="font-mono text-xs text-line-frontend font-bold uppercase tracking-wider mt-1">
            Tagline
          </p>
        </div>
        <div id="dossier-grant-badge" class="hidden text-right flex-shrink-0">
          <span class="font-mono text-[9px] text-ink-soft uppercase block font-bold">GRANT FARE</span>
          <span id="dossier-grant-text" class="font-mono text-xs font-bold text-ink bg-line-hardware/30 px-2 py-0.5 border border-line-hardware inline-block shadow-[1px_1px_0_var(--ink)]">
            ₹30,000 SSIP Grant
          </span>
        </div>
      </div>

      <!-- Screenshot Vitrine -->
      <div class="border-2 border-ink bg-paper p-1.5 shadow-[4px_4px_0_var(--ink)] overflow-hidden">
        <div class="relative w-full aspect-[16/9] overflow-hidden bg-black/10">
          <img
            id="dossier-image"
            src=""
            alt="Project Screenshot"
            class="w-full h-full object-cover filter contrast-105"
          />
          <div class="absolute bottom-2 left-2 px-2 py-0.5 bg-black/85 font-mono text-[10px] text-line-hardware font-bold uppercase tracking-wider">
            PRODUCTION VERIFIED SYSTEM
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="p-4 bg-paper border border-rule">
        <div class="font-mono text-[10px] text-ink-soft uppercase tracking-wider mb-1 font-bold">
          // ARCHITECTURAL OVERVIEW & PURPOSE:
        </div>
        <p id="dossier-description" class="font-manrope text-sm sm:text-base text-ink leading-relaxed">
          Description
        </p>
      </div>

      <!-- Tech Stack -->
      <div>
        <div class="font-mono text-[10px] text-ink-soft uppercase tracking-wider mb-2 font-bold">
          // ENGINEERING STACK & MODULES:
        </div>
        <div id="dossier-tech-chips" class="flex flex-wrap gap-1.5 font-mono text-xs font-bold text-ink">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-rule mt-5">
        <div class="flex items-center gap-3">
          <a
            id="dossier-live-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-ink text-paper border-2 border-ink font-mono text-xs font-bold uppercase tracking-wider hover:bg-surface hover:text-ink transition-colors shadow-[2px_2px_0_var(--paper)] inline-flex items-center gap-1.5"
          >
            <span>Visit Live Platform</span>
            <span aria-hidden="true">➔</span>
          </a>

          <a
            id="dossier-repo-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-2 bg-paper text-ink border-2 border-ink font-mono text-xs font-bold uppercase tracking-wider hover:bg-surface transition-colors shadow-[2px_2px_0_var(--ink)] inline-flex items-center gap-1"
          >
            <span>GitHub Repository</span>
            <span aria-hidden="true">➔</span>
          </a>
        </div>

        <button
          type="button"
          id="dossier-done-btn"
          class="px-3.5 py-1.5 font-mono text-xs font-bold uppercase text-ink-soft hover:text-ink border border-rule hover:border-ink transition-colors"
        >
          Close (ESC)
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { PROJECTS } from '../data/portfolio';

  const PROJECT_IMAGES: Record<string, string> = {
    geobus: '/images/Geobus.jpg',
    grantpilot: '/images/Grantpilot.jpg',
    datamorfix: '/images/DataMorfix.png',
    ecosortx: '/images/EcosortX.png',
    ems: '/images/EMS.png',
    clinic: '/images/clinic.png',
    cricktraker: '/images/cricktraker.jpeg',
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('project-dossier-modal');
    const closeBtn = document.getElementById('close-dossier-btn');
    const doneBtn = document.getElementById('dossier-done-btn');

    const titleEl = document.getElementById('dossier-title');
    const taglineEl = document.getElementById('dossier-tagline');
    const descEl = document.getElementById('dossier-description');
    const imageEl = document.getElementById('dossier-image') as HTMLImageElement;
    const grantBadge = document.getElementById('dossier-grant-badge');
    const grantText = document.getElementById('dossier-grant-text');
    const techChips = document.getElementById('dossier-tech-chips');
    const liveBtn = document.getElementById('dossier-live-btn') as HTMLAnchorElement;
    const repoBtn = document.getElementById('dossier-repo-btn') as HTMLAnchorElement;

    const openDossier = (projectId: string) => {
      const proj = PROJECTS.find((p) => p.id === projectId);
      if (!proj || !modal) return;

      if (titleEl) titleEl.textContent = proj.title;
      if (taglineEl) taglineEl.textContent = proj.tagline;
      if (descEl) descEl.textContent = proj.description;

      const imgPath = PROJECT_IMAGES[proj.id];
      if (imageEl) {
        if (imgPath) {
          imageEl.src = imgPath;
          imageEl.style.display = 'block';
        } else {
          imageEl.style.display = 'none';
        }
      }

      if (grantBadge && grantText) {
        if (proj.grantAmount) {
          grantText.textContent = proj.grantAmount;
          grantBadge.classList.remove('hidden');
        } else {
          grantBadge.classList.add('hidden');
        }
      }

      if (techChips) {
        techChips.innerHTML = '';
        proj.techStack.forEach((t) => {
          const chip = document.createElement('span');
          chip.className = 'px-2.5 py-1 bg-surface border border-ink text-ink shadow-[1px_1px_0_var(--ink)] uppercase';
          chip.textContent = t;
          techChips.appendChild(chip);
        });
      }

      if (liveBtn) {
        if (proj.liveUrl && !proj.liveUrl.startsWith('TODO')) {
          liveBtn.href = proj.liveUrl;
          liveBtn.classList.remove('hidden');
        } else {
          liveBtn.classList.add('hidden');
        }
      }

      if (repoBtn) {
        if (proj.repoUrl && !proj.repoUrl.startsWith('TODO')) {
          repoBtn.href = proj.repoUrl;
          repoBtn.classList.remove('hidden');
        } else {
          repoBtn.classList.add('hidden');
        }
      }

      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      // Audio feedback
      if ((window as any).__yugsound?.isEnabled()) {
        (window as any).__yugsound.gateGreen();
      }

      closeBtn?.focus();
    };

    const closeDossier = () => {
      if (!modal) return;
      modal.style.display = 'none';
      document.body.style.overflow = '';

      if ((window as any).__yugsound?.isEnabled()) {
        (window as any).__yugsound.beep();
      }
    };

    closeBtn?.addEventListener('click', closeDossier);
    doneBtn?.addEventListener('click', closeDossier);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeDossier();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.style.display === 'flex') {
        closeDossier();
      }
    });

    // Delegate click on any trigger
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.project-lightbox-trigger');
      if (trigger) {
        const id = trigger.getAttribute('data-project-id');
        if (id) {
          e.preventDefault();
          openDossier(id);
        }
      }
    });
  });
</script>
