---
interface Props {
  name: string;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'route' && (
    <!-- Ghumify: Route / Compass -->
    <path d="M4 19a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 0h8a4 4 0 0 0 4-4V7M20 5l-4-4-4 4m4-4v10" />
  )}
  {name === 'bus' && (
    <!-- GeoBus: Bus -->
    <path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6zm0 5h16M7 15h.01M17 15h.01M6 18v2M18 18v2" />
  )}
  {name === 'rupee-document' && (
    <!-- Grantpilot: Rupee-document -->
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 11h6M9 14h4M9 11a2.5 2.5 0 0 1 2.5 2.5L9 18" />
  )}
  {name === 'cricket' && (
    <!-- Cricktraker: Bat and Ball -->
    <path d="m14 10 7-7a2 2 0 0 1 3 3l-7 7M9 15l-6 6a1.5 1.5 0 0 1-2-2l6-6M8 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
  )}
  {name === 'clinic' && (
    <!-- Clinic: Medical Cross -->
    <path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z" />
  )}
  {name === 'bin' && (
    <!-- EcoSortX: Recycling bin -->
    <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m5 5v6m4-6v6" />
  )}
  {name === 'table-grid' && (
    <!-- DataMorphix: Table / Grid -->
    <path d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18M15 3v18" />
  )}
  {name === 'exam' && (
    <!-- EMS: Exam paper -->
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h4M8 9h1" />
  )}
  {name === 'book' && (
    <!-- Education: Book -->
    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15z" />
  )}
  {name === 'briefcase' && (
    <!-- Experience: Briefcase -->
    <path d="M4 7h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2zm4 0V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M12 12v2" />
  )}
  {name === 'arrow-up-right' && (
    <path d="M7 17L17 7M7 7h10v10" />
  )}
</svg>
