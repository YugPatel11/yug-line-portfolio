---
// InterchangeGhumify.astro
// Signature 4-Line Interchange Hub with Interactive Convergence & Mobile Device Showcase
import Pictograms from './Pictograms.astro';

const TECH_ITEMS = [
  { name: 'Flutter', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'Dart', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'Next.js 15', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'TypeScript', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'Gemini AI', line: 'ai', color: 'var(--line-ai)' },
  { name: 'Groq Llama', line: 'ai', color: 'var(--line-ai)' },
  { name: 'Firebase', line: 'backend', color: 'var(--line-backend)' },
  { name: 'OpenStreetMap', line: 'hardware', color: 'var(--line-hardware)' },
  { name: 'SQLite Caching', line: 'backend', color: 'var(--line-backend)' },
];

const SCREENSHOT_TABS = [
  { id: 'app', title: '01. Live Interface', src: '/images/ghumify.png', caption: 'Interactive Itinerary Companion with Dynamic Halts' },
  { id: 'arch', title: '02. Architecture', src: '/images/ghumify_architecture.png', caption: '4-Tier System Engine & AI Fallback Pipeline' },
  { id: 'val', title: '03. Validation', src: '/images/ghumify_validation.png', caption: 'Offline POI Evaluation & Emergency SOS Matrix' },
  { id: 'adv', title: '04. Advantage', src: '/images/ghumify_advantage.png', caption: 'Ground Reality Benchmarks vs Generic AI Models' },
];
---

<div class="ticket p-6 md:p-10 border-4 border-ink shadow-[8px_8px_0_var(--ink)] bg-surface relative select-none" id="ghumify-interchange">
  <!-- Interchange Gantry Banner (AI Blue + Frontend Orange convergence) -->
  <div class="mb-6 p-4 bg-paper border-2 border-ink flex flex-wrap items-center justify-between gap-4 shadow-[4px_4px_0_var(--ink)]">
    <div class="flex items-center gap-3">
      <div class="flex -space-x-1.5" aria-hidden="true">
        <span class="w-5 h-5 rounded-full bg-line-ai border-2 border-ink"></span>
        <span class="w-5 h-5 rounded-full bg-line-frontend border-2 border-ink"></span>
        <span class="w-5 h-5 rounded-full bg-line-backend border-2 border-ink"></span>
        <span class="w-5 h-5 rounded-full bg-line-hardware border-2 border-ink"></span>
      </div>
      <div>
        <span class="font-mono text-[10px] font-black uppercase tracking-widest text-ink-soft block">
          CENTRAL INTERCHANGE JUNCTION // 4 TRACKS
        </span>
        <span class="font-archivo text-base sm:text-lg font-black text-ink uppercase tracking-tight">
          PLATFORM 2A (AI LINE) ⇄ PLATFORM 2B (FRONTEND LINE)
        </span>
      </div>
    </div>

    <!-- Live Telemetry Badges -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span class="px-2.5 py-1 bg-surface border border-ink font-bold text-ink inline-flex items-center gap-1.5 shadow-[2px_2px_0_var(--ink)]">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        ₹1.85L SSIP Grant
      </span>
      <span class="px-2.5 py-1 bg-surface border border-rule text-ink font-bold">
        SIH 2026 Winner
      </span>
      <span class="px-2.5 py-1 bg-surface border border-rule text-ink">
        509K+ BharatPOI
      </span>
    </div>
  </div>

  <!-- Top Interchange Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-ink pb-4 mb-6">
    <div class="flex items-center gap-3">
      <span class="w-4 h-4 rounded-full border-4 border-ink bg-line-frontend"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
        MAJOR INTERCHANGE // 4-LINE CONVERGENCE
      </span>
    </div>
    <span class="status-tag status-tag--winner">
      FLAGSHIP AI PROJECT
    </span>
  </div>

  <!-- Main Headline & Tagline -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-8">
    <div class="lg:col-span-8">
      <div class="flex items-center gap-3 mb-2">
        <img src="/images/ghumify_logo.png" alt="Ghumify Logo" class="w-10 h-10 border-2 border-ink bg-paper p-1 shadow-[2px_2px_0_var(--ink)]" />
        <h3 class="font-archivo text-3xl md:text-5xl font-extrabold text-ink tracking-tight">
          GHUMIFY
        </h3>
      </div>
      <p class="font-mono text-sm md:text-base text-line-frontend font-bold uppercase tracking-wider mb-4">
        AI-Powered Time-Bound Travel Planner & Ground Companion
      </p>
      <p class="font-manrope text-base md:text-lg text-ink leading-relaxed">
        Ghumify creates personalized, time-bound travel itineraries tailored to destination, available hours, party age group, pacing, and preferences. Unlike generic planners, it handles real-world ground conditions with offline intelligence, multi-lingual navigation, crowd prediction, and emergency routing.
      </p>
    </div>

    <!-- Inputs & Specifications Matrix -->
    <div class="lg:col-span-4 bg-paper border-2 border-ink p-4 font-mono text-xs shadow-[4px_4px_0_var(--ink)]">
      <div class="font-bold border-b border-rule pb-2 mb-3 text-ink uppercase tracking-wider flex items-center justify-between">
        <span>// Dynamic Input Vector</span>
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      </div>
      <ul class="space-y-1.5 text-ink-soft">
        <li><strong class="text-ink">Destination:</strong> Tier 1-3 Indian Cities</li>
        <li><strong class="text-ink">Time Anchor:</strong> 4h to multi-day slots</li>
        <li><strong class="text-ink">Budget Tier:</strong> Integer-paise settlement</li>
        <li><strong class="text-ink">Party Age:</strong> Family, elderly, solo</li>
        <li><strong class="text-ink">Interests:</strong> Heritage, food, nature</li>
      </ul>
    </div>
  </div>

  <!-- SIGNATURE SHOWCASE: CSS/SVG Phone Mockup + Multi-Screen Vitrine (Section 5) -->
  <div class="mb-8 border-4 border-ink p-6 bg-paper shadow-[6px_6px_0_var(--ink)]">
    <!-- Gallery Screen Navigation Tabs -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-ink pb-4 mb-6">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-line-hardware"></span>
        <span class="font-mono text-xs font-black uppercase tracking-wider text-ink">
          PRODUCTION SHOWCASE // VERIFIED SCREENS
        </span>
      </div>

      <!-- Tab Buttons -->
      <div class="flex flex-wrap gap-1.5" role="tablist">
        {SCREENSHOT_TABS.map((tab, idx) => (
          <button
            type="button"
            class={`ghumify-tab-btn px-3 py-1.5 font-mono text-xs font-bold uppercase transition-all border-2 border-ink cursor-pointer ${
              idx === 0
                ? 'bg-line-hardware text-ink shadow-[2px_2px_0_var(--ink)] active-tab'
                : 'bg-surface text-ink-soft hover:text-ink'
            }`}
            data-tab={tab.id}
            data-img={tab.src}
            data-caption={tab.caption}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {tab.title}
          </button>
        ))}
      </div>
    </div>

    <!-- Phone Showcase & Schematic Display Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- CSS/SVG Smartphone Device Mockup (Left 5 cols) -->
      <div class="lg:col-span-5 flex justify-center">
        <!-- Physical Phone Chassis -->
        <div class="relative w-[280px] sm:w-[300px] h-[540px] sm:h-[580px] bg-[#12141A] rounded-[40px] border-4 border-ink shadow-[8px_8px_0_var(--ink)] p-3 flex flex-col justify-between overflow-hidden">
          
          <!-- Top Speaker Grill & Camera Notch -->
          <div class="absolute top-4 left-1/2 -translate-x-1/2 w-28 h-5 bg-[#1C202B] rounded-full border border-black flex items-center justify-center gap-2 z-30">
            <span class="w-2.5 h-2.5 rounded-full bg-[#0D0F14] border border-black"></span>
            <span class="w-10 h-1 bg-[#0D0F14] rounded-full"></span>
          </div>

          <!-- Glass Screen Container -->
          <div class="relative w-full h-full bg-black rounded-[30px] overflow-hidden border-2 border-[#2A2E3A] flex flex-col">
            <!-- Simulated Screen Image with Live Switcher -->
            <img
              id="ghumify-showcase-img"
              src="/images/ghumify.png"
              alt="Ghumify Mobile Interface"
              class="w-full h-full object-cover transition-opacity duration-300"
            />

            <!-- Animated Route Overlay on Map Screen -->
            <svg
              id="ghumify-route-animation"
              class="absolute inset-0 w-full h-full pointer-events-none z-20"
              viewBox="0 0 300 580"
              xmlns="http://www.w3.org/2000/svg"
            >
              <!-- Animated Route Path -->
              <path
                d="M 60 180 Q 150 240 220 280 T 140 420"
                fill="none"
                stroke="#E4572E"
                stroke-width="5"
                stroke-linecap="round"
                stroke-dasharray="8 6"
                class="route-dash-animate"
              />
              <!-- Waypoint Stops -->
              <circle cx="60" cy="180" r="7" fill="#FFC933" stroke="#111111" stroke-width="2" />
              <circle cx="220" cy="280" r="7" fill="#1B3A8A" stroke="#111111" stroke-width="2" />
              <circle cx="140" cy="420" r="8" fill="#0B6E4F" stroke="#FFFFFF" stroke-width="2.5" />
            </svg>
          </div>

          <!-- Home Indicator Bar -->
          <div class="w-24 h-1 bg-white/40 rounded-full mx-auto my-1 z-30"></div>
        </div>
      </div>

      <!-- Feature Specs & Caption Description (Right 7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="p-4 bg-surface border-2 border-ink shadow-[4px_4px_0_var(--ink)]">
          <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-line-frontend block mb-1">
            ACTIVE SCREEN INSPECTION
          </span>
          <h4 id="ghumify-tab-caption" class="font-archivo text-xl sm:text-2xl font-black text-ink uppercase tracking-tight mb-2">
            Interactive Itinerary Companion with Dynamic Halts
          </h4>
          <p class="font-manrope text-sm text-ink-soft leading-relaxed">
            Real-time itinerary generated in under 3 seconds using dual Gemini AI + Groq Llama inference engines. Automatically reconciles POI operating hours, crowd congestion forecasts, and multi-lingual transport connections.
          </p>
        </div>

        <!-- 6 Differentiators Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs">
          <div class="p-3 bg-surface border border-rule">
            <span class="font-bold text-ink block mb-0.5">⚡ &lt;3s Generation</span>
            <span class="text-ink-soft text-[11px]">Instant synthesis with multi-provider AI fallback.</span>
          </div>
          <div class="p-3 bg-surface border border-rule">
            <span class="font-bold text-ink block mb-0.5">📶 Offline Mode</span>
            <span class="text-ink-soft text-[11px]">509K+ BharatPOI dataset for zero-network zones.</span>
          </div>
          <div class="p-3 bg-surface border border-rule">
            <span class="font-bold text-ink block mb-0.5">🗣️ 10 Languages</span>
            <span class="text-ink-soft text-[11px]">Built-in Indian language assistance.</span>
          </div>
          <div class="p-3 bg-surface border border-rule">
            <span class="font-bold text-ink block mb-0.5">🚨 Emergency SOS</span>
            <span class="text-ink-soft text-[11px]">1-touch Overpass discovery for hospitals & police.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech Convergence Chips (Interactive Line Highlight) -->
  <div class="mb-8 border-t-2 border-b-2 border-ink py-4 bg-paper px-4">
    <div class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3 font-bold">
      // Converging Technologies (Hover or click to highlight transit track)
    </div>
    <div class="flex flex-wrap gap-2" id="tech-chips-group">
      {TECH_ITEMS.map((item) => (
        <button
          type="button"
          class="tech-interactive-chip inline-flex items-center gap-2 px-3 py-1.5 border-2 border-rule bg-surface font-mono text-xs text-ink uppercase tracking-wider cursor-pointer hover:border-ink hover:scale-105 active:scale-95 transition-all shadow-[2px_2px_0_var(--ink)]"
          data-line={item.line}
        >
          <span class="w-2.5 h-2.5 rounded-full border border-ink" style={`background-color: ${item.color};`}></span>
          <span>{item.name}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Visual Convergence Line SVG Diagram -->
  <div class="mb-8 bg-paper p-4 border-2 border-ink shadow-[4px_4px_0_var(--ink)] overflow-hidden">
    <div class="font-mono text-xs text-ink-soft uppercase mb-2 flex items-center justify-between font-bold">
      <span>// Track Merging Junction</span>
      <span class="text-line-frontend font-black">4 LINES CONVERGING HERE</span>
    </div>
    <svg viewBox="0 0 600 60" class="w-full h-14" xmlns="http://www.w3.org/2000/svg">
      <path id="track-frontend" d="M 10 10 L 200 10 L 260 30 L 590 30" stroke="var(--line-frontend)" stroke-width="4" fill="none" class="transition-all duration-300" />
      <path id="track-backend" d="M 10 24 L 210 24 L 260 30 L 590 30" stroke="var(--line-backend)" stroke-width="4" fill="none" class="transition-all duration-300" />
      <path id="track-ai" d="M 10 36 L 210 36 L 260 30 L 590 30" stroke="var(--line-ai)" stroke-width="4" fill="none" class="transition-all duration-300" />
      <path id="track-hardware" d="M 10 50 L 200 50 L 260 30 L 590 30" stroke="var(--line-hardware)" stroke-width="4" fill="none" class="transition-all duration-300" />
      
      <!-- Central Junction Station Hub -->
      <circle cx="260" cy="30" r="10" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
      <circle cx="260" cy="30" r="5" fill="var(--line-frontend)" />
    </svg>
  </div>
</div>

<style>
  @keyframes routeDash {
    to { stroke-dashoffset: -32; }
  }

  .route-dash-animate {
    animation: routeDash 1.2s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .route-dash-animate {
      animation: none !important;
    }
  }
</style>

<script>
  import { sound } from '../scripts/sound';

  // Screenshot Tab Switcher
  const tabs = document.querySelectorAll('.ghumify-tab-btn');
  const showcaseImg = document.getElementById('ghumify-showcase-img') as HTMLImageElement | null;
  const captionEl = document.getElementById('ghumify-tab-caption');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      sound.doorDing();
      const imgPath = tab.getAttribute('data-img');
      const caption = tab.getAttribute('data-caption');

      tabs.forEach((t) => {
        t.classList.remove('bg-line-hardware', 'shadow-[2px_2px_0_var(--ink)]', 'active-tab');
        t.classList.add('bg-surface', 'text-ink-soft');
        t.setAttribute('aria-selected', 'false');
      });

      tab.classList.add('bg-line-hardware', 'shadow-[2px_2px_0_var(--ink)]', 'active-tab');
      tab.classList.remove('bg-surface', 'text-ink-soft');
      tab.setAttribute('aria-selected', 'true');

      if (showcaseImg && imgPath) {
        showcaseImg.style.opacity = '0.3';
        setTimeout(() => {
          showcaseImg.src = imgPath;
          showcaseImg.style.opacity = '1';
        }, 150);
      }

      if (captionEl && caption) {
        captionEl.textContent = caption;
      }
    });
  });

  // Tech interactive chips: light tracks and sound feedback
  const chips = document.querySelectorAll('.tech-interactive-chip');
  chips.forEach((chip) => {
    chip.addEventListener('mouseenter', () => {
      const line = chip.getAttribute('data-line');
      const track = document.getElementById(`track-${line}`);
      if (track) {
        track.setAttribute('stroke-width', '8');
      }
    });
    chip.addEventListener('mouseleave', () => {
      const line = chip.getAttribute('data-line');
      const track = document.getElementById(`track-${line}`);
      if (track) {
        track.setAttribute('stroke-width', '4');
      }
    });
    chip.addEventListener('click', () => {
      sound.beep();
      const line = chip.getAttribute('data-line');
      const track = document.getElementById(`track-${line}`);
      if (track) {
        track.setAttribute('stroke-width', '10');
        setTimeout(() => track.setAttribute('stroke-width', '4'), 600);
      }
    });
  });
</script>
