---
import Pictograms from './Pictograms.astro';

const TECH_ITEMS = [
  { name: 'Flutter', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'Dart', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'Next.js 15', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'TypeScript', line: 'frontend', color: 'var(--line-frontend)' },
  { name: 'Gemini AI', line: 'ai', color: 'var(--line-ai)' },
  { name: 'Groq Llama', line: 'ai', color: 'var(--line-ai)' },
  { name: 'Firebase', line: 'backend', color: 'var(--line-backend)' },
  { name: 'OpenStreetMap', line: 'hardware', color: 'var(--line-hardware)' },
  { name: 'SQLite Caching', line: 'backend', color: 'var(--line-backend)' },
];
---

<div class="ticket p-6 md:p-10 border-2 border-ink shadow-[8px_8px_0_var(--ink)] bg-surface relative" id="ghumify-interchange">
  <!-- Top Interchange Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-ink pb-4 mb-6">
    <div class="flex items-center gap-3">
      <span class="w-4 h-4 rounded-full border-4 border-ink bg-line-frontend"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
        MAJOR INTERCHANGE // 4-LINE CONVERGENCE
      </span>
    </div>
    <span class="status-tag status-tag--winner">
      FLAGSHIP AI PROJECT
    </span>
  </div>

  <!-- Main Headline & Tagline -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-8">
    <div class="lg:col-span-8">
      <div class="flex items-center gap-3 mb-2">
        <Pictograms name="route" size={32} class="text-line-frontend" />
        <h3 class="font-archivo text-3xl md:text-5xl font-extrabold text-ink tracking-tight">
          GHUMIFY
        </h3>
      </div>
      <p class="font-mono text-sm md:text-base text-ink-soft uppercase tracking-wider mb-4">
        AI-Powered Time-Bound Travel Planner & Ground Companion
      </p>
      <p class="font-manrope text-base md:text-lg text-ink leading-relaxed">
        Ghumify creates personalized, time-bound travel itineraries tailored to destination, available hours, party age group, pacing, and preferences. Unlike generic planners, it handles real-world ground conditions with offline intelligence, multi-lingual navigation, crowd prediction, and emergency routing.
      </p>
    </div>

    <!-- Inputs & Specifications Matrix -->
    <div class="lg:col-span-4 bg-paper border-2 border-ink p-4 font-mono text-xs">
      <div class="font-bold border-b border-rule pb-2 mb-3 text-ink uppercase tracking-wider">
        // Dynamic Input Vector
      </div>
      <ul class="space-y-1.5 text-ink-soft">
        <li><strong class="text-ink">Destination:</strong> Tier 1-3 Indian Cities</li>
        <li><strong class="text-ink">Time Anchor:</strong> 4h to multi-day slots</li>
        <li><strong class="text-ink">Budget Tier:</strong> Integer-paise settlement</li>
        <li><strong class="text-ink">Party Age:</strong> Family, elderly, solo</li>
        <li><strong class="text-ink">Interests:</strong> Heritage, food, nature</li>
      </ul>
    </div>
  </div>

  <!-- Differentiators Grid -->
  <div class="mb-8">
    <div class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3">
      // Ground Reality Differentiators
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <div class="p-3.5 bg-paper border border-rule">
        <div class="font-mono font-bold text-xs uppercase text-ink mb-1">⚡ &lt;3s Generation</div>
        <p class="text-xs text-ink-soft">Instant itinerary synthesis with multi-provider AI fallback (Gemini & Groq).</p>
      </div>
      <div class="p-3.5 bg-paper border border-rule">
        <div class="font-mono font-bold text-xs uppercase text-ink mb-1">📶 Offline Planning</div>
        <p class="text-xs text-ink-soft">Deterministic rule engine + 509K+ BharatPOI dataset for zero-network zones.</p>
      </div>
      <div class="p-3.5 bg-paper border border-rule">
        <div class="font-mono font-bold text-xs uppercase text-ink mb-1">🗣️ 10 Indian Languages</div>
        <p class="text-xs text-ink-soft">Built-in two-way translation for seamless local navigation across states.</p>
      </div>
      <div class="p-3.5 bg-paper border border-rule">
        <div class="font-mono font-bold text-xs uppercase text-ink mb-1">👥 Crowd Intelligence</div>
        <p class="text-xs text-ink-soft">Predicts peak congestion hours and suggests calmer off-peak slots dynamically.</p>
      </div>
      <div class="p-3.5 bg-paper border border-rule">
        <div class="font-mono font-bold text-xs uppercase text-ink mb-1">🧭 Smart Routing</div>
        <p class="text-xs text-ink-soft">Haversine loop-free sequencing with anchored food and rest halts.</p>
      </div>
      <div class="p-3.5 bg-paper border border-rule">
        <div class="font-mono font-bold text-xs uppercase text-ink mb-1">🚨 Emergency SOS</div>
        <p class="text-xs text-ink-soft">1-touch emergency dialing and OSM Overpass discovery for nearby hospitals.</p>
      </div>
    </div>
  </div>

  <!-- Tech Convergence Chips (Interactive Line Highlight) -->
  <div class="mb-8 border-t border-b border-rule py-4">
    <div class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3">
      // Converging Technologies (Hover to highlight line)
    </div>
    <div class="flex flex-wrap gap-2" id="tech-chips-group">
      {TECH_ITEMS.map((item) => (
        <span
          class="tech-interactive-chip inline-flex items-center gap-1.5 px-3 py-1.5 border border-rule bg-paper font-mono text-xs text-ink uppercase tracking-wider cursor-pointer hover:border-ink transition-colors"
          data-line={item.line}
        >
          <span class="w-2 h-2 rounded-full" style={`background-color: ${item.color};`}></span>
          <span>{item.name}</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Visual Convergence Line SVG Diagram -->
  <div class="mb-8 bg-paper p-4 border border-rule overflow-hidden">
    <div class="font-mono text-[11px] text-ink-soft uppercase mb-2">
      // Track Merging Junction
    </div>
    <svg viewBox="0 0 600 60" class="w-full h-12" xmlns="http://www.w3.org/2000/svg">
      <path id="track-frontend" d="M 10 10 L 200 10 L 260 30 L 590 30" stroke="var(--line-frontend)" stroke-width="4" fill="none" />
      <path id="track-backend" d="M 10 24 L 210 24 L 260 30 L 590 30" stroke="var(--line-backend)" stroke-width="4" fill="none" />
      <path id="track-ai" d="M 10 36 L 210 36 L 260 30 L 590 30" stroke="var(--line-ai)" stroke-width="4" fill="none" />
      <path id="track-hardware" d="M 10 50 L 200 50 L 260 30 L 590 30" stroke="var(--line-hardware)" stroke-width="4" fill="none" />
      <!-- Central Junction Station Dot -->
      <circle cx="260" cy="30" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
      <circle cx="260" cy="30" r="4" fill="var(--ink)" />
    </svg>
  </div>

  <!-- Mandatory TODO-USER Slots per brief A7 -->
  <div class="p-4 bg-paper border border-dashed border-rule text-xs font-mono space-y-2 mb-6">
    <div class="font-bold text-ink uppercase tracking-wider">// Verification & Media Placeholders (TODO-USER):</div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-ink-soft">
      <div>• [TODO-USER: Add Ghumify Demo Video Embed / Link]</div>
      <div>• [TODO-USER: Add 3 High-Res Screenshots in public/images/]</div>
      <div>• [TODO-USER: Add Public GitHub Repository Link]</div>
      <div>• [TODO-USER: Add Live Deployment / Production URL]</div>
      <div class="md:col-span-2">• [TODO-USER: Add One Real Measured Metric / User Count / Pilot Feedback]</div>
    </div>
  </div>

  <!-- Project Action Buttons -->
  <div class="flex flex-wrap items-center gap-4">
    <button
      type="button"
      id="open-ghumify-brief"
      class="btn-stub"
    >
      <span>Open Full System Specs</span>
      <Pictograms name="arrow-up-right" size={14} />
    </button>
  </div>
</div>

<script>
  // Highlighting matching line on tech chip hover
  document.addEventListener('DOMContentLoaded', () => {
    const chips = document.querySelectorAll('.tech-interactive-chip');
    chips.forEach(chip => {
      chip.addEventListener('mouseenter', () => {
        const line = chip.getAttribute('data-line');
        const track = document.getElementById(`track-${line}`);
        if (track) {
          track.setAttribute('stroke-width', '8');
        }
      });
      chip.addEventListener('mouseleave', () => {
        const line = chip.getAttribute('data-line');
        const track = document.getElementById(`track-${line}`);
        if (track) {
          track.setAttribute('stroke-width', '4');
        }
      });
    });
  });
</script>
