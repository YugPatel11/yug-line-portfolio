---
import Pictograms from './Pictograms.astro';
---

<div class="ticket p-6 md:p-8 bg-surface border-2 border-ink shadow-[6px_6px_0_var(--ink)] mt-8" id="fare-gate-station">
  <div class="flex items-center justify-between border-b-2 border-ink pb-4 mb-6">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-line-frontend"></span>
      <h3 class="font-archivo text-xl font-bold text-ink uppercase tracking-tight">
        FARE GATE 01 // VALIDATION BARRIER
      </h3>
    </div>
    <div class="flex items-center gap-2">
      <!-- LED Indicator Lights (Flat colors per Section 4) -->
      <span id="gate-led-red" class="w-3.5 h-3.5 rounded-full border-2 border-ink bg-[#D8362B]" title="Gate Closed"></span>
      <span id="gate-led-green" class="w-3.5 h-3.5 rounded-full border-2 border-ink bg-paper opacity-30" title="Gate Open"></span>
      <span class="font-mono text-xs font-bold uppercase text-ink-soft ml-1" id="gate-status-text">
        LOCKED
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <!-- Ticket Collector Flat SVG Figure & Speech Bubble -->
    <div class="md:col-span-5 flex flex-col items-center text-center p-4 bg-paper border border-rule">
      <!-- Speech Bubble -->
      <div
        id="collector-speech-bubble"
        class="ticket p-3 mb-4 bg-surface border-2 border-ink font-mono text-xs text-ink font-bold max-w-xs relative text-left"
        role="status"
        aria-live="polite"
      >
        "Ticket, please."
      </div>

      <!-- Flat 2D SVG Ticket Collector Character (Cap, badge, jacket, clipboard) -->
      <svg viewBox="0 0 140 180" class="w-32 h-44 select-none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Body / Coat -->
        <rect x="35" y="70" width="70" height="95" fill="var(--ink)" rx="4" />
        <!-- Shirt Collar -->
        <polygon points="70,70 55,95 85,95" fill="var(--paper)" />
        <line x1="70" y1="95" x2="70" y2="165" stroke="var(--paper)" stroke-width="2" />

        <!-- Lapel & Badge -->
        <circle cx="85" cy="110" r="5" fill="var(--line-hardware)" stroke="var(--ink)" stroke-width="1.5" />

        <!-- Head -->
        <circle cx="70" cy="45" r="20" fill="var(--surface)" stroke="var(--ink)" stroke-width="2.5" />
        
        <!-- Eyes & Glasses -->
        <circle cx="63" cy="43" r="3.5" fill="none" stroke="var(--ink)" stroke-width="2" />
        <circle cx="77" cy="43" r="3.5" fill="none" stroke="var(--ink)" stroke-width="2" />
        <line x1="66.5" y1="43" x2="73.5" y2="43" stroke="var(--ink)" stroke-width="2" />

        <!-- Station Master Cap -->
        <path d="M 45 35 Q 70 20 95 35 Z" fill="var(--ink)" />
        <rect x="42" y="33" width="56" height="6" fill="var(--ink)" rx="1" />
        <circle cx="70" cy="28" r="4" fill="var(--line-frontend)" stroke="var(--ink)" stroke-width="1" />

        <!-- Clipboard in hand -->
        <rect x="20" y="115" width="28" height="40" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" rx="2" />
        <line x1="26" y1="125" x2="42" y2="125" stroke="var(--ink)" stroke-width="2" />
        <line x1="26" y1="135" x2="38" y2="135" stroke="var(--ink)" stroke-width="2" />
        <line x1="26" y1="145" x2="42" y2="145" stroke="var(--ink)" stroke-width="2" />
      </svg>
      <span class="font-mono text-[10px] text-ink-soft uppercase tracking-wider mt-2">
        STATION SUPERINTENDENT // GATE 01
      </span>
    </div>

    <!-- Fare Barrier Mechanism (Pillar, Slot, Pivoting Barrier Arms) -->
    <div class="md:col-span-7 flex flex-col justify-between">
      <div class="p-6 bg-paper border-2 border-ink flex flex-col items-center relative overflow-hidden">
        <!-- Turnstile Barrier Graphic SVG -->
        <svg viewBox="0 0 300 140" class="w-full h-32 select-none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Floor Chevrons -->
          <line x1="20" y1="130" x2="280" y2="130" stroke="var(--rule)" stroke-width="3" />
          <polygon points="135,130 150,118 165,130" fill="var(--rule)" />

          <!-- Left Barrier Arm (Pivots open) -->
          <g id="gate-left-arm" class="transition-transform duration-500 origin-[60px_70px]">
            <rect x="60" y="66" width="85" height="8" fill="var(--line-frontend)" stroke="var(--ink)" stroke-width="2" rx="2" />
          </g>

          <!-- Right Barrier Arm (Pivots open) -->
          <g id="gate-right-arm" class="transition-transform duration-500 origin-[240px_70px]">
            <rect x="155" y="66" width="85" height="8" fill="var(--line-frontend)" stroke="var(--ink)" stroke-width="2" rx="2" />
          </g>

          <!-- Left Pillar -->
          <rect x="30" y="30" width="30" height="100" fill="var(--surface)" stroke="var(--ink)" stroke-width="3" rx="2" />
          <!-- Right Pillar with Ticket Slot -->
          <rect x="240" y="30" width="30" height="100" fill="var(--surface)" stroke="var(--ink)" stroke-width="3" rx="2" />
          
          <!-- Validation Slot on right pillar -->
          <rect id="gate-drop-slot" x="246" y="55" width="18" height="6" fill="var(--ink)" />
          <text x="255" y="75" font-family="'IBM Plex Mono', monospace" font-size="7" fill="var(--ink)" font-weight="bold" text-anchor="middle">SLOT</text>
        </svg>

        <!-- Validation Trigger and Stamp Indicator -->
        <div class="mt-4 w-full flex flex-col sm:flex-row items-center justify-between gap-3">
          <!-- Accessible Insert Ticket Button (Keyboard/Screen-Reader fallback) -->
          <button
            type="button"
            id="gate-insert-ticket-btn"
            class="btn-stub w-full sm:w-auto justify-center"
          >
            <span>Insert Ticket (Validate)</span>
            <Pictograms name="arrow-up-right" size={14} />
          </button>

          <!-- Stamped Valid Badge -->
          <div
            id="gate-stamp-badge"
            class="hidden px-3 py-1 border-2 border-emerald-600 bg-paper text-emerald-600 font-mono text-xs font-black uppercase tracking-widest"
          >
            ✓ STAMPED: VALID PASS
          </div>
        </div>

        <p class="font-mono text-[11px] text-ink-soft mt-3 text-center">
          Keyboard users: Click "Insert Ticket" or press Enter. Barrier validates and opens instantly.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const insertBtn = document.getElementById('gate-insert-ticket-btn');
    const speechBubble = document.getElementById('collector-speech-bubble');
    const ledRed = document.getElementById('gate-led-red');
    const ledGreen = document.getElementById('gate-led-green');
    const statusText = document.getElementById('gate-status-text');
    const leftArm = document.getElementById('gate-left-arm');
    const rightArm = document.getElementById('gate-right-arm');
    const stampBadge = document.getElementById('gate-stamp-badge');

    const runValidationSequence = () => {
      // 1. Audio punch & gate sound if sound engine enabled (Section 8)
      if ((window as any).__yugsound) {
        (window as any).__yugsound.punch();
      }

      if (speechBubble) speechBubble.textContent = '"Validating ticket..."';

      setTimeout(() => {
        if ((window as any).__yugsound) {
          (window as any).__yugsound.gateGreen();
        }

        // 2. Turn light green
        if (ledRed) ledRed.classList.replace('bg-[#D8362B]', 'bg-paper');
        if (ledGreen) {
          ledGreen.classList.replace('opacity-30', 'opacity-100');
          ledGreen.classList.replace('bg-paper', 'bg-[#1FA35B]');
        }
        if (statusText) {
          statusText.textContent = 'OPEN // PASS';
          statusText.classList.add('text-emerald-600');
        }

        // 3. Open arms
        if (leftArm) leftArm.style.transform = 'rotate(-65deg)';
        if (rightArm) rightArm.style.transform = 'rotate(65deg)';

        // 4. Collector greeting per microcopy (Section 9)
        if (speechBubble) speechBubble.textContent = '"Valid. Mind the gap — between backend and UI."';

        // 5. Show stamp badge
        if (stampBadge) stampBadge.classList.remove('hidden');

        // 6. Announce to screen reader
        if ((window as any).__yugline) {
          (window as any).__yugline.announce('Gate open. Valid. Mind the gap between backend and UI.');
        }
      }, 600);
    };

    if (insertBtn) {
      insertBtn.addEventListener('click', runValidationSequence);
    }
  });
</script>
