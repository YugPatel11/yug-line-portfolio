---

<div class="space-y-6 select-none" id="skills-metro-station">
  <!-- Top Gantry Header Bar -->
  <div class="p-5 sm:p-6 bg-[#14161B] border border-white/10 rounded-2xl sm:rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex flex-col md:flex-row md:items-center justify-between gap-4 relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent pointer-events-none"></div>
    
    <div class="flex items-center gap-3.5">
      <div class="w-3.5 h-3.5 rounded-full bg-line-hardware animate-pulse shrink-0"></div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-[10px] font-black uppercase tracking-widest text-line-hardware">
            // TERMINAL BERTH 04 · TECHNICAL ARSENAL
          </span>
          <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono text-[10px] font-bold">
            27 VERIFIED TECHNOLOGIES
          </span>
        </div>
        <h3 class="font-archivo text-xl sm:text-2xl font-black text-white uppercase tracking-tight mt-0.5">
          TECHNICAL CAPABILITIES & PRODUCTION STACK
        </h3>
      </div>
    </div>

    <!-- Category Filter Switcher Buttons -->
    <div class="flex flex-wrap items-center gap-1.5 font-mono text-[11px] font-bold">
      <button type="button" class="category-filter-btn px-3 py-1 rounded-full bg-white/10 text-white border border-white/20 hover:bg-white/20 transition-all active:scale-95" data-filter="all">ALL</button>
      <button type="button" class="category-filter-btn px-3 py-1 rounded-full bg-transparent text-neutral-400 border border-white/10 hover:text-white hover:border-white/20 transition-all active:scale-95" data-filter="ai">AI / ML</button>
      <button type="button" class="category-filter-btn px-3 py-1 rounded-full bg-transparent text-neutral-400 border border-white/10 hover:text-white hover:border-white/20 transition-all active:scale-95" data-filter="languages">LANGUAGES</button>
      <button type="button" class="category-filter-btn px-3 py-1 rounded-full bg-transparent text-neutral-400 border border-white/10 hover:text-white hover:border-white/20 transition-all active:scale-95" data-filter="frontend">FRONTEND</button>
      <button type="button" class="category-filter-btn px-3 py-1 rounded-full bg-transparent text-neutral-400 border border-white/10 hover:text-white hover:border-white/20 transition-all active:scale-95" data-filter="backend">BACKEND</button>
      <button type="button" class="category-filter-btn px-3 py-1 rounded-full bg-transparent text-neutral-400 border border-white/10 hover:text-white hover:border-white/20 transition-all active:scale-95" data-filter="tools">TOOLS</button>
    </div>
  </div>

  <!-- Main Bento Grid (Exact layout from user specification) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="bento-skills-grid">
    
    <!-- ========================================================
         COLUMN 1: AI, ML & AUTOMATION + BACKEND & DATABASES
         ======================================================== -->
    <div class="flex flex-col gap-5">
      <!-- CARD 1: AI, ML & Automation (12 Chips) -->
      <div class="bento-card p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-[#14161B] border border-white/10 hover:border-white/20 shadow-[0_12px_32px_rgba(0,0,0,0.5)] transition-all duration-300 relative flex flex-col justify-between" data-category="ai">
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>
        
        <div>
          <!-- Header with Robot Icon -->
          <div class="flex items-center gap-3.5 mb-5">
            <div class="w-10 h-10 rounded-2xl bg-white/[0.05] border border-white/10 flex items-center justify-center text-white/90 shadow-inner shrink-0">
              <svg class="w-5 h-5 text-line-ai" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                <circle cx="12" cy="5" r="2"></circle>
                <path d="M12 7v4"></path>
                <line x1="8" y1="16" x2="8" y2="16"></line>
                <line x1="16" y1="16" x2="16" y2="16"></line>
              </svg>
            </div>
            <h4 class="card-editorial-title text-2xl sm:text-[26px] text-white">
              AI, ML & Automation
            </h4>
          </div>

          <!-- 12 Tag Pills -->
          <div class="flex flex-wrap gap-2">
            {[
              'GEMINI/CLAUDE',
              'KIMI AI',
              'ANTIGRAVITY',
              'CLAUDE CODE',
              'NUMPY',
              'PANDAS',
              'LLM INTEGRATION',
              'AI API INTEGRATION',
              'AI DASHBOARD DEV',
              'PROMPT ENGINEERING',
              'LOOP ENGINEERING',
              'AI AUTOMATION',
            ].map((tag) => (
              <button
                type="button"
                class="skill-chip px-3.5 py-1.5 rounded-full bg-[#1F2228] text-neutral-300 border border-white/[0.07] font-mono text-[11px] sm:text-xs font-semibold tracking-wider hover:bg-white/[0.14] hover:border-line-ai hover:text-white transition-all cursor-pointer shadow-[0_2px_4px_rgba(0,0,0,0.3)] active:scale-95"
                data-skill={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- CARD 4: Backend & Databases (4 Chips) -->
      <div class="bento-card p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-[#14161B] border border-white/10 hover:border-white/20 shadow-[0_12px_32px_rgba(0,0,0,0.5)] transition-all duration-300 relative flex flex-col justify-between" data-category="backend">
        <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent pointer-events-none"></div>
        
        <div>
          <!-- Header with Database Icon -->
          <div class="flex items-center gap-3.5 mb-5">
