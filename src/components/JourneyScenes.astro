---
import MetroTrain from './MetroTrain.astro';
import Pictograms from './Pictograms.astro';
---

<!-- ========================================================
     WELCOME SCENE OVERLAY (Full-screen first encounter)
     ======================================================== -->
<div
  id="scene-welcome"
  class="fixed inset-0 z-[80] bg-paper flex flex-col justify-between p-6 sm:p-12 select-none"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-label="Welcome to The Yug Line"
>
  <div class="flex items-center justify-between border-b-2 border-ink pb-4">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-line-frontend"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
        ONE WHO CODES 2026 // SYSTEM TERMINAL
      </span>
    </div>
    <button
      type="button"
      id="welcome-skip-btn"
      class="day-pass-toggle-btn font-mono text-xs text-ink-soft uppercase hover:text-ink underline"
    >
      Day Pass (skip to all stations) ➔
    </button>
  </div>

  <div class="max-w-3xl mx-auto w-full my-auto text-center py-6">
    <div class="font-mono text-xs uppercase tracking-widest text-ink-soft mb-2">
      // TRANSIT MAP PORTFOLIO //
    </div>
    <h1 class="font-archivo text-4xl sm:text-6xl lg:text-7xl font-black text-ink uppercase tracking-tight mb-4">
      WELCOME TO THE YUG LINE
    </h1>
    <p class="font-manrope text-base sm:text-xl text-ink leading-relaxed mb-8">
      "Every stop is a piece of my work." Bridging backend logic and smooth UIs.
    </p>

    <!-- Animated Metro Arrival Graphic -->
    <div class="my-6 py-4 border-y-2 border-ink bg-surface overflow-hidden relative">
      <div id="welcome-train-track" class="w-full transform -translate-x-full transition-transform duration-1000 ease-out">
        <MetroTrain destination="CENTRAL" />
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6">
      <button
        type="button"
        id="enter-station-btn"
        class="btn-stub px-8 py-3 text-sm justify-center"
      >
        <span>Enter the Station</span>
        <Pictograms name="arrow-up-right" size={16} />
      </button>

      <button
        type="button"
        class="day-pass-toggle-btn btn-stub !bg-surface !text-ink hover:!bg-paper px-6 py-3 text-sm justify-center"
      >
        <span>Day Pass (Skip Booking)</span>
      </button>
    </div>
  </div>

  <div class="border-t border-rule pt-4 flex items-center justify-between text-xs font-mono text-ink-soft">
    <span>AUTHOR: YUG ROJIVADIYA</span>
    <span>PRESS ANY KEY TO ENTER</span>
  </div>
</div>

<!-- ========================================================
     PLATFORM & RIDE SCENE OVERLAY
     ======================================================== -->
<div
  id="scene-transit-ride"
  class="fixed inset-0 z-[75] bg-paper flex flex-col justify-between p-6 sm:p-12 select-none"
  style="display: none;"
  role="region"
  aria-label="Transit in progress"
>
  <!-- Platform / Ride Header -->
  <div class="flex items-center justify-between border-b-2 border-ink pb-4">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-line-hardware animate-pulse"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold" id="transit-platform-indicator">
        PLATFORM 01 // EN ROUTE
      </span>
    </div>
    <button
      type="button"
      id="skip-ride-btn"
      class="font-mono text-xs font-bold text-ink uppercase tracking-wider px-3 py-1 bg-surface border border-ink hover:bg-paper"
    >
      Skip Ride (Instant Arrival) ➔
    </button>
  </div>

  <!-- Main Animated Window & Metro Scene -->
  <div class="max-w-4xl mx-auto w-full my-auto py-6">
    <!-- LED Information Board (Amber on dark per Section 4 & 7) -->
    <div class="bg-[#111111] p-4 border-2 border-ink mb-6 text-center font-mono">
      <div class="text-[10px] text-[#B5B1A6] uppercase tracking-widest mb-1">
        ELECTRONIC ROUTE DISPATCH SYSTEM
      </div>
      <div class="text-xl sm:text-2xl font-black text-[#FFB000] tracking-wider" id="transit-led-announcement">
        NOW ARRIVING · LINE 02 · ALL PROJECTS
      </div>
    </div>

    <!-- Tunnel Lights Simulated Window (CSS transform only per Section 6.1) -->
    <div class="bg-surface border-4 border-ink p-6 relative overflow-hidden mb-6 h-48 sm:h-64 flex flex-col justify-between">
      <!-- 3-Speed Tunnel Light Bars -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-30">
        <div class="tunnel-light-layer-1 h-3 w-48 bg-ink mb-6"></div>
        <div class="tunnel-light-layer-2 h-2 w-32 bg-ink mb-6"></div>
        <div class="tunnel-light-layer-3 h-4 w-64 bg-ink"></div>
      </div>

      <!-- Station Train Graphic -->
      <div class="relative z-10">
        <MetroTrain destination="ALL PROJECTS" />
      </div>

      <!-- Strip Route Map with Moving Dot -->
      <div class="relative z-10 pt-4 border-t-2 border-ink flex items-center justify-between font-mono text-xs">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-line-frontend"></span>
          <span class="text-ink font-bold">CENTRAL</span>
        </div>
        <div class="flex-1 mx-4 h-1 bg-ink relative">
          <span class="absolute top-1/2 -translate-y-1/2 left-1/2 w-3 h-3 rounded-full bg-line-ai border border-paper animate-ping"></span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-line-ai"></span>
          <span class="text-ink font-bold" id="transit-dest-label">DESTINATION</span>
        </div>
      </div>
    </div>

    <!-- Announcement Caption Box -->
    <div class="p-4 bg-surface border-2 border-ink text-center font-mono text-sm sm:text-base text-ink font-bold" id="transit-speech-caption">
      "Next station: All Projects. Curated production systems across 4 lines."
    </div>
  </div>

  <div class="border-t border-rule pt-4 flex items-center justify-between text-xs font-mono text-ink-soft">
    <span>LINE STATUS: NORMAL SPEED</span>
    <span>THE YUG LINE METRO TRANSIT</span>
  </div>
</div>

<style>
  /* Tunnel light animation layers (3 speeds via CSS transform only per Section 6.1) */
  .tunnel-light-layer-1 {
    animation: tunnel-slide 1.2s linear infinite;
  }
  .tunnel-light-layer-2 {
    animation: tunnel-slide 0.8s linear infinite;
  }
  .tunnel-light-layer-3 {
    animation: tunnel-slide 1.8s linear infinite;
  }

  @keyframes tunnel-slide {
    0% { transform: translateX(600px); }
    100% { transform: translateX(-300px); }
  }
</style>
