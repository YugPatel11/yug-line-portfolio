---
// EducationTicket.astro
// Signature Platform Noticeboard with Pinned Cards (Section 5)
import { PROFILE } from '../data/portfolio';
import Pictograms from './Pictograms.astro';

const edu = PROFILE.education;
---

<div class="platform-noticeboard p-6 md:p-8 bg-[#2A1E14] border-4 border-ink shadow-[8px_8px_0_var(--ink)] select-none">
  <!-- Corkboard Frame Top Rail -->
  <div class="flex items-center justify-between border-b-2 border-[#543D2B] pb-3 mb-6">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-line-ai"></span>
      <span class="font-mono text-xs font-black uppercase tracking-widest text-[#F1EEE6]">
        PLATFORM 06 NOTICEBOARD // ACADEMIC DOSSIER
      </span>
    </div>
    <span class="font-mono text-xs font-bold uppercase tracking-wider text-line-hardware bg-black/60 px-2.5 py-0.5 border border-[#543D2B]">
      SEMESTER 04 ACTIVE
    </span>
  </div>

  <!-- Cork Surface with Pinned Cards -->
  <div class="p-6 sm:p-8 bg-[#3E2B1E] border-2 border-black relative rounded-sm shadow-[inset_0_0_20px_rgba(0,0,0,0.6)]">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
      
      <!-- Pinned Card 1: University & Degree (7 cols) -->
      <div class="md:col-span-7 bg-paper p-6 border-3 border-ink shadow-[4px_4px_0_#000] relative transform -rotate-1 hover:rotate-0 transition-transform">
        <!-- Brass Pushpin (Top Center) -->
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-[#E5B53A] border-2 border-ink shadow-[1px_1px_2px_#000] z-20 flex items-center justify-center">
          <span class="w-1.5 h-1.5 rounded-full bg-white/70 block"></span>
        </div>

        <div class="flex items-center gap-3 border-b-2 border-ink pb-3 mb-4">
          <div class="w-10 h-10 border-2 border-ink bg-surface flex items-center justify-center text-ink flex-shrink-0 shadow-[2px_2px_0_var(--ink)]">
            <Pictograms name="book" size={22} />
          </div>
          <div>
            <span class="font-mono text-[10px] uppercase font-bold text-ink-soft block">
              ACCREDITED INSTITUTION
            </span>
            <h3 class="font-archivo text-xl sm:text-2xl font-black text-ink uppercase tracking-tight">
              {edu.institution}
            </h3>
          </div>
        </div>

        <div class="mb-4">
          <span class="font-mono text-xs font-bold text-line-frontend uppercase tracking-wider block mb-1">
            DEGREE PROGRAMME:
          </span>
          <p class="font-archivo text-lg sm:text-xl font-black text-ink">
            {edu.degree}
          </p>
        </div>

        <p class="font-manrope text-sm text-ink leading-relaxed mb-4">
          {edu.focus}
        </p>

        <!-- Official Stamp -->
        <div class="pt-3 border-t border-rule flex items-center justify-between font-mono text-xs">
          <span class="text-ink-soft">TIMELINE: {edu.period}</span>
          <span class="px-2 py-0.5 bg-line-ai/20 text-line-ai border border-line-ai font-bold uppercase">
            REGULAR FULL-TIME
          </span>
        </div>
      </div>

      <!-- Pinned Card 2: Academic Scores & CGPA (5 cols) -->
      <div class="md:col-span-5 bg-surface p-6 border-3 border-ink shadow-[4px_4px_0_#000] relative transform rotate-1 hover:rotate-0 transition-transform space-y-4">
        <!-- Red Pushpin (Top Center) -->
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-[#E4572E] border-2 border-ink shadow-[1px_1px_2px_#000] z-20 flex items-center justify-center">
          <span class="w-1.5 h-1.5 rounded-full bg-white/70 block"></span>
        </div>

        <div class="border-b-2 border-ink pb-2">
          <span class="font-mono text-[10px] font-black uppercase tracking-widest text-ink-soft block">
            VERIFIED GRADE SHEET
          </span>
          <h4 class="font-archivo text-lg font-black text-ink uppercase tracking-tight">
            PERFORMANCE LEDGER
          </h4>
        </div>

        <!-- CGPA Score Tiles -->
        <div class="space-y-3">
          <div class="p-3.5 bg-paper border-2 border-ink shadow-[2px_2px_0_var(--ink)] flex items-center justify-between">
            <div>
              <span class="font-mono text-[10px] text-ink-soft uppercase block">YEAR 1 APPRAISAL</span>
              <span class="font-mono text-xs font-bold text-ink">FOUNDATION CSE</span>
            </div>
            <span class="font-archivo text-2xl font-black text-line-hardware">
              {edu.cgpaYear1}
            </span>
          </div>

          <div class="p-3.5 bg-paper border-2 border-ink shadow-[2px_2px_0_var(--ink)] flex items-center justify-between">
            <div>
              <span class="font-mono text-[10px] text-ink-soft uppercase block">YEAR 2 APPRAISAL</span>
              <span class="font-mono text-xs font-bold text-ink">ADVANCED AI/ML TRACK</span>
            </div>
            <span class="font-archivo text-2xl font-black text-line-hardware">
              {edu.cgpaYear2}
            </span>
          </div>
        </div>

        <!-- Verification Seal -->
        <div class="p-2.5 bg-paper border border-dashed border-ink flex items-center justify-center gap-2 font-mono text-[11px] text-emerald-600 font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>UNIVERSITY TRANSCRIPT ON FILE</span>
        </div>
      </div>

    </div>
  </div>
</div>
