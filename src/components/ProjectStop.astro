---
// ProjectStop.astro
// Machined Platform Plaque with Real Media Screenshots & Focus-Trapped Inspection
import type { ProjectItem } from '../data/types';
import Pictograms from './Pictograms.astro';
import LineChip from './LineChip.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isDev = import.meta.env.DEV;

const PROJECT_IMAGES: Record<string, string> = {
  geobus: '/images/Geobus.jpg',
  grantpilot: '/images/Grantpilot.jpg',
  datamorfix: '/images/DataMorfix.png',
  ecosortx: '/images/EcosortX.png',
  ems: '/images/EMS.png',
  clinic: '/images/clinic.png',
  cricktraker: '/images/cricktraker.jpeg',
};

const projectImg = PROJECT_IMAGES[project.id];
---

<div
  class="station-plaque p-6 sm:p-8 bg-surface flex flex-col justify-between project-card transition-all"
  data-lines={project.lines.join(' ')}
  data-project-id={project.id}
>
  <!-- Machined Metallic Corner Rivets -->
  <span class="plaque-rivet plaque-rivet-tl" aria-hidden="true"></span>
  <span class="plaque-rivet plaque-rivet-tr" aria-hidden="true"></span>
  <span class="plaque-rivet plaque-rivet-bl" aria-hidden="true"></span>
  <span class="plaque-rivet plaque-rivet-br" aria-hidden="true"></span>

  <!-- Plaque Specification Header Bar -->
  <div class="flex items-center justify-between font-mono text-[10px] text-ink-soft uppercase tracking-widest border-b border-rule pb-2 mb-3">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-line-frontend inline-block"></span>
      SPEC // TRANSIT SYSTEM PLAQUE
    </span>
    <span class="font-bold text-ink">PROD · CERTIFIED</span>
  </div>

  <div>
    <!-- Ticket Header: Pictogram, Lines & Fare -->
    <div class="flex items-start justify-between gap-3 border-b border-rule pb-3 mb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 border border-ink bg-paper flex items-center justify-center text-ink flex-shrink-0 shadow-[2px_2px_0_var(--ink)]">
          <Pictograms name={project.pictogram} size={22} />
        </div>
        <div>
          <h3 class="font-archivo text-xl font-bold text-ink">
            {project.title}
          </h3>
          <div class="flex flex-wrap gap-1.5 mt-1">
            {project.lines.map((line) => (
              <LineChip line={line} size="sm" />
            ))}
          </div>
        </div>
      </div>

      <!-- Fare / Grant Badge -->
      {project.grantAmount && (
        <div class="text-right flex-shrink-0">
          <span class="font-mono text-[10px] text-ink-soft uppercase block">GRANT FARE</span>
          <span class="font-mono text-xs font-bold text-ink bg-line-hardware/30 px-2 py-0.5 border border-line-hardware inline-block shadow-[1px_1px_0_var(--ink)]">
            {project.grantAmount}
          </span>
        </div>
      )}
    </div>

    <!-- Project Purpose & Description -->
    <div class="mb-4">
      <p class="font-mono text-xs text-line-frontend font-bold uppercase tracking-wider mb-2">
        {project.tagline}
      </p>
      <p class="font-manrope text-sm sm:text-base text-ink leading-relaxed max-w-[65ch]">
        {project.description}
      </p>
    </div>

    <!-- Tech Stack Chips (Section 5.2) -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {project.techStack.slice(0, 3).map((tech) => (
        <span class="font-mono text-xs uppercase tracking-wider px-2.5 py-1 bg-paper border border-rule text-ink shadow-[1px_1px_0_var(--ink)]">
          {tech}
        </span>
      ))}
      {project.techStack.length > 3 && (
        <span class="font-mono text-xs uppercase tracking-wider px-2 py-1 bg-surface border border-rule text-ink-soft">
          +{project.techStack.length - 3}
        </span>
      )}
    </div>
  </div>

  <div>
    <!-- Perforation and Verification Slot -->
    <div class="ticket-perforation pt-3 mt-2">
      <!-- Real Production Screenshot Vitrine Frame -->
      <div class="mb-3 border-2 border-ink bg-paper p-1.5 shadow-[3px_3px_0_var(--ink)] overflow-hidden">
        {projectImg ? (
          <div class="relative w-full aspect-[16/8] overflow-hidden bg-black/5 group">
            <img
              src={projectImg}
              alt={`${project.title} Interface Screenshot`}
              class="w-full h-full object-cover filter contrast-105 group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <span class="absolute bottom-1 right-1 px-1.5 py-0.5 bg-black/80 font-mono text-[9px] text-[#FFC933] font-bold uppercase">
              AUTHENTICATED BUILD
            </span>
          </div>
        ) : (
          <div class="w-full aspect-[16/8] bg-surface flex items-center justify-center font-mono text-xs text-ink-soft">
            SCHEMATIC BLUEPRINT // PROD
          </div>
        )}
      </div>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <div class="flex items-center gap-3">
          {project.liveUrl && !project.liveUrl.startsWith('TODO') ? (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs font-bold uppercase tracking-wider text-ink hover:text-line-frontend inline-flex items-center gap-1 border border-ink px-2.5 py-1 bg-paper shadow-[2px_2px_0_var(--ink)]"
            >
              <span>Visit Project</span>
              <Pictograms name="arrow-up-right" size={12} />
            </a>
          ) : (
            <span class="font-mono text-[10px] text-ink-soft uppercase tracking-wider">
              {isDev ? '[DEV: TODO-USER Live Link]' : 'Demo: On Request'}
            </span>
          )}

          {project.repoUrl && (
            project.repoUrl.startsWith('TODO') ? (
              <span class="font-mono text-[10px] text-ink-soft uppercase tracking-wider">
                {isDev ? '[DEV: TODO-USER Repo]' : 'Source: Private'}
              </span>
            ) : (
              <a
                href={project.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs font-bold text-ink hover:underline uppercase"
              >
                Repo ➔
              </a>
            )
          )}
        </div>

        <span class="font-mono text-[10px] font-bold uppercase text-emerald-600 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          ACTIVE ON LINE
        </span>
      </div>
    </div>
  </div>
</div>
