---
import { PROFILE } from '../data/portfolio';
import Pictograms from './Pictograms.astro';

const { contacts } = PROFILE;
---

<div class="ticket p-6 md:p-10 bg-surface border-2 border-ink shadow-[8px_8px_0_var(--ink)] relative">
  <!-- Terminus Header -->
  <div class="flex items-center justify-between border-b-2 border-ink pb-4 mb-6">
    <div class="flex items-center gap-3">
      <span class="w-4 h-4 rounded-full bg-ink"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
        STATION 07 // TERMINUS & CONNECTIVITY HUB
      </span>
    </div>
    <span class="font-mono text-xs font-bold uppercase tracking-wider bg-line-frontend text-paper px-2.5 py-0.5">
      FINAL STOP
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-7">
      <h3 class="font-archivo text-3xl md:text-5xl font-extrabold text-ink tracking-tight mb-3">
        END OF THE LINE?
      </h3>
      <p class="font-manrope text-base md:text-lg text-ink-soft leading-relaxed mb-6">
        Let's start the next journey. Available for high-impact software internships, part-time engineering roles, and innovative freelance builds.
      </p>

      <!-- Direct Connection Buttons (no raw emails/phones in plain text) -->
      <div class="flex flex-wrap gap-4">
        <a
          href={contacts.emailLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-stub"
        >
          <span>Send Direct Email</span>
          <Pictograms name="arrow-up-right" size={14} />
        </a>

        <a
          href={contacts.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-stub !bg-surface !text-ink hover:!bg-paper"
        >
          <span>Connect via WhatsApp</span>
          <Pictograms name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>

    <!-- Network Channels & Social Hub -->
    <div class="lg:col-span-5 bg-paper border-2 border-ink p-5">
      <div class="font-mono text-xs font-bold text-ink uppercase tracking-wider border-b border-rule pb-2 mb-4">
        // Verified Digital Channels
      </div>
      <div class="space-y-3 font-mono text-xs">
        <a
          href={contacts.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-2.5 bg-surface border border-rule hover:border-ink transition-colors group"
        >
          <span class="font-bold text-ink group-hover:text-line-frontend">LinkedIn Profile</span>
          <Pictograms name="arrow-up-right" size={12} />
        </a>

        <a
          href={contacts.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-2.5 bg-surface border border-rule hover:border-ink transition-colors group"
        >
          <span class="font-bold text-ink group-hover:text-line-frontend">GitHub Workspaces</span>
          <Pictograms name="arrow-up-right" size={12} />
        </a>

        <a
          href={contacts.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-2.5 bg-surface border border-rule hover:border-ink transition-colors group"
        >
          <span class="font-bold text-ink group-hover:text-line-frontend">Instagram Social</span>
          <Pictograms name="arrow-up-right" size={12} />
        </a>
      </div>

      <div class="mt-4 pt-3 border-t border-rule flex items-center justify-between text-[11px] font-mono text-ink-soft">
        <span>PASSPORT NO: YUG-2026</span>
        <span>VALID NATIONWIDE</span>
      </div>
    </div>
  </div>

  <!-- Footer Copyright and Back to Top -->
  <div class="ticket-perforation mt-10 pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs text-ink-soft">
    <div>
      © 2026 Yug Rojivadiya • The Yug Line Portfolio
    </div>
    <div class="flex items-center gap-4">
      <span>Static Build: Astro + Tailwind</span>
      <a href="#station-00" class="hover:text-ink font-bold uppercase underline">
        Return to Departure ↑
      </a>
    </div>
  </div>
</div>
