---
import '@fontsource-variable/archivo';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yug Rojivadiya | The Yug Line',
  description = 'Multidisciplinary Developer building digital experiences bridging backend logic and smooth UIs. Explore projects, experience, and skills.',
} = Astro.props;

const canonicalURL = 'https://yugpatel11.github.io/';
const ogImage = `${canonicalURL}og-image.svg`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yug Rojivadiya" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts Preconnect for Editorial Headings -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@1,6..72,500;1,6..72,600&family=Playfair+Display:ital,wght@1,500;1,600&display=swap" rel="stylesheet" />

    <!-- Favicon mark -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Yug Rojivadiya",
      "url": canonicalURL,
      "jobTitle": "Multidisciplinary Developer",
      "description": description,
      "sameAs": [
        "https://www.linkedin.com/in/yug-rojivadiya-115bb435a/",
        "https://github.com/YugPatel11",
        "https://www.instagram.com/yug.rojivadiya/"
      ]
    })} />
  </head>
  <body class="transit-grid-bg paper-grain bg-paper text-ink font-manrope antialiased overflow-x-hidden min-h-screen">
    <!-- Ambient Passing Train Tunnel Window (Rule 2.6) -->
    <div class="ambient-tunnel-window" aria-hidden="true">
      <div class="ambient-passing-train">
        <svg viewBox="0 0 800 36" class="w-full h-full text-ink fill-current" xmlns="http://www.w3.org/2000/svg">
          <!-- Lead Car 1 -->
          <rect x="0" y="4" width="180" height="26" rx="4" />
          <polygon points="0,10 0,26 -20,26" />
          <circle cx="35" cy="33" r="3" />
          <circle cx="65" cy="33" r="3" />
          <circle cx="120" cy="33" r="3" />
          <circle cx="150" cy="33" r="3" />
          <rect x="20" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <rect x="80" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <!-- Gangway -->
          <rect x="180" y="10" width="10" height="18" fill="var(--ink)" opacity="0.5" />
          <!-- Car 2 -->
          <rect x="190" y="4" width="180" height="26" rx="4" />
          <circle cx="225" cy="33" r="3" />
          <circle cx="255" cy="33" r="3" />
          <circle cx="310" cy="33" r="3" />
          <circle cx="340" cy="33" r="3" />
          <rect x="210" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <rect x="270" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <!-- Gangway -->
          <rect x="370" y="10" width="10" height="18" fill="var(--ink)" opacity="0.5" />
          <!-- Car 3 -->
          <rect x="380" y="4" width="180" height="26" rx="4" />
          <circle cx="415" cy="33" r="3" />
          <circle cx="445" cy="33" r="3" />
          <circle cx="500" cy="33" r="3" />
          <circle cx="530" cy="33" r="3" />
          <rect x="400" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <rect x="460" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <!-- Gangway -->
          <rect x="560" y="10" width="10" height="18" fill="var(--ink)" opacity="0.5" />
          <!-- Car 4 -->
          <rect x="570" y="4" width="180" height="26" rx="4" />
          <circle cx="605" cy="33" r="3" />
          <circle cx="635" cy="33" r="3" />
          <circle cx="690" cy="33" r="3" />
          <circle cx="720" cy="33" r="3" />
          <rect x="590" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
          <rect x="650" y="8" width="30" height="12" fill="var(--paper)" opacity="0.3" />
        </svg>
      </div>
    </div>
    <slot />
  </body>
</html>

