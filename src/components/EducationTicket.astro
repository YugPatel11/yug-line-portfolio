---
import { PROFILE } from '../data/portfolio';
import Pictograms from './Pictograms.astro';

const edu = PROFILE.education;
---

<div class="ticket p-6 md:p-8 bg-surface border-2 border-ink shadow-[6px_6px_0_var(--ink)]">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-rule pb-4 mb-6">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 border border-ink bg-paper flex items-center justify-center text-ink flex-shrink-0">
        <Pictograms name="book" size={22} />
      </div>
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-ink-soft">
          {edu.institution}
        </span>
        <h3 class="font-archivo text-2xl font-bold text-ink tracking-tight">
          {edu.degree}
        </h3>
      </div>
    </div>

    <!-- Timeline & Semester -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-mono text-xs font-bold px-3 py-1 bg-paper border border-rule text-ink uppercase">
        {edu.period}
      </span>
      <span class="font-mono text-xs font-bold px-3 py-1 bg-paper border border-rule text-line-frontend uppercase">
        {edu.semester}
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
    <div class="md:col-span-8">
      <p class="font-manrope text-sm md:text-base text-ink leading-relaxed">
        {edu.focus}
      </p>
    </div>

    <!-- CGPA Badges -->
    <div class="md:col-span-4 flex flex-row md:flex-col gap-3 justify-end">
      <div class="p-3 bg-paper border border-rule text-center md:text-right">
        <div class="font-archivo text-xl font-black text-ink">{edu.cgpaYear1}</div>
        <div class="font-mono text-[10px] text-ink-soft uppercase tracking-wider">1st Year Score</div>
      </div>
      <div class="p-3 bg-paper border border-rule text-center md:text-right">
        <div class="font-archivo text-xl font-black text-ink">{edu.cgpaYear2}</div>
        <div class="font-mono text-[10px] text-ink-soft uppercase tracking-wider">2nd Year Score</div>
      </div>
    </div>
  </div>
</div>
