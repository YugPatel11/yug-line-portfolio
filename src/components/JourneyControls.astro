---
import Pictograms from './Pictograms.astro';
---

<!-- ========================================================
     JOURNEY CONTROLS & DECISION BAR
     Strictly per Section 5.4:
     - Slim top bar: "You are at: <Stop Name> · Stop X of 7"
     - Fixed bottom bar centred:
       * Next: X → (primary)
       * Back to start
       * All stops (opens All Stops sheet)
       * At last stop: Back to start & Restart the journey
     - Live region announcer for accessibility
     ======================================================== -->

<!-- ARIA Live Announcer for screen readers (Section 6 & 10) -->
<div id="journey-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

<!-- Slim Stop Indicator Bar (Visible on Stop screens in Journey Mode) -->
<div
  id="journey-stop-indicator-bar"
  class="w-full mb-6 p-3 bg-surface border-2 border-ink flex items-center justify-between font-mono text-xs text-ink"
  style="display: none;"
>
  <div class="flex items-center gap-2">
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
    <span id="journey-stop-location-label" class="font-bold">
      You are at: Achievements · Stop 1 of 7
    </span>
  </div>

  <button
    type="button"
    id="indicator-all-stops-trigger"
    class="text-ink-soft hover:text-ink underline uppercase font-bold"
  >
    All stops
  </button>
</div>

<!-- Fixed Centred Decision Bar (Section 5.4) -->
<nav
  id="journey-decision-bar"
  aria-label="Transit Journey Control Bar"
  class="fixed bottom-3 sm:bottom-4 left-2.5 right-2.5 sm:left-1/2 sm:-translate-x-1/2 sm:w-auto sm:max-w-xl z-40 bg-surface border-2 border-ink shadow-[4px_4px_0_var(--ink)] p-2 sm:p-3 flex items-center justify-between gap-1.5 sm:gap-3 text-[11px] sm:text-xs font-mono"
  style="display: none; bottom: max(var(--sab), 0.75rem);"
>
  <!-- Back to start -->
  <button
    type="button"
    id="decision-base-btn"
    class="px-2.5 sm:px-3 py-1.5 sm:py-2 border-2 border-rule hover:border-ink bg-paper text-ink font-bold uppercase transition-colors shrink-0"
    title="Return to Choose a stop (Start)"
  >
    Back to start
  </button>

  <!-- Next: X → (Primary Action) -->
  <button
    type="button"
    id="decision-next-btn"
    class="btn-stub !min-h-[40px] sm:!min-h-[44px] !px-2.5 sm:!px-4 bg-ink text-paper font-bold uppercase tracking-wider flex-1 justify-center hover:opacity-90 transition-opacity truncate"
  >
    <span id="decision-next-label" class="truncate">Next: All Projects →</span>
  </button>

  <!-- All stops sheet trigger -->
  <button
    type="button"
    id="decision-all-stops-btn"
    class="px-2.5 sm:px-3 py-1.5 sm:py-2 border-2 border-rule hover:border-ink bg-paper text-ink font-bold uppercase transition-colors shrink-0"
    title="Open All Stops list"
  >
    All stops
  </button>

  <!-- Hidden restart button (shown only on last station ST-07) -->
  <button
    type="button"
    id="decision-restart-btn"
    class="hidden px-3 py-2 border-2 border-line-frontend bg-paper text-line-frontend font-bold uppercase hover:bg-surface transition-colors"
  >
    Restart journey
  </button>
</nav>
