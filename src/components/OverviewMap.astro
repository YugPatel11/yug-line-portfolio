---
import { LINES } from '../data/portfolio';
---

<div class="ticket p-5 md:p-6 rounded-none relative overflow-hidden bg-surface" id="network-overview-hall">
  <div class="flex items-center justify-between border-b border-rule pb-3 mb-4">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-line-frontend animate-pulse" aria-hidden="true"></span>
      <h3 class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
        DEPARTURES HALL // ROUTE DIAGRAM
      </h3>
    </div>
    <span class="font-mono text-[11px] uppercase tracking-wider text-ink-soft bg-paper px-2 py-0.5 border border-rule">
      Zone 1-4
    </span>
  </div>

  <!-- SVG Transit Map -->
  <div class="relative w-full aspect-[16/10] bg-paper border border-rule overflow-hidden p-2">
    <svg viewBox="0 0 500 320" class="w-full h-full select-none" xmlns="http://www.w3.org/2000/svg" role="region" aria-label="Interactive Metro Transit Map">
      <defs>
        <!-- Grid pattern -->
        <pattern id="mapGrid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--rule)" stroke-width="0.5" opacity="0.4" />
        </pattern>
      </defs>

      <rect width="500" height="320" fill="url(#mapGrid)" />

      <!-- Railway Lines (45° and 90° angles per Section 4) -->
      <!-- AI/ML Line (Blue) -->
      <path
        d="M 40 50 L 140 50 L 220 130 L 250 160 L 320 160 L 380 220 L 460 220"
        fill="none"
        stroke="var(--line-ai)"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Frontend Line (Orange) -->
      <path
        d="M 40 90 L 180 90 L 250 160 L 350 260 L 460 260"
        fill="none"
        stroke="var(--line-frontend)"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Backend Line (Green) -->
      <path
        d="M 40 160 L 250 160 L 330 80 L 460 80"
        fill="none"
        stroke="var(--line-backend)"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Hardware/IoT Line (Yellow) -->
      <path
        d="M 40 220 L 120 220 L 180 160 L 250 160 L 300 160 L 360 100 L 460 100"
        fill="none"
        stroke="var(--line-hardware)"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- ST-01 Departures Board Stop -->
      <g class="map-station-node cursor-pointer group" data-station="station-01" tabindex="0" role="button" aria-label="Station 01: Departures Board">
        <circle cx="110" cy="90" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" class="group-hover:scale-125 transition-transform" />
        <text x="95" y="78" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--ink)" font-weight="bold">ST-01 BOARD</text>
      </g>

      <!-- ST-04 Crew Stop -->
      <g class="map-station-node cursor-pointer group" data-station="station-04" tabindex="0" role="button" aria-label="Station 04: Crew and Service Record">
        <circle cx="120" cy="160" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" class="group-hover:scale-125 transition-transform" />
        <text x="100" y="150" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--ink)" font-weight="bold">ST-04 CREW</text>
      </g>

      <!-- ST-05 Line Legend Stop -->
      <g class="map-station-node cursor-pointer group" data-station="station-05" tabindex="0" role="button" aria-label="Station 05: Line Legend">
        <circle cx="150" cy="190" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" class="group-hover:scale-125 transition-transform" />
        <text x="145" y="210" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--ink)" font-weight="bold">ST-05 LEGEND</text>
      </g>

      <!-- ST-03 Projects Stop -->
      <g class="map-station-node cursor-pointer group" data-station="station-03" tabindex="0" role="button" aria-label="Station 03: Projects Stop">
        <circle cx="340" cy="180" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" class="group-hover:scale-125 transition-transform" />
        <text x="350" y="185" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--ink)" font-weight="bold">ST-03 PROJECTS</text>
      </g>

      <!-- ST-06 Academic Stop -->
      <g class="map-station-node cursor-pointer group" data-station="station-06" tabindex="0" role="button" aria-label="Station 06: Academic Junction">
        <circle cx="380" cy="120" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" class="group-hover:scale-125 transition-transform" />
        <text x="390" y="125" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--ink)" font-weight="bold">ST-06 EDU</text>
      </g>

      <!-- ST-07 Terminus Stop -->
      <g class="map-station-node cursor-pointer group" data-station="station-07" tabindex="0" role="button" aria-label="Station 07: Terminus">
        <circle cx="450" cy="160" r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" class="group-hover:scale-125 transition-transform" />
        <text x="410" y="185" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--ink)" font-weight="bold">ST-07 TERMINUS</text>
      </g>

      <!-- MAJOR INTERCHANGE: ST-02 GHUMIFY (center 250, 160) -->
      <g class="map-station-node cursor-pointer group" data-station="station-02" tabindex="0" role="button" aria-label="Station 02: Ghumify Interchange">
        <circle cx="250" cy="160" r="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="4" class="group-hover:scale-110 transition-transform" />
        <circle cx="250" cy="160" r="7" fill="var(--ink)" />
        <rect x="195" y="182" width="110" height="24" fill="var(--ink)" rx="2" />
        <text x="250" y="198" font-family="'Archivo Variable', sans-serif" font-size="11" font-weight="900" fill="var(--paper)" text-anchor="middle" letter-spacing="1">
          GHUMIFY INTCHG
        </text>
      </g>

      <!-- YOU ARE HERE Indicator at Central Departure (ST-00) -->
      <g class="map-station-node cursor-pointer group" data-station="station-00" tabindex="0" role="button" aria-label="Station 00: Central Departure (You are here)" transform="translate(40, 90)">
        <circle cx="0" cy="0" r="6" fill="var(--line-frontend)" stroke="var(--ink)" stroke-width="2" />
        <circle cx="0" cy="0" r="12" fill="none" stroke="var(--line-frontend)" stroke-width="1.5" opacity="0.7">
          <animate attributeName="r" values="6;16;6" dur="2s" repeatCount="indefinite" />
          <animate attributeName="opacity" values="0.8;0;0.8" dur="2s" repeatCount="indefinite" />
        </circle>
        
        <!-- Callout Pin -->
        <rect x="8" y="-24" width="86" height="18" fill="var(--ink)" rx="2" />
        <text x="51" y="-12" font-family="'IBM Plex Mono', monospace" font-size="8" font-weight="700" fill="var(--paper)" text-anchor="middle">
          YOU ARE HERE
        </text>
      </g>
    </svg>
  </div>

  <!-- Legend row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-4 pt-3 border-t border-rule font-mono text-[11px]">
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-1.5 rounded-sm" style={`background-color: ${LINES.frontend.colorVar}`} aria-hidden="true"></span>
      <span class="text-ink font-medium">Frontend</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-1.5 rounded-sm" style={`background-color: ${LINES.backend.colorVar}`} aria-hidden="true"></span>
      <span class="text-ink font-medium">Backend</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-1.5 rounded-sm" style={`background-color: ${LINES.ai.colorVar}`} aria-hidden="true"></span>
      <span class="text-ink font-medium">AI / ML</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-1.5 rounded-sm" style={`background-color: ${LINES.hardware.colorVar}`} aria-hidden="true"></span>
      <span class="text-ink font-medium">Hardware</span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nodes = document.querySelectorAll('.map-station-node');
    nodes.forEach((node) => {
      const handleSelect = () => {
        const stationId = node.getAttribute('data-station');
        if (stationId && (window as any).__yugline) {
          (window as any).__yugline.navigateToStation(stationId);
        }
      };

      node.addEventListener('click', handleSelect);
      node.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleSelect();
        }
      });
    });
  });
</script>
