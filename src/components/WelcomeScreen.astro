---
import Pictograms from './Pictograms.astro';
---

<!-- ========================================================
     WELCOME SCREEN (Step 0, Full-Screen Entry & Audio Choice)
     Strictly per Section 2 & 5.4:
     - Heading: "Welcome to The Yug Line"
     - One sentence: "Every stop is a piece of my work."
     - One line explanation: "This site has metro sounds. You can change this any time."
     - Two large buttons: Enter with sound (primary) & Enter without sound
     - One small text button: Skip the metro · see everything
     - Nothing else!
     ======================================================== -->
<div
  id="scene-welcome"
  class="fixed inset-0 z-[80] bg-paper flex flex-col items-center justify-between p-6 sm:p-12 select-none"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="welcome-heading"
>
  <!-- Top Bar: Authority Monogram -->
  <div class="w-full max-w-2xl flex items-center justify-between border-b-2 border-ink pb-3">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-line-frontend"></span>
      <span class="font-mono text-xs uppercase tracking-widest text-ink font-bold">
        THE YUG LINE // TRANSIT AUTHORITY
      </span>
    </div>
    <span class="font-mono text-xs text-ink-soft">2026 EDITION</span>
  </div>

  <!-- Centre Content Block -->
  <div class="w-full max-w-xl text-center my-auto py-4">
    <!-- Calm SVG Metro Rolling In -->
    <div class="w-full py-4 mb-6 overflow-hidden relative border-y-2 border-ink bg-surface">
      <svg
        id="welcome-train-svg"
        viewBox="0 0 500 90"
        class="w-full h-20 sm:h-24 transition-transform duration-[1800ms] ease-out"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <!-- Rail Track -->
        <line x1="0" y1="82" x2="500" y2="82" stroke="var(--ink)" stroke-width="3" />
        <line x1="0" y1="87" x2="500" y2="87" stroke="var(--rule)" stroke-width="2" stroke-dasharray="6 4" />

        <!-- Train Car Body -->
        <g id="welcome-train-body">
          <!-- Main Body -->
          <rect x="50" y="16" width="380" height="56" rx="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
          
          <!-- Roof AC Units -->
          <rect x="110" y="8" width="50" height="8" rx="2" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" />
          <rect x="300" y="8" width="50" height="8" rx="2" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" />
          
          <!-- Livery Stripe (4 lines) -->
          <rect x="50" y="58" width="380" height="4" fill="var(--line-frontend)" />
          <rect x="50" y="62" width="380" height="4" fill="var(--line-ai)" />

          <!-- Windows -->
          <rect x="80" y="24" width="40" height="24" rx="2" fill="var(--ink)" />
          <rect x="190" y="24" width="50" height="24" rx="2" fill="var(--ink)" />
          <rect x="310" y="24" width="50" height="24" rx="2" fill="var(--ink)" />

          <!-- Window Reflection Streaks -->
          <line x1="88" y1="28" x2="98" y2="44" stroke="#ffffff" stroke-width="1.5" opacity="0.3" />
          <line x1="200" y1="28" x2="212" y2="44" stroke="#ffffff" stroke-width="1.5" opacity="0.3" />
          <line x1="320" y1="28" x2="332" y2="44" stroke="#ffffff" stroke-width="1.5" opacity="0.3" />

          <!-- Doors -->
          <rect x="140" y="22" width="34" height="48" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" />
          <line x1="157" y1="22" x2="157" y2="70" stroke="var(--ink)" stroke-width="1.5" />
          
          <rect x="260" y="22" width="34" height="48" fill="var(--surface)" stroke="var(--ink)" stroke-width="2" />
          <line x1="277" y1="22" x2="277" y2="70" stroke="var(--ink)" stroke-width="1.5" />

          <!-- Front Cab & Headlight -->
          <path d="M 430 24 Q 450 44 430 72 Z" fill="var(--surface)" stroke="var(--ink)" stroke-width="3" />
          <circle cx="438" cy="56" r="4" fill="#FFC933" stroke="var(--ink)" stroke-width="1.5" />

          <!-- Wheels / Bogies -->
          <circle cx="95" cy="77" r="7" fill="var(--ink)" />
          <circle cx="125" cy="77" r="7" fill="var(--ink)" />
          <circle cx="340" cy="77" r="7" fill="var(--ink)" />
          <circle cx="370" cy="77" r="7" fill="var(--ink)" />
        </g>
      </svg>
    </div>

    <!-- Main Heading -->
    <h1 id="welcome-heading" class="font-archivo text-3xl sm:text-5xl lg:text-6xl font-black text-ink uppercase tracking-tight mb-3">
      Welcome to The Yug Line
    </h1>

    <!-- Single Key Sentence -->
    <p class="font-manrope text-base sm:text-xl text-ink leading-relaxed mb-4">
      Every stop is a piece of my work.
    </p>

    <!-- Sound Explanation Sentence -->
    <p class="font-mono text-xs sm:text-sm text-ink-soft mb-8">
      This site has metro sounds. You can change this any time.
    </p>

    <!-- Two Primary Entry Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full">
      <button
        type="button"
        id="welcome-enter-sound-btn"
        class="btn-stub btn-stub--primary w-full sm:w-auto px-8 justify-center shadow-[4px_4px_0_var(--ink)]"
      >
        <span>Enter with sound</span>
        <Pictograms name="arrow-up-right" size={18} />
      </button>

      <button
        type="button"
        id="welcome-enter-mute-btn"
        class="btn-stub w-full sm:w-auto px-7 !bg-surface !text-ink hover:!bg-paper justify-center"
      >
        <span>Enter without sound</span>
      </button>
    </div>

    <!-- Skip Text Button -->
    <div class="mt-6">
      <button
        type="button"
        id="welcome-skip-link"
        class="day-pass-toggle-btn font-mono text-xs text-ink-soft hover:text-ink underline uppercase tracking-wider"
      >
        Skip the metro · see everything
      </button>
    </div>
  </div>

  <!-- Bottom Plain Tagline -->
  <div class="w-full max-w-2xl border-t border-rule pt-3 text-center font-mono text-xs text-ink-soft">
    <span>YUG ROJIVADIYA // MULTIDISCIPLINARY DEVELOPER</span>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const welcome = document.getElementById('scene-welcome');
    if (!welcome) return;

    // Check if welcome already acknowledged in this session or via hash
    let seen = false;
    try {
      seen = sessionStorage.getItem('yugline_welcome_seen') === 'true';
    } catch (e) {}

    const hasHash = Boolean(window.location.hash);
    const mode = sessionStorage.getItem('yugline_mode') || 'journey';

    if (!seen && !hasHash && mode === 'journey') {
      welcome.style.display = 'flex';

      // Animate train roll-in
      const train = document.getElementById('welcome-train-svg');
      if (train) {
        train.style.transform = 'translateX(-120px)';
        requestAnimationFrame(() => {
          train.style.transform = 'translateX(0px)';
        });
      }
    }

    const closeWelcome = (soundEnabled: boolean) => {
      // 1. Audio consent handling (Section 4.1)
      try {
        localStorage.setItem('yugline_sound', soundEnabled ? 'on' : 'off');
        sessionStorage.setItem('yugline_welcome_seen', 'true');
      } catch (e) {}

      // Update sound engine if present
      if ((window as any).__yugsound) {
        (window as any).__yugsound.setEnabled(soundEnabled);
      }

      // Update sound toggle UI text in header
      const soundStatus = document.getElementById('sound-status');
      if (soundStatus) {
        soundStatus.textContent = soundEnabled ? 'Sound: On' : 'Sound: Off';
      }

      // 2. Hide welcome overlay with fade
      welcome.style.opacity = '0';
      welcome.style.transition = 'opacity 0.25s ease';
      setTimeout(() => {
        welcome.style.display = 'none';
        welcome.style.opacity = '1';
        
        // Focus heading on Step 1 (Choose a stop)
        const step1Heading = document.getElementById('choose-stop-heading');
        if (step1Heading) {
          step1Heading.focus();
        }
      }, 250);
    };

    const enterSoundBtn = document.getElementById('welcome-enter-sound-btn');
    const enterMuteBtn = document.getElementById('welcome-enter-mute-btn');
    const skipBtn = document.getElementById('welcome-skip-link');

    if (enterSoundBtn) {
      enterSoundBtn.addEventListener('click', () => closeWelcome(true));
    }
    if (enterMuteBtn) {
      enterMuteBtn.addEventListener('click', () => closeWelcome(false));
    }
    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        closeWelcome(false);
      });
    }
  });
</script>

