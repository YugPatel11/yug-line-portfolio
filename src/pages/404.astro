---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pictograms from '../components/Pictograms.astro';
---

<BaseLayout title="404 — Station Not Found | The Yug Line">
  <main class="min-h-screen flex items-center justify-center p-4">
    <div class="ticket p-8 md:p-12 max-w-lg w-full bg-surface border-2 border-ink shadow-[8px_8px_0_var(--ink)] text-center">
      <div class="font-mono text-xs uppercase tracking-widest text-ink-soft mb-2">
        // LINE DISRUPTION // ERROR 404
      </div>
      <h1 class="font-archivo text-5xl md:text-7xl font-black text-ink mb-4">
        OFF TRACK
      </h1>
      <p class="font-manrope text-sm md:text-base text-ink-soft mb-6 leading-relaxed">
        This station is currently closed, decommissioned, or does not exist on The Yug Line network.
      </p>
      <div class="ticket-perforation pt-6 flex justify-center">
        <a href="/" class="btn-stub">
          <span>Return to Central Departure</span>
          <Pictograms name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
