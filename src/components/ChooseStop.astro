---
import { PROFILE } from '../data/portfolio';
import Pictograms from './Pictograms.astro';
import StationHeader from './StationHeader.astro';
import OverviewMap from './OverviewMap.astro';
import StationClock from './StationClock.astro';

const DESTINATIONS = [
  {
    id: 'station-01',
    code: 'ST-01',
    title: 'Achievements',
    desc: 'Smart India Hackathon 2026 win, awards and milestones',
    line: 'hardware',
    lineColor: 'var(--line-hardware)',
  },
  {
    id: 'station-02',
    code: 'ST-02',
    title: 'All projects',
    desc: 'Curated production systems across frontend, backend, AI & IoT',
    line: 'frontend',
    lineColor: 'var(--line-frontend)',
  },
  {
    id: 'station-03',
    code: 'ST-03',
    title: 'Experience',
    desc: 'Frontend intern at Edverb, VP of EBC Club & freelance developer',
    line: 'backend',
    lineColor: 'var(--line-backend)',
  },
  {
    id: 'station-04',
    code: 'ST-04',
    title: 'Skills and tools',
    desc: 'Full technical capability stack across all 4 transit tracks',
    line: 'hardware',
    lineColor: 'var(--line-hardware)',
  },
  {
    id: 'station-05',
    code: 'ST-05',
    title: 'Education',
    desc: 'B.Tech CSE (AI/ML) at P P Savani University (2024–2028)',
    line: 'ai',
    lineColor: 'var(--line-ai)',
  },
  {
    id: 'station-06',
    code: 'ST-06',
    title: 'Contact me',
    desc: 'Direct communication channels, socials, and inquiry dispatch',
    line: 'central',
    lineColor: 'var(--ink)',
  },
];
---

<!-- ========================================================
     STEP 1 OF 3: CHOOSE A STOP (Replaces Crowded Concourse)
     Strictly per Section 2 & 5.4:
     - 40% passenger bio + 3 proof chips
     - 60% 7 roomy destination buttons (at least 72px tall)
     - Progress indicator showing 7 dots
     ======================================================== -->
<div id="journey-step-choose" class="w-full">
  <!-- Station Header for Central Departure Concourse -->
  <div class="mb-4">
    <StationHeader
      code="ST-00"
      name="Central Departure"
      category="Origin & Identity · Choose a Destination"
      lineVariant="frontend"
      id="heading-st-00-concourse"
    />
  </div>

  <!-- Progress Indicator Strip (7 Dots) -->
  <div class="mb-6 p-3 bg-surface border-2 border-ink flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-line-frontend animate-pulse"></span>
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-ink">
        Step 1 of 3 · Choose a stop
      </span>
    </div>

    <!-- 7 Route Dots -->
    <div class="flex items-center gap-1.5 sm:gap-2" aria-hidden="true">
      {DESTINATIONS.map((_, i) => (
        <span class={`w-2.5 h-2.5 rounded-full border border-ink ${i === 0 ? 'bg-line-frontend' : 'bg-paper'}`}></span>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (5 cols): Passenger Identity & Proof Points + Station Clock + Overview Map -->
    <div class="lg:col-span-5 space-y-6">
      <div class="ticket p-6 sm:p-8 bg-surface border-2 border-ink shadow-[6px_6px_0_var(--ink)]">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
          <div>
            <div class="font-mono text-xs uppercase tracking-widest text-ink-soft mb-1">
              // PASSENGER / ARCHITECT
            </div>
            <h2 id="choose-stop-heading" tabindex="-1" class="font-archivo text-3xl sm:text-4xl font-black text-ink uppercase tracking-tight outline-none">
              {PROFILE.name}
            </h2>
            <p class="font-mono text-sm font-bold text-line-frontend uppercase tracking-wider mt-1">
              // {PROFILE.role}
            </p>
          </div>
          <div class="flex-shrink-0 self-center sm:self-start">
            <StationClock />
          </div>
        </div>

        <p class="font-manrope text-base text-ink leading-relaxed mb-6">
          "{PROFILE.tagline}"
        </p>

        <!-- 3 Key Proof Chips -->
        <div class="space-y-2 mb-6 font-mono text-xs">
          <div class="p-2.5 bg-paper border border-rule flex items-center justify-between">
            <span class="text-ink-soft">GRANTS SECURED:</span>
            <span class="font-bold text-ink">{PROFILE.grantTotal} (SSIP)</span>
          </div>
          <div class="p-2.5 bg-paper border border-rule flex items-center justify-between">
            <span class="text-ink-soft">HACKATHON RECORD:</span>
            <span class="font-bold text-ink">SIH 2026 Winner</span>
          </div>
          <div class="p-2.5 bg-paper border border-rule flex items-center justify-between">
            <span class="text-ink-soft">LEADERSHIP:</span>
            <span class="font-bold text-ink">{PROFILE.leadershipRole}</span>
          </div>
        </div>

        <!-- Availability Pill -->
        <div class="p-3 bg-paper border-2 border-dashed border-ink font-mono text-xs flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-bold text-ink">Open to internship & part-time jobs</span>
        </div>
      </div>

      <!-- Route Diagram in Departures Concourse -->
      <OverviewMap />
    </div>

    <!-- Right Column (7 cols): 7 Roomy Destination Buttons -->
    <div class="lg:col-span-7">
      <div class="mb-4">
        <h3 class="font-archivo text-2xl font-black text-ink uppercase tracking-tight">
          Where would you like to go?
        </h3>
        <p class="font-manrope text-sm text-ink-soft mt-1">
          Tap any destination to generate your boarding pass.
        </p>
      </div>

      <!-- Single-Column Roomy Destination Buttons List (Min 72px Tall) -->
      <div class="space-y-3" role="list">
        {DESTINATIONS.map((dest) => (
          <button
            type="button"
            class="destination-choice-btn w-full min-h-[72px] p-4 bg-surface border-2 border-ink shadow-[3px_3px_0_var(--ink)] hover:shadow-[5px_5px_0_var(--ink)] hover:-translate-y-0.5 text-left flex items-center justify-between gap-4 transition-all group"
            data-station-id={dest.id}
            data-station-code={dest.code}
            data-station-title={dest.title}
            data-station-line={dest.line}
          >
            <div class="flex items-center gap-3.5">
              <!-- Line Dot Marker -->
              <span
                class="w-3.5 h-3.5 rounded-full border-2 border-ink flex-shrink-0 group-hover:scale-125 transition-transform"
                style={`background-color: ${dest.lineColor};`}
              ></span>

              <div>
                <div class="flex items-center gap-2">
                  <span class="font-archivo text-lg font-bold text-ink group-hover:text-line-frontend transition-colors">
                    {dest.title}
                  </span>
                  <span class="font-mono text-xs uppercase px-1.5 py-0.5 bg-paper border border-rule text-ink-soft">
                    {dest.code}
                  </span>
                </div>
                <p class="font-manrope text-xs sm:text-sm text-ink-soft mt-0.5 line-clamp-1">
                  {dest.desc}
                </p>
              </div>
            </div>

            <!-- Free Fare & Forward Arrow -->
            <div class="flex items-center gap-3 flex-shrink-0">
              <span class="hidden sm:inline-block font-mono text-xs font-bold px-2 py-0.5 bg-paper border border-rule text-emerald-600">
                Free
              </span>
              <span class="font-mono text-base font-bold text-ink group-hover:translate-x-1 transition-transform">
                ➔
              </span>
            </div>
          </button>
        ))}
      </div>

      <!-- Skip Link Under Buttons -->
      <div class="mt-6 text-center">
        <button
          type="button"
          class="day-pass-toggle-btn font-mono text-xs text-ink-soft hover:text-ink underline uppercase tracking-wider"
        >
          Skip the metro · see everything
        </button>
      </div>
    </div>
  </div>
</div>

