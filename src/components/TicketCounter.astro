</div>

<style>
  /* CSS Animations for 2D Clerk & Concourse Ambient (Rule 4.3 & 6: transform & opacity only) */
  @keyframes clerkBlink {
    0%, 94%, 98%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }

  @keyframes clerkWave {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-14deg); }
    75% { transform: rotate(10deg); }
  }

  @keyframes clerkHeadNod {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    40% { transform: translateY(3px) rotate(1.5deg); }
    70% { transform: translateY(-1px) rotate(-0.5deg); }
  }

  @keyframes clerkTypeHands {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  @keyframes concourseTrainSlide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(250%); }
  }

  @keyframes clerkMouthTalk {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(2.2); }
  }

  .clerk-mouth-talking {
    animation: clerkMouthTalk 0.16s ease-in-out infinite alternate !important;
    transform-origin: 120px 142px;
  }

  .clerk-blink-motion {
    animation: clerkBlink 4.5s infinite;
    transform-origin: center;
  }

  .clerk-wave-motion {
    animation: clerkWave 3s ease-in-out infinite;
  }

  .clerk-head-motion {
    animation: clerkHeadNod 6s ease-in-out infinite;
  }

  .clerk-typing {
    animation: clerkTypeHands 0.12s ease-in-out infinite alternate !important;
  }

  .concourse-passing-train {
    animation: concourseTrainSlide 18s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .clerk-blink-motion,
    .clerk-wave-motion,
    .clerk-head-motion,
    .clerk-typing,
    .clerk-mouth-talking,
    .concourse-passing-train {
      animation: none !important;
    }
  }
</style>

<script>
  import { sound } from '../scripts/sound';
  import type { StationCode } from '../scripts/journey/constants';

  let selectedStationId: StationCode | null = null;
  let selectedTitle = '';
  let selectedCode = '';
  let isPrinting = false;
  let isReadyForTake = false;

  // Live Concourse Clock
  const clockEl = document.getElementById('concourse-live-clock');
  const updateConcourseClock = () => {
    if (!clockEl) return;
    const now = new Date();
    clockEl.textContent = now.toLocaleTimeString('en-GB', { hour12: false }) + ' IST';
  };
  setInterval(updateConcourseClock, 1000);
  updateConcourseClock();

  const speechBubble = document.getElementById('clerk-speech-bubble');
  const speechText = document.getElementById('clerk-speech-text');
  const speechBadge = document.getElementById('clerk-speech-badge');
  const clerkMouth = document.getElementById('clerk-mouth');
  const clerkAvatar = document.getElementById('counter-clerk-avatar');
  const primaryBtn = document.getElementById('counter-primary-action-btn') as HTMLButtonElement | null;
  const quickBtn = document.getElementById('counter-quick-ticket-btn');
  const bellBtn = document.getElementById('counter-bell-btn');
  const ticketEl = document.getElementById('counter-ticket-element');
  const stripCode = document.getElementById('ticket-strip-code');
  const stripTitle = document.getElementById('ticket-strip-title');
  const clerkHead = document.getElementById('clerk-head');
  const clerkRightArm = document.getElementById('clerk-right-arm');
  const clerkLeftArm = document.getElementById('clerk-left-arm');

  // Find best available voice for Station Master (Indian English preference)
  const getClerkVoice = (): SpeechSynthesisVoice | null => {
    if (!('speechSynthesis' in window)) return null;
    const voices = window.speechSynthesis.getVoices();
    if (!voices || voices.length === 0) return null;

    const inVoice = voices.find((v) => {
      const lang = v.lang.toLowerCase().replace('_', '-');
      const name = v.name.toLowerCase();
      return (
        lang.includes('en-in') ||
        lang.includes('hi-in') ||
        name.includes('india') ||
        name.includes('ravi') ||
        name.includes('priya') ||
        name.includes('heera') ||
        name.includes('neerja')
      );
    });
    if (inVoice) return inVoice;

    return voices.find((v) => v.lang.toLowerCase().startsWith('en')) || null;
  };

  // Station Master Speech Synthesizer
  const speakClerk = (rawText: string, onEnd?: () => void) => {
    if (!('speechSynthesis' in window)) {
      if (onEnd) setTimeout(onEnd, 1000);
      return;
    }

    // Check mute preference
    try {
      const soundPref = localStorage.getItem('yugline_sound');
      if (soundPref === 'off') {
        if (onEnd) setTimeout(onEnd, 1000);
        return;
      }
    } catch (e) {}

    try {
      window.speechSynthesis.cancel();
      const clean = rawText.replace(/^["'“]|["'”]$/g, '').trim();
      if (!clean) {
        if (onEnd) onEnd();
        return;
      }

      const utterance = new SpeechSynthesisUtterance(clean);
      utterance.rate = 1.0;
      utterance.pitch = 1.05;
      utterance.volume = 1.0;

      const voice = getClerkVoice();
      if (voice) {
        utterance.voice = voice;
        utterance.lang = voice.lang;
      } else {
        utterance.lang = 'en-IN';
      }

      utterance.onstart = () => {
        if (clerkMouth) clerkMouth.classList.add('clerk-mouth-talking');
        if (speechBubble) speechBubble.classList.add('ring-4', 'ring-line-hardware');
        if (speechBadge) {
          speechBadge.textContent = 'SPEAKING...';
          speechBadge.classList.add('text-line-frontend');
        }
      };

      let hasFinished = false;
      const finishSpeaking = () => {
        if (hasFinished) return;
        hasFinished = true;
        clearTimeout(safetyTimer);
        if (clerkMouth) clerkMouth.classList.remove('clerk-mouth-talking');
        if (speechBubble) speechBubble.classList.remove('ring-4', 'ring-line-hardware');
        if (speechBadge) {
          speechBadge.textContent = 'REPLAY 🔊';
          speechBadge.classList.remove('text-line-frontend');
        }
        if (onEnd) {
          setTimeout(onEnd, 200);
        }
      };

      const safetyTimer = setTimeout(finishSpeaking, 3500);

      utterance.onend = finishSpeaking;
      utterance.onerror = finishSpeaking;

      window.speechSynthesis.speak(utterance);
    } catch (err) {
      if (onEnd) setTimeout(onEnd, 800);
    }
  };

  const GREETING_TEXT = '"Namaste, welcome to Yug Lines Metro. There is something different at each station."';

  // Station Master Welcome Announcement (Announces automatically on arrival each time)
  const triggerInitialGreeting = () => {
    selectedStationId = null;
    isTransitioningToMetro = false;
    if (speechText) {
      speechText.textContent = GREETING_TEXT;
    }
    speakClerk(GREETING_TEXT);
  };

  // Click speech bubble or clerk avatar to replay current speech
  const replayCurrentSpeech = () => {
    if (speechText && speechText.textContent) {
      speakClerk(speechText.textContent);
    }
  };
  if (speechBubble) speechBubble.addEventListener('click', replayCurrentSpeech);
  if (clerkAvatar) clerkAvatar.addEventListener('click', replayCurrentSpeech);

  // 1. Trigger greeting when entering from Welcome screen with sound
  const enterSoundBtn = document.getElementById('welcome-enter-sound-btn');
  if (enterSoundBtn) {
    enterSoundBtn.addEventListener('click', () => {
      setTimeout(() => {
        triggerInitialGreeting();
      }, 400);
    });
  }

  // 2. Trigger automatically on page reload whenever on base station
  let hasAnnouncedGreeting = false;
  const playGreetingOnReload = () => {
    if (hasAnnouncedGreeting) return;
    const welcomeEl = document.getElementById('scene-welcome');
    const isWelcomeVisible = welcomeEl && welcomeEl.style.display !== 'none';
    const hash = window.location.hash.toLowerCase();
    if (!isWelcomeVisible && (hash === '' || hash === '#base' || hash === '#station-00')) {
      if ('speechSynthesis' in window && window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
      }
      hasAnnouncedGreeting = true;
      triggerInitialGreeting();
    }
  };

  // Immediate attempt on reload
  playGreetingOnReload();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', playGreetingOnReload);
  }
  window.addEventListener('load', playGreetingOnReload);

  // If voices were loading asynchronously on reload, retry when available
  if ('speechSynthesis' in window && window.speechSynthesis.onvoiceschanged !== undefined) {
    window.speechSynthesis.onvoiceschanged = () => {
      getClerkVoice();
      if (!hasAnnouncedGreeting && !selectedStationId) {
        playGreetingOnReload();
      }
    };
  }

  // 3. Trigger automatically whenever returning to base station
  window.addEventListener('yugline:step_choose', () => {
    isTransitioningToMetro = false;
    hasAnnouncedGreeting = false;
    setTimeout(() => {
      triggerInitialGreeting();
    }, 300);
  });

  window.addEventListener('hashchange', () => {
    const hash = window.location.hash.toLowerCase();
    if (hash === '#base' || hash === '' || hash === '#station-00') {
      isTransitioningToMetro = false;
      hasAnnouncedGreeting = false;
      setTimeout(() => {
        triggerInitialGreeting();
      }, 300);
    }
  });

  // 4. Fallback user gesture to satisfy browser audio autoplay requirements on reload
  const onFirstInteraction = (e: Event) => {
    if (
      (e.target as HTMLElement).closest('.destination-choice-btn') ||
      (e.target as HTMLElement).closest('#counter-bell-btn')
    ) {
      return;
    }
    const chooseVisible = document.getElementById('journey-step-choose')?.style.display !== 'none';
    if (chooseVisible && !selectedStationId && !hasAnnouncedGreeting) {
      if ('speechSynthesis' in window && window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
      }
      hasAnnouncedGreeting = true;
      triggerInitialGreeting();
    }
  };
  ['pointerdown', 'touchstart', 'click', 'keydown'].forEach((evt) => {
    window.addEventListener(evt, onFirstInteraction, { passive: true });
  });

  // Ring Counter Bell
  if (bellBtn) {
    bellBtn.addEventListener('click', () => {
      sound.counterBell();
      const bellMsg = '"Ding! Yes, right here! Select any destination on the right."';
      if (speechText) speechText.textContent = bellMsg;
      speakClerk(bellMsg);
    });
  }

  const CLEAN_STATION_NAMES: Record<string, string> = {
    'station-00': 'Base',
    'station-01': 'Achievements',
    'station-02': 'Projects',
    'station-03': 'Experience',
    'station-04': 'Skills',
    'station-05': 'Education',
    'station-06': 'Contact',
  };

  let isTransitioningToMetro = false;

  // Take ticket and launch full-screen cinematic metro
  const proceedToMetro = (stId?: StationCode) => {
    if (isTransitioningToMetro) return;
    isTransitioningToMetro = true;

    const target = stId || selectedStationId || 'station-01';
    sound.punch();
    if (ticketEl) {
      ticketEl.style.transform = 'translateY(60px) scale(0.8)';
      ticketEl.style.opacity = '0';
    }
    const machine = (window as any).__yugline || (window as any).__yuglineMachine;
    if (machine) {
      machine.selectedStation = target;
      machine.launchCinematicMetro(target);
    } else if ((window as any).__launchMetroCinematic) {
      (window as any).__launchMetroCinematic(target);
    }
  };

  // Reset transition flag if user returns to choose step
  window.addEventListener('yugline:step_choose', () => {
    isTransitioningToMetro = false;
  });

  // Allow clicking directly on the extruded ticket in tray
  if (ticketEl) {
    ticketEl.addEventListener('click', () => {
      proceedToMetro();
    });
  }

  // Listen to destination button clicks
  document.querySelectorAll('.destination-choice-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const stId = btn.getAttribute('data-station-id') as StationCode;
      const stCode = btn.getAttribute('data-station-code') || '';
      const stTitle = btn.getAttribute('data-station-title') || '';

      selectedStationId = stId;
      selectedCode = stCode;
      selectedTitle = stTitle;

      // Highlight active button on the fare board with bright transit line border
      document.querySelectorAll('.destination-choice-btn').forEach((b) => {
        b.classList.remove('ring-4', 'ring-line-hardware', 'border-line-hardware', 'bg-surface');
      });
      btn.classList.add('ring-4', 'ring-line-hardware', 'border-line-hardware', 'bg-surface');

      // 1. Clerk nods head
      if (clerkHead) {
        clerkHead.style.transform = 'translateY(5px) rotate(2deg)';
        setTimeout(() => {
          clerkHead.style.transform = 'translateY(0) rotate(0deg)';
        }, 350);
      }

      // 2. Play soft chime
      sound.doorDing();

      // 3. Station name & voice line
      const cleanName = CLEAN_STATION_NAMES[stId] || stTitle.replace(/^All\s+/i, '');
      const voiceLine = `Here is the transit pass for ${cleanName}.`;

      // Update speech bubble
      if (speechText) {
        speechText.textContent = `"${voiceLine}"`;
      }

      // Update ticket strip preview
      if (stripCode) stripCode.textContent = stCode;
      if (stripTitle) stripTitle.textContent = cleanName.toUpperCase();

      // 4. Issue and dispense ticket in tray
      executeBuyTicket(cleanName);

      // 5. Play voice line; once the sound finishes, the metro appears on the screen!
      const activeSt = stId;
      speakClerk(voiceLine, () => {
        if (selectedStationId === activeSt) {
          proceedToMetro(activeSt);
        }
      });
    });
  });

  // Execute Ticket Issuance Sequence (Responsive, animated handover)
  const executeBuyTicket = async (cleanName: string) => {
    if (!selectedStationId || isPrinting) return;
    isPrinting = true;
    isReadyForTake = false;

    if (primaryBtn) {
      primaryBtn.disabled = true;
      primaryBtn.innerHTML = `<span>Dispensing Pass for ${cleanName}...</span>`;
    }

    // Step A: Typing clatter
    if (clerkLeftArm) clerkLeftArm.classList.add('clerk-typing');
    sound.keyboardClick();
    await new Promise((r) => setTimeout(r, 200));
    if (clerkLeftArm) clerkLeftArm.classList.remove('clerk-typing');

    // Step B: Printer extrusion
    sound.printer();
    if (ticketEl) {
      ticketEl.style.opacity = '0.7';
      ticketEl.style.transform = 'translateY(-14px) scale(0.95)';
      ticketEl.style.pointerEvents = 'auto';
    }
    await new Promise((r) => setTimeout(r, 200));

    // Step C: Rubber Stamp impact thunk
    if (clerkRightArm) {
      clerkRightArm.style.transform = 'translateY(10px) rotate(-18deg)';
    }
    sound.stampThunk();
    if (ticketEl) {
      ticketEl.style.opacity = '1';
      ticketEl.style.transform = 'translateY(0) scale(1)';
    }
    await new Promise((r) => setTimeout(r, 160));
    if (clerkRightArm) clerkRightArm.style.transform = 'translateY(0) rotate(0deg)';

    // Step D: Slide ticket into tray
    sound.paperSlide();

    // Step E: Ready in tray!
    isPrinting = false;
    isReadyForTake = true;

    if (primaryBtn) {
      primaryBtn.disabled = false;
      primaryBtn.classList.add('animate-pulse');
      primaryBtn.innerHTML = `<span>Board Metro to ${cleanName} ➔</span>`;
      primaryBtn.focus();
    }
  };

  // Primary Button Click (Handles Instant Boarding)
  if (primaryBtn) {
    primaryBtn.addEventListener('click', () => {
      proceedToMetro();
    });
  }

  // Quick ticket (Instant ticket handover)
  if (quickBtn) {
    quickBtn.addEventListener('click', () => {
      if (!selectedStationId) {
        selectedStationId = 'station-01';
      }
      proceedToMetro(selectedStationId);
    });
  }

  // 3D Parallax Tilt for Ticket Booth Stage
  const boothStage = document.querySelector('.ticket-booth-stage') as HTMLElement | null;
  if (boothStage && !document.documentElement.classList.contains('reduce-motion')) {
    boothStage.style.transition = 'transform 0.15s ease-out';
    boothStage.addEventListener('mousemove', (e) => {
      const rect = boothStage.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      boothStage.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });
    boothStage.addEventListener('mouseleave', () => {
      boothStage.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
    });
  }
</script>
