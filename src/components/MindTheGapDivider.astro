---
// MindTheGapDivider.astro
// Authentic 32px tactile hazard safety strip between stops
interface Props {
  nextStopName?: string;
  nextStopCode?: string;
}

const {
  nextStopName = 'NEXT STOP',
  nextStopCode = 'TRANSIT',
} = Astro.props;
---

<div class="w-full my-6 select-none" role="separator" aria-label={`Mind the gap: proceeding to ${nextStopName}`}>
  <!-- 32px Authentic Platform Hazard & Tactile Divider -->
  <div class="w-full h-8 bg-line-hardware border-y-2 border-ink shadow-[3px_3px_0_var(--ink)] flex items-center justify-between px-3 sm:px-6 relative overflow-hidden">
    <!-- Left Hazard Chevrons Pattern -->
    <div
      class="w-16 sm:w-28 h-full opacity-35"
      style="background: repeating-linear-gradient(-45deg, var(--ink), var(--ink) 6px, transparent 6px, transparent 12px);"
      aria-hidden="true"
    ></div>

    <!-- Centered Tactile Warning & Wayfinding Label -->
    <div class="font-mono text-[10px] sm:text-xs font-black text-ink uppercase tracking-widest flex items-center gap-2 mx-auto">
      <span class="w-2 h-2 rounded-full bg-ink animate-pulse" aria-hidden="true"></span>
      <span>PLATFORM EDGE // MIND THE GAP · {nextStopCode} ➔ {nextStopName}</span>
      <span class="w-2 h-2 rounded-full bg-ink animate-pulse" aria-hidden="true"></span>
    </div>

    <!-- Right Hazard Chevrons Pattern -->
    <div
      class="w-16 sm:w-28 h-full opacity-35"
      style="background: repeating-linear-gradient(45deg, var(--ink), var(--ink) 6px, transparent 6px, transparent 12px);"
      aria-hidden="true"
    ></div>
  </div>
</div>

