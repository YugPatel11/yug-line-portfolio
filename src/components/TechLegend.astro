        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['Ghumify Research', 'Model Benchmarks'],
        desc: 'Ultra-long context synthesis and multi-source document ingestion testing.',
      },
      'ANTIGRAVITY': {
        name: 'Antigravity',
        category: 'AI, ML & Automation',
        line: 'ai',
