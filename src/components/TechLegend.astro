    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>

<script>
  import { sound } from '../scripts/sound';

  document.addEventListener('DOMContentLoaded', () => {
    // Dynamic Skill Data injected for client interaction
    const SKILL_DATA: Record<string, { name: string; category: string; line: string; projects: string[]; desc: string }> = {
      'GEMINI/CLAUDE': {
        name: 'Gemini / Claude',
        category: 'AI, ML & Automation',
        line: 'ai',
        projects: ['Ghumify', 'DataMorfix'],
        desc: 'Production multimodal reasoning APIs and streaming intelligence for itineraries and datasets.',
      },
      'KIMI AI': {
